WECRATFS_ENV=development
WECRATFS_ADDR=:8080
WECRATFS_PUBLIC_URL=http://localhost:8080
WECRATFS_LOCAL_MODE=true
WECRATFS_PAYMENT_MODE=local
WECRATFS_LOCAL_PAYMENT_SECRET=wecratfs-local-payment
DATABASE_URL=postgres://wecratfs:wecratfs@localhost:5432/wecratfs?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_URL=
MEILI_ADDR=localhost:7700
MEILI_API_KEY=
S3_ADDR=localhost:9000
S3_ACCESS_KEY=wecratfs
S3_SECRET_KEY=wecratfs-local-only
S3_BUCKET=wecratfs-media
S3_SECURE=false
WECRATFS_SECURE_COOKIES=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com
WECRATFS_SMTP_ADDR=localhost:1025
WECRATFS_SMTP_USERNAME=
WECRATFS_SMTP_PASSWORD=
WECRATFS_SMTP_FROM=demo@weevcrafts.local
# Optional overrides for the local Uptime Kuma administrator. Leave the password
# empty to generate a unique credential in the persistent uptime_kuma_data volume.
UPTIME_KUMA_USERNAME=weevcrafts-local
UPTIME_KUMA_PASSWORD=

# Firebase is optional. Copy public values from the registered Firebase web app.
# Keep service-account JSON outside this repository. The local Firebase overlay
# mounts a separately provisioned credential volume; see docs/firebase-integration.md.
WECRATFS_FIREBASE_PROJECT_ID=
WECRATFS_FIREBASE_API_KEY=
WECRATFS_FIREBASE_APP_ID=
WECRATFS_FIREBASE_AUTH_DOMAIN=
WECRATFS_FIREBASE_SENDER_ID=
WECRATFS_FIREBASE_MEASUREMENT_ID=
WECRATFS_FIREBASE_VAPID_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Server-only Resend credentials; never put the API key in browser config.
WECRATFS_RESEND_API_KEY=
WECRATFS_RESEND_API_KEY_FILE=
WECRATFS_RESEND_FROM=
WECRATFS_RESEND_REPLY_TO=
