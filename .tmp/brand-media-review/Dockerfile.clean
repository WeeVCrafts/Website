FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 go build -trimpath -o /out/local-setup ./cmd/reset-local
FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /out/local-setup /usr/local/bin/local-setup
ENTRYPOINT ["/usr/local/bin/local-setup"]
