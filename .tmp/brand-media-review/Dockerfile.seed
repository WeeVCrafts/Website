FROM golang:1.26-alpine AS build

WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/seed-demo ./cmd/seed-demo

FROM alpine:3.22
COPY --from=build /out/seed-demo /usr/local/bin/seed-demo
ENTRYPOINT ["/usr/local/bin/seed-demo"]
