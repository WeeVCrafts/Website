package pages

import "github.com/wecratfs/commerce/internal/web/viewmodels"

templ MakerHeading() {
  <div class="section-head"><div><p class="eyebrow">MEET THE MAKERS</p><h2>Stories behind the craft</h2><p>Explore the independent studios behind your favourite pieces.</p></div><a class="text-link" href="/makers">View all makers <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a></div>
}

templ Makers(p viewmodels.CustomerPage) {
  @Document(p) {
    <section class="container page-intro">@Breadcrumb("Home", "Makers")<h1>The people behind the pieces</h1><p>Browse independent maker collections and discover the work they share.</p></section>
    <section class="container section maker-directory"><div class="seller-grid">
      if len(p.Sellers)==0 {
<div class="empty-state"><h2>Maker collections are on their way</h2><a class="primary-button" href="/products">Explore products</a></div>
} else {
@SellerCards(p.Sellers)
}
    </div></section>
  }
}
