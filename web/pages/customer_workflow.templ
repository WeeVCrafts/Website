package pages

import "github.com/wecratfs/commerce/internal/web/viewmodels"
import "github.com/wecratfs/commerce/web/components"

templ CatalogueResults(p viewmodels.CustomerPage) {
  if len(p.Products) > 0 {
    @ProductCards(p.Products, false, true)
  } else if p.CatalogueEmpty {
    <div class="empty-state"><span class="material-symbols-outlined" aria-hidden="true">storefront</span><h2>Our collection is on its way</h2><p>New pieces will appear here when our makers publish them.</p><a class="outline-button" href="/">Explore Weevcrafts</a></div>
  } else {
    <div class="empty-state"><span class="material-symbols-outlined" aria-hidden="true">search_off</span><h2>No matching pieces</h2><p>Try a different search or remove a filter to see more.</p><a class="outline-button" href="/products">Browse all products</a></div>
  }
}

templ CustomerPasswordForm(p viewmodels.CustomerPage) {
  <section class="utility-card account-panel"><h2>Change your password</h2><p>Use at least 12 characters. After changing it, sign in again on your devices.</p>
    <form class="utility-form" action="/account/password" method="post" data-customer-password>
      <input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
      <label for="current-password">Current password</label><input id="current-password" type="password" name="current_password" autocomplete="current-password" required maxlength="1024"/>
      <label for="new-password">New password</label><input id="new-password" type="password" name="new_password" autocomplete="new-password" required minlength="12" maxlength="1024" aria-describedby="password-help"/>
      <small id="password-help">Choose a different password from the one you use now.</small>
      <label for="confirm-password">Confirm new password</label><input id="confirm-password" type="password" name="confirm_password" autocomplete="new-password" required minlength="12" maxlength="1024"/>
      <p data-password-message role="status"></p>
      <button class="primary-button" type="submit">Change password</button>
    </form>
  </section>
}

templ OrderShipmentProgress(order viewmodels.Order) {
  <section class="order-shipment-progress" aria-label="Delivery progress">
    <h2>Delivery progress</h2>
    if len(order.Shipments) == 0 {
      <p>Tracking details will appear here when your maker prepares the shipment.</p>
    }
    for _, shipment := range order.Shipments {
      <article class="shipment-card"><h3>{ shipment.SellerName }</h3><p><span class={ "ui-status " + components.StatusTone(shipment.Status) }>{ components.StatusLabel(shipment.Status) }</span></p>
        <ol class="shipment-timeline" aria-label={ shipment.SellerName + " shipment steps" }>
          for _, step := range shipmentSteps(shipment.Status) {
            <li class={ step.Class }><span class="material-symbols-outlined" aria-hidden="true">{ step.Icon }</span><span>{ step.Label }</span><small>{ step.State }</small></li>
          }
        </ol>
        if shipment.TrackingNumber != "" {
          <dl><div><dt>Courier</dt><dd>{ shipment.Carrier }</dd></div><div><dt>Tracking number</dt><dd>{ shipment.TrackingNumber }</dd></div></dl>
        }
        <p class="muted">Updated { shipment.UpdatedAt.Format("2 Jan 2006, 15:04 MST") }. These updates are recorded by your maker.</p>
      </article>
    }
  </section>
}

templ OrderStatusRegion(order viewmodels.Order) {
  <div data-order-status-region data-order-number={ order.Number }>
    <div class="order-detail-status"><span class={ "ui-status " + components.StatusTone(order.Status) }>{ components.StatusLabel(order.Status) }</span><h2>{ orderStatusTitle(order) }</h2><p>{ orderStatusCopy(order) }</p></div>
    @OrderShipmentProgress(order)
  </div>
}

templ OrderPaymentRecovery(p viewmodels.CustomerPage) {
  if p.SelectedOrder.State == "pending_payment" && p.PaymentReady {
    <section class="utility-card"><h2>Complete your payment</h2><p>Your order is saved. Continue payment for this order without creating another one.</p>
      <div id="checkout-payment-config" data-payment-mode={ p.PaymentMode } data-payment-public-key={ p.PaymentPublicKey } hidden></div>
      <button class="primary-button" type="button" data-retry-payment={ p.SelectedOrder.Number }>Continue payment</button><p data-backend-message role="status"></p>
    </section>
  }
}
