package pages

import (
	"fmt"
	"github.com/wecratfs/commerce/internal/web/viewmodels"
	"github.com/wecratfs/commerce/web/components"
)

templ DiscoveryCategory(href, image, name string) {
	<a class="discovery-category" href={ href }><img src={ "/assets/images/customer/" + image } srcset={ components.ResponsiveImageSrcSet("/assets/images/customer/"+image, "") } sizes="110px" alt="" width="110" height="88" loading="lazy"/><span>{ name }</span></a>
}

templ HomeCategoryRail(p viewmodels.CustomerPage) {
 <nav class="container discovery-categories" aria-label="Shop by craft">
  for _, category := range components.NavigationCategories(p) {
   <a class="discovery-category" href={ "/products?category=" + category.Slug }>
    if category.ImageURL != "" {
     <img src={ category.ImageURL } srcset={ components.ResponsiveImageSrcSet(category.ImageURL, "") } sizes="(max-width:800px) 64px, 130px" alt="" width="110" height="110" loading="lazy"/>
    } else {
     <span class="category-no-image" aria-hidden="true"><span class="material-symbols-outlined">category</span></span>
    }
    <span>{ category.Name }</span>
   </a>
  }
 </nav>
}

templ CollectionTile(href, image, title, copy string) {
	<a class="reference-collection" href={ href }><img src={ "/assets/images/customer/" + image } srcset={ components.ResponsiveImageSrcSet("/assets/images/customer/"+image, "") } sizes="(max-width:720px) 240px, 260px" alt="" width="320" height="160" loading="lazy"/><span><strong>{ title }</strong><small>{ copy }</small></span><span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a>
}

templ HomeMakers(p viewmodels.CustomerPage) {
	<div class="home-maker-grid" data-backend-makers>
		if len(p.Sellers) == 0 {
			<div class="empty-state"><p>Meet independent makers as their stores join the collection.</p><a class="text-link" href="/makers">Explore makers</a></div>
		}
		for i, seller := range p.Sellers {
			if i < 3 {
				<article class={ "home-maker", templ.KV("home-maker--no-portrait", seller.PortraitURL == "") }>
					if seller.PortraitURL != "" {
						<img src={ seller.PortraitURL } alt={ "Portrait shared by " + seller.Name } width="180" height="160" loading="lazy"/>
					}
					<div>
						<h3><a href={ "/makers/" + seller.Slug }>{ seller.Name }</a></h3>
						if seller.Location != "" {
							<p class="maker-location"><span class="material-symbols-outlined" aria-hidden="true">location_on</span>{ seller.Location }</p>
						}
						if seller.Technique != "" {
							<p class="maker-technique">{ seller.Technique }</p>
						}
						if seller.Description != "" {
							<p class="maker-story">{ seller.Description }</p>
						}
						<div class="maker-card-actions">
							<a class="primary-button" href={ "/makers/" + seller.Slug }>Explore store</a>
							if p.CanFollowSeller {
								<form method="post" action={ "/ui/seller-follow/" + seller.Slug } data-seller-follow>
									<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
									if seller.Following {
										<button class="outline-button" type="submit" name="intent" value="unfollow">Following</button>
									} else {
										<button class="outline-button" type="submit" name="intent" value="follow">Follow</button>
									}
								</form>
							} else {
								<a class="outline-button" href={ "/makers/" + seller.Slug + "#maker-follow" }>Follow</a>
							}
						</div>
					</div>
				</article>
			}
		}
	</div>
}

templ ListingBanner(p viewmodels.CustomerPage) {
	<section class="listing-banner">
		<img class="listing-banner-art" src="/assets/images/customer/living-banner.webp" srcset={ components.ResponsiveImageSrcSet("/assets/images/customer/living-banner.webp", "") } sizes="100vw" alt="" width="1983" height="793" fetchpriority="high"/>
		<div class="container listing-banner-copy">@Breadcrumb("Home", listingTitle(p))
<h1>{ listingTitle(p) }</h1><p>{ listingDescription(p) }</p><div class="listing-promises"><span><span class="material-symbols-outlined" aria-hidden="true">handyman</span>Authentic handmade<br/>pieces</span><span><span class="material-symbols-outlined" aria-hidden="true">verified_user</span>From independent<br/>Indian makers</span><span><span class="material-symbols-outlined" aria-hidden="true">home</span>Thoughtful designs<br/>{ "for everyday living" }</span></div></div>
	</section>
}

templ ListingCollections() {
	<nav class="listing-collections" aria-label="Discover more collections">
		<div class="listing-gift-copy"><span class="material-symbols-outlined" aria-hidden="true">redeem</span><div><h2>Gift-worthy picks for every home</h2><p>Thoughtful, handmade and full of meaning.</p></div></div>
		@CollectionTile("/products?q=gift", "wooden-box.webp", "Thoughtful Gifts", "")
		@CollectionTile("/products?q=brass", "brass-elephant.webp", "Festive Decor", "")
		@CollectionTile("/products?q=ceramic", "ceramic-mugs.webp", "Tableware", "")
		@CollectionTile("/products?category=arts", "madhubani-tree.webp", "Wall Art", "")
	</nav>
}

templ QuickViewDialog() {
	<dialog id="product-quick-view" class="quick-view-dialog" aria-labelledby="quick-view-title"><div class="quick-view-header"><h2 id="quick-view-title">Quick view</h2><button class="icon-button" type="button" data-quick-close aria-label="Close quick view"><span class="material-symbols-outlined" aria-hidden="true">close</span></button></div><div id="product-quick-view-content" aria-live="polite"></div></dialog>
}

templ QuickView(p viewmodels.CustomerPage) {
	<div class="quick-view-product" data-quick-product>
		<div class="quick-view-media"><img src={ components.ProductImage(p.Product.ImageURL) } srcset={ components.ResponsiveImageSrcSet(p.Product.ImageURL, p.Product.ImageSrcSet) } sizes="(max-width:720px) 85vw, 420px" alt={ p.Product.Name } width="640" height="640"/></div>
		<div class="quick-view-copy">
			<h3>{ p.Product.Name }</h3>
			<p>By <a class="text-link" href={ sellerPath(p.Product) }>{ p.Product.Seller }</a></p>@ProductRating(p.Product)
			<div class="detail-price"><strong data-quick-price>{ p.Product.Price }</strong></div>
			<p class="tax-note">Inclusive of all taxes</p>
			if showVariantChoice(p.Product) {
				<label for="quick-view-variant">Choose an option</label>
				<select id="quick-view-variant" name="variant_id" data-quick-variant required>
					<option value="" selected disabled>Select an option</option>
					for _, variant := range p.Product.Variants {
						<option value={ variant.ID } data-price={ variant.Price } data-in-stock={ fmt.Sprint(variant.InStock) } data-stock-message={ variant.StockMessage }>{ components.CustomerOption(variant.Name) } · { variant.Price }</option>
					}
				</select>
			} else if len(p.Product.Variants) == 1 {
				<input id="quick-view-variant" name="variant_id" type="hidden" data-quick-variant value={ p.Product.Variants[0].ID }/>
			}
			<p class="stock" data-quick-stock>{ productStockMessage(p.Product) }</p>
			<p class="quick-view-feedback" data-quick-feedback role="status"></p>
			<button class="primary-button full" type="button" data-quick-add data-variant-id={ quickViewVariantID(p.Product) } hx-post={ "/ui/cart/" + p.Product.Slug } hx-include="#quick-view-variant" hx-headers={ "{\"X-CSRF-Token\":\"" + p.CSRFToken + "\"}" } hx-target="#cart-count" hx-swap="none" hx-disabled-elt="this" disabled?={ !components.ProductCardCanAdd(p.Product) }><span class="material-symbols-outlined" aria-hidden="true">shopping_bag</span>Add to cart</button>
			<a class="text-link quick-view-detail" href={ "/products/" + p.Product.Slug }>View full product details <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a>
		</div>
	</div>
}
