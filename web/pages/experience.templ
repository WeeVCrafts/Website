package pages

import "github.com/wecratfs/commerce/web/components"

templ HomeHero() {
  <section class="hero-carousel container" data-hero aria-roledescription="carousel" aria-label="Explore Indian craft">
    <div class="hero-slides">
      @HeroSlide("Indian craft, for everyday living.", "Discover handmade pieces from independent Indian makers.", "/assets/images/customer/hero-studio.webp", "Indian artisan working in a craft studio", "/products", "Shop our collections", true)
      @HeroSlide("Woven for everyday moments.", "Explore textiles from independent Indian makers.", "/assets/images/customer/saree-maroon.webp", "Detail of a maroon handwoven saree", "/products?category=textiles", "Explore textiles", false)
      @HeroSlide("Objects with a little more meaning.", "Find handmade pieces for the spaces you love.", "/assets/images/customer/wooden-box.webp", "Carved wooden keepsake box", "/products?category=home", "Explore home & living", false)
    </div>
    <div class="hero-controls" data-hero-controls hidden>
      <div class="hero-slide-selectors" role="group" aria-label="Choose a collection">
        <button type="button" data-hero-select="0" aria-label="Show Indian craft collection" aria-pressed="true"></button>
        <button type="button" data-hero-select="1" aria-label="Show textiles collection" aria-pressed="false"></button>
        <button type="button" data-hero-select="2" aria-label="Show home and living collection" aria-pressed="false"></button>
      </div>
      <button type="button" data-hero-prev aria-label="Previous collection"><span class="material-symbols-outlined" aria-hidden="true">chevron_left</span></button>
      <output data-hero-count aria-label="Current collection">1 / 3</output>
      <button type="button" data-hero-next aria-label="Next collection"><span class="material-symbols-outlined" aria-hidden="true">chevron_right</span></button>
    </div>
    <p class="sr-only" data-hero-status role="status" aria-live="polite"></p>
  </section>
}

templ HeroSlide(title, copy, image, alt, href, action string, first bool) {
  <section class="hero hero-slide" data-hero-slide hidden?={ !first }>
    <div class="hero-copy"><h1>{ title }</h1><p>{ copy }</p><a class="primary-button" href={ href }>{ action } <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a></div>
    <div class="hero-image">
      if first {
        <img src={ image } srcset={ components.ResponsiveImageSrcSet(image, "") } sizes="(max-width:720px) calc(100vw - 32px), 620px" alt={ alt } width="1536" height="1024" fetchpriority="high"/>
      } else {
        <img data-src={ image } alt={ alt } width="1254" height="1254" loading="lazy"/>
      }
    </div>
  </section>
}
