package pages

import "github.com/wecratfs/commerce/web/components"

templ HomeHero() {
  <section class="hero-carousel reference-hero" data-hero aria-roledescription="carousel" aria-label="Explore Indian craft">
    <div class="hero-slides">
      @HeroSlide("Crafted in India. Made to be cherished.", "Discover handmade pieces from independent Indian makers — timeless crafts, richer homes and stronger communities.", "/assets/images/customer/craft-banner.webp", "Indian artisan working in a craft studio", "/products", "Shop collections", true)
      @HeroSlide("Woven for everyday moments.", "Explore textiles from independent Indian makers.", "/assets/images/customer/textiles-banner.webp", "Handwoven textiles beside a wooden loom", "/products?category=textiles", "Explore textiles", false)
      @HeroSlide("Objects with a little more meaning.", "Find handmade pieces for the spaces you love.", "/assets/images/customer/living-banner.webp", "Handcrafted objects in a sunlit Indian home", "/products?category=home", "Explore home & living", false)
      @HeroSlide("Gifts with a handmade heart.", "Find thoughtful pieces to mark the moments that matter.", "/assets/images/customer/gifts-banner.webp", "Wrapped gifts, ceramics and a wooden keepsake box", "/products?q=gifts", "Discover gifts", false)
      @HeroSlide("Traditions that shine.", "Discover brass and metalwork made for meaningful spaces.", "/assets/images/customer/metalwork-banner.webp", "Brass lamps and metalwork in a sunlit interior", "/products?q=brass", "Explore metalwork", false)
    </div>
    <div class="hero-controls" data-hero-controls hidden>
      <div class="hero-slide-selectors" role="group" aria-label="Choose a collection">
        <button type="button" data-hero-select="0" aria-label="Show Indian craft collection" aria-pressed="true"></button>
        <button type="button" data-hero-select="1" aria-label="Show textiles collection" aria-pressed="false"></button>
        <button type="button" data-hero-select="2" aria-label="Show home and living collection" aria-pressed="false"></button>
        <button type="button" data-hero-select="3" aria-label="Show gifts collection" aria-pressed="false"></button>
        <button type="button" data-hero-select="4" aria-label="Show metalwork collection" aria-pressed="false"></button>
      </div>
      <button type="button" data-hero-autoplay aria-label="Pause slideshow">Pause</button>
      <button type="button" data-hero-prev aria-label="Previous collection"><span class="material-symbols-outlined" aria-hidden="true">chevron_left</span></button>
      <output data-hero-count aria-label="Current collection" aria-live="off">1 / 5</output>
      <button type="button" data-hero-next aria-label="Next collection"><span class="material-symbols-outlined" aria-hidden="true">chevron_right</span></button>
    </div>
    <p class="sr-only" data-hero-status role="status" aria-live="polite"></p>
  </section>
    }


templ HeroSlide(title, copy, image, alt, href, action string, first bool) {
  <section class="hero hero-slide" data-hero-slide hidden?={ !first }>
    <div class="hero-copy"><p class="hero-kicker">HANDMADE · AUTHENTIC · MEANINGFUL</p><h1>
      if first {
        Crafted in India.<br/>Made to be cherished.
      } else {
        { title }
      }
    </h1><p>{ copy }</p><div class="hero-actions"><a class="primary-button" href={ href }>{ action } <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a><a class="outline-button" href="/makers">Meet the makers</a></div></div>
    if first {
    <p class="hero-note">Real people.<br/>Real crafts.<br/>A more mindful tomorrow.</p>
    }

    <div class="hero-image">
      if first {
    <img src={ image } srcset={ components.ResponsiveImageSrcSet(image, "") } sizes="100vw" alt={ alt } width="1536" height="1024" loading="eager" fetchpriority="high"/>
      } else {
        <img data-src={ image } data-srcset={ components.ResponsiveImageSrcSet(image, "") } sizes="100vw" alt={ alt } width="1254" height="1254" loading="lazy" decoding="async"/>
    }

    </div>
  </section>
    }
