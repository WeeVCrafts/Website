package pages

import (
 "fmt"
 "github.com/wecratfs/commerce/internal/web/viewmodels"
)

templ checkoutBoundary() { <span hidden>checkout</span> }

templ OrderConfirmation(p viewmodels.CustomerPage) {
 @Document(p) {
  <section class="container order-confirmation" data-payment-confirmation data-order-number={ p.SelectedOrder.Number } aria-labelledby="confirmation-title">
   @OrderConfirmationContent(p)
  </section>
 }
}

templ OrderConfirmationContent(p viewmodels.CustomerPage) {
 <div data-confirmation-content data-payment-pending={ fmt.Sprint(canCheckPayment(p)) }>
  <div class={ "confirmation-panel", templ.KV("confirmation-panel--paid",p.SelectedOrder.Confirmed()) }>
   if p.SelectedOrder.Confirmed() {
    <span class="material-symbols-outlined confirmation-state-icon" aria-hidden="true">check_circle</span>
    <h1 id="confirmation-title">Order confirmed</h1>
    <p class="confirmation-lead">Payment captured. Your maker can now prepare your order.</p>
   } else {
    <span class="material-symbols-outlined confirmation-state-icon" aria-hidden="true">info</span>
    <h1 id="confirmation-title">{ orderStatusTitle(p.SelectedOrder) }</h1>
    <p class="confirmation-lead">{ orderStatusCopy(p.SelectedOrder) }</p>
   }
   if p.Notice!="" && !p.SelectedOrder.Confirmed() && !p.SelectedOrder.PaymentReview && !p.SelectedOrder.PaymentCreationReview {
    <p class="utility-notice" role="status">{ p.Notice }</p>
   }
   <dl class="confirmation-facts">
    <div><dt>Order reference</dt><dd>{ p.SelectedOrder.Number }</dd></div>
    <div><dt>Order total</dt><dd class="checkout-amount">{ checkoutMoney(p.SelectedOrder.Total) }</dd></div>
    <div><dt>Payment status</dt><dd>{ confirmationPayment(p.SelectedOrder) }</dd></div>
   </dl>
   if canCheckPayment(p) {
    <div class="order-live-controls"><button class={ templ.KV("primary-button",!canContinuePayment(p)), templ.KV("outline-button",canContinuePayment(p)) } type="button" data-check-payment-status>Check payment status</button><p data-payment-refresh-feedback role="status">Showing your saved payment status.</p></div>
    @OrderPaymentRecovery(p)
   }
   if p.NoPaymentDemo {
    <p class="muted">Demo checkout. No money has been charged.</p>
   } else if razorpayTestMode(p) || p.PaymentMode=="local" {
    <p class="muted">Test payment. No real money is charged.</p>
   }
   <div class="confirmation-actions">
    <a class={ templ.KV("outline-button",!p.SelectedOrder.Confirmed()), templ.KV("primary-button",p.SelectedOrder.Confirmed()) } href={ orderPath(p.SelectedOrder.Number) }>View order</a>
    if p.SelectedOrder.HasPaymentReceipt() {
     <a class="outline-button" hx-boost="false" href={ orderPath(p.SelectedOrder.Number)+"/invoice?format=pdf" }>Download receipt</a>
    }
    if p.SelectedOrder.PaymentExpired || p.SelectedOrder.State=="cancelled" || p.SelectedOrder.State=="refunded" {
     <a class="outline-button" href="/products">Continue shopping</a>
    }
   </div>
  </div>
  if p.SelectedOrder.Confirmed() {
   <ol class="confirmation-progress" aria-label="Order progress">
    <li class="done"><span class="material-symbols-outlined" aria-hidden="true">check</span><strong>Order confirmed</strong><small>Payment captured</small></li>
    <li class={ confirmationStep(confirmationProcessing(p.SelectedOrder)) }><span class="material-symbols-outlined" aria-hidden="true">inventory_2</span><strong>Processing</strong><small>{ confirmationStageLabel(confirmationProcessing(p.SelectedOrder), "Started", "Not started") }</small></li>
    <li class={ confirmationStep(confirmationDelivered(p.SelectedOrder)) }><span class="material-symbols-outlined" aria-hidden="true">local_shipping</span><strong>Delivered</strong><small>{ confirmationStageLabel(confirmationDelivered(p.SelectedOrder), "Delivered", "Awaiting delivery") }</small></li>
   </ol>
  }
  <p class="confirmation-help">Need a hand? <a href={ customerSupportURL(p.SelectedOrder.Number) }>Contact support</a></p>
 </div>
}

func confirmationStep(done bool) string {
 return confirmationStageLabel(done,"done","")
}

func confirmationStageLabel(done bool, yes, no string) string {
 if done {return yes}
 return no
}

func confirmationPayment(order viewmodels.Order) string {
 switch {
 case order.PaymentReview: return "Payment received — under review"
 case order.State=="refunded" || order.RefundStatus=="processed": return "Payment refunded"
 case order.Confirmed(): return "Payment completed"
 case order.State=="cancelled": return "Order cancelled"
 case order.PaymentCreationReview: return "Payment setup under review"
 case order.PaymentCreationPending: return "Checking payment setup"
 case order.PaymentExpired: return "Payment window expired"
 case order.PaymentInProgress: return "Awaiting payment confirmation"
 case order.PaymentState=="failed" || order.State=="payment_failed": return "Payment failed"
 default: return "Payment pending"
 }
}
