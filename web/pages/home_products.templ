package pages

import (
 "github.com/wecratfs/commerce/internal/web/viewmodels"
 "github.com/wecratfs/commerce/web/components"
)

templ HomeSectionHeader(id,title,copy,href string,action ...string) {
 <div class="section-head"><div><h2 id={ id }>{ title }</h2><p>{ copy }</p></div>if href!="" {
 <a class="text-link" href={ href }>{ storefrontActionLabel(action) } <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a>
 }</div>
}

templ HomeSectionEmpty(copy string) {
 <div class="home-section-empty"><p>{ copy }</p><a class="text-link" href="/products">Browse the collection <span aria-hidden="true">→</span></a></div>
}

templ HomeProductSections(p viewmodels.CustomerPage) {
 <section class="container section home-arrivals" data-product-rail aria-labelledby="home-arrivals-title">
  @HomeSectionHeader("home-arrivals-title","New arrivals","Fresh additions to discover and make your own.","/products?sort=newest&availability=in-stock")
  if len(p.HomeNewArrivals)==0 {
   @HomeSectionEmpty("New arrivals will appear when available pieces are published.")
  } else {
   <div class="home-rail-actions" role="group" aria-label="Scroll new arrivals"><button class="outline-button" type="button" data-rail-direction="-1" aria-label="Previous new arrivals" aria-controls="home-arrivals-track"><span class="material-symbols-outlined" aria-hidden="true">arrow_back</span></button><button class="outline-button" type="button" data-rail-direction="1" aria-label="Next new arrivals" aria-controls="home-arrivals-track"><span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></button></div>
   <div id="home-arrivals-track" class="home-arrivals-track" data-rail-track tabindex="0" role="region" aria-label="New arrivals products" data-backend-products="new-arrivals">@ProductCards(p.HomeNewArrivals,false)</div>
  }
 </section>
 <section id="home-by-category" class="container section home-by-category" aria-labelledby="home-category-title">
  @HomeSectionHeader("home-category-title","Shop by category","Find your next piece, one craft at a time.","/products?category="+p.HomeSelectedCategory+"&availability=in-stock")
  <nav class="home-category-selectors" aria-label="Choose a product category">
   for _,category:=range components.NavigationCategories(p) {
    <a class={ templ.KV("is-selected",category.Slug==p.HomeSelectedCategory) } href={ "/?home_category="+category.Slug+"#home-by-category" } aria-current={ categoryCurrent(category.Slug==p.HomeSelectedCategory) }>{ category.Name }</a>
   }
  </nav>
  if len(p.HomeCategoryProducts)==0 {
   @HomeSectionEmpty("Available products in this category will appear here.")
  } else {
   <div class="home-category-editorial" data-backend-products="category">@ProductCards(p.HomeCategoryProducts,false)</div>
  }
 </section>
 <section class="home-gifts-band" aria-labelledby="home-gifts-title"><div class="container section">
  @HomeSectionHeader("home-gifts-title","Gifts under ₹1,500","Thoughtful pieces for the people you cherish.","/products?category=gifts&price=under-1500&availability=in-stock")
  if len(p.HomeGifts)==0 {
   @HomeSectionEmpty("Available gifts under ₹1,500 will appear here as the collection grows.")
  } else {
   <div class="home-gift-grid" data-backend-products="gifts">@ProductCards(p.HomeGifts,false)</div>
  }
 </div></section>
}
