package pages

import (
	"github.com/wecratfs/commerce/internal/web/viewmodels"
	"github.com/wecratfs/commerce/web/components"
)

templ Notifications(p viewmodels.CustomerPage, workspace string) {
	@Document(p) {
		<section class={ "container notification-inbox", templ.KV("seller-notification-view", p.SellerNotifications) } aria-labelledby="notifications-heading">
			<a class="notification-back" href={ workspace }>
				<span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
				Back to your workspace
			</a>
			<header class="notification-heading">
				<div>
					<h1 id="notifications-heading">Notifications</h1>
					<p>Track order updates, refunds and replies in one place.</p>
				</div>
				<form action="/notifications/read" method="post">
					<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
					<input type="hidden" name="all" value="true"/>
					<input type="hidden" name="filter" value={ p.NotificationFilter }/>
					<button class="outline-button notification-mark-all" type="submit" disabled?={ p.NotificationUnread == 0 }>
						<span class="material-symbols-outlined" aria-hidden="true">done</span>
						Mark all as read
					</button>
				</form>
			</header>
			<nav class="notification-filters" aria-label="Notification filters">
				<a href="/notifications" aria-current={ notificationCurrent(p.NotificationFilter, "all") }>All updates</a>
				<a href="/notifications?filter=unread" aria-current={ notificationCurrent(p.NotificationFilter, "unread") }>
					Unread
					if p.NotificationUnread > 0 {
						<span class="notification-filter-count">{ components.NotificationCount(p.NotificationUnread) }</span>
					}
				</a>
				if p.SellerNotifications {
					<a href="/notifications?filter=orders" aria-current={ notificationCurrent(p.NotificationFilter, "orders") }>Orders</a>
					<a href="/notifications?filter=support" aria-current={ notificationCurrent(p.NotificationFilter, "support") }>Support</a>
				}
			</nav>
			@components.NotificationList(p.Notifications, p.CSRFToken, p.NotificationFilter, p.Now)
			if p.NotificationsNextURL != "" || p.IsCustomer {
				<div class="notification-footer">
					if p.NotificationsNextURL != "" {
						<a class="outline-button" href={ p.NotificationsNextURL }>Older updates</a>
					}
					if p.IsCustomer {
						<a class="text-button" href="/account/notifications">Email &amp; notification preferences</a>
					}
				</div>
			}
		</section>
	}
}

func notificationCurrent(current, filter string) string {
	if current == filter {
		return "page"
	}
	return "false"
}
