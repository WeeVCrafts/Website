package pages

import (
	"fmt"
	"github.com/wecratfs/commerce/internal/domain/storefront"
	"github.com/wecratfs/commerce/internal/web/viewmodels"
	"github.com/wecratfs/commerce/web/components"
)

templ StorefrontSections(p viewmodels.CustomerPage, sections []storefront.Section) {
	for _,s:=range storefront.OrderedSections(sections) {
		if !s.Hidden {
			<div id={ "section-" + s.ID } class={ "sf-section",templ.KV("sf-hide-desktop",s.Responsive.HideDesktop),templ.KV("sf-hide-tablet",s.Responsive.HideTablet),templ.KV("sf-hide-mobile",s.Responsive.HideMobile),templ.KV("home-gifts-band",s.Style=="band") } style={ storefrontSectionStyle(s) } data-storefront-section={ s.ID }>
				if s.Type=="hero" && p.Storefront!=nil {
					@StorefrontHero(p, p.Storefront.OrderedSlides())
				} else if s.Type=="categories" {
					@HomeCategoryRail(p)
				} else if s.Type=="products" {
					<section class={ "container section sf-product-section",templ.KV("home-arrivals",s.Style=="rail") } data-product-rail={ s.Style == "rail" } aria-labelledby={ "heading-" + s.ID }>
						@HomeSectionHeader("heading-"+s.ID, s.Title, s.Text, storefrontProductURL(p, s), s.Button.Label)
						if s.Selection.Mode=="category" && s.Selection.Category=="" {
							<nav class="home-category-selectors" aria-label="Choose a product category">
								for _,c:=range components.NavigationCategories(p) {
									<a href={ storefrontCategoryURL(p, s.ID, c.Slug) } aria-current={ categoryCurrent(c.Slug == p.HomeSelectedCategory) }>{ c.Name }</a>
								}
							</nav>
						}
						if len(p.SectionProducts[s.ID])==0 {
							@HomeSectionEmpty("Available pieces will appear here as the collection grows.")
						} else if s.Style=="rail" {
							<div class="home-rail-actions" role="group" aria-label={ "Scroll " + s.Title }><button class="outline-button" type="button" data-rail-direction="-1" aria-controls={ "track-" + s.ID } aria-label={ "Previous " + s.Title }>←</button><button class="outline-button" type="button" data-rail-direction="1" aria-controls={ "track-" + s.ID } aria-label={ "Next " + s.Title }>→</button></div>
							<div id={ "track-" + s.ID } class="home-arrivals-track" data-rail-track tabindex="0" role="region" aria-label={ s.Title }>
								@ProductCards(p.SectionProducts[s.ID], false)
							</div>
						} else {
							<div class={ "product-grid home-product-grid sf-product-grid",templ.KV("home-category-editorial",s.Style=="editorial"),templ.KV("home-gift-grid",s.Style=="band") } data-backend-products={ s.ID }>
								@ProductCards(p.SectionProducts[s.ID], false)
							</div>
						}
					</section>
				} else if s.Type=="collections" {
					<section class="container section home-collections">
						@HomeSectionHeader("heading-"+s.ID, s.Title, s.Text, s.Button.URL, s.Button.Label)
						<div class="home-collection-grid sf-collection-grid">
							for _,item:=range s.Items {
								@CollectionTile(item.URL, item.Image, item.Title, item.Text)
							}
						</div>
					</section>
				} else if s.Type=="makers" && len(s.Items)==0 {
					<section class="container section home-makers">
						@HomeSectionHeader("heading-"+s.ID, s.Title, s.Text, s.Button.URL, s.Button.Label)
						@HomeMakers(p)
					</section>
				} else {
					<section class={ "container section sf-content-section",templ.KV("sf-image-text",s.Type=="image-text"),templ.KV("sf-banner",s.Type=="banner") } aria-labelledby={ "heading-" + s.ID }>
						if s.Image!="" {
							<picture>
								if s.MobileImage!="" {
									<source media="(max-width:800px)" srcset={ components.ResponsiveImageSrcSet(s.MobileImage, "") }/>
								}
								<img src={ s.Image } srcset={ components.ResponsiveImageSrcSet(s.Image, "") } sizes="(max-width:800px) 100vw, 960px" alt={ storefrontImageAlt(p, s.Image, s.Alt) } style={ storefrontResponsivePosition(p, s.Image, s.MobileImage) } loading="lazy" width="960" height="540"/>
							</picture>
						}
						<div>
							<h2 id={ "heading-" + s.ID }>{ s.Title }</h2>
							for _,paragraph:=range contentParagraphs(s.Text) {
								if paragraph!="" {
									<p>
										@StorefrontRichText(paragraph)
									</p>
								}
							}
							if s.Button.URL!="" {
								<a class="outline-button" href={ s.Button.URL }>{ s.Button.Label }</a>
							}
						</div>
						if s.Type=="faq" {
							for _,item:=range s.Items {
								<details><summary>{ item.Title }</summary><p>{ item.Text }</p></details>
							}
						} else if len(s.Items)>0 {
							<div class={ "sf-tile-grid",templ.KV("home-collection-grid",s.Type=="collections") }>
								for _,item:=range s.Items {
									<article>
										if item.Image!="" {
											<img src={ item.Image } srcset={ components.ResponsiveImageSrcSet(item.Image, "") } sizes="(max-width:800px) 50vw, 280px" alt={ storefrontImageAlt(p, item.Image, item.Alt) } style={ storefrontImagePosition(p, item.Image) } loading="lazy" width="320" height="180"/>
										}
										<h3>
											if item.URL!="" {
												<a href={ item.URL }>{ item.Title }</a>
											} else {
												{ item.Title }
											}
										</h3>
										<p>{ item.Text }</p>
									</article>
								}
							</div>
						}
					</section>
				}
			</div>
		}
	}
}

templ StorefrontHero(p viewmodels.CustomerPage, slides []storefront.Slide) {
	if len(slides)>0 {
		<section class="hero-carousel reference-hero" data-hero aria-roledescription="carousel" aria-label="Explore Indian craft">
			<div class="hero-slides">
				for i,s:=range slides {
					<section class="hero hero-slide" data-hero-slide data-storefront-slide={s.ID} hidden?={ i!=0 }>
						<div class="hero-copy">
							<p class="hero-kicker">{ s.Kicker }</p>
							<h1>
								if s.ID=="craft" && s.Title=="Crafted in India. Made to be cherished." {
									Crafted in India.
									<br/>
									Made to be cherished.
								} else {
									{ s.Title }
								}
							</h1>
							<p>{ s.Text }</p>
							<div class="hero-actions">
								if s.Button.URL!="" {
									<a class="primary-button" href={ s.Button.URL }>{ s.Button.Label } <span aria-hidden="true">→</span></a>
								}
								if s.Secondary.URL!="" {
									<a class="outline-button" href={ s.Secondary.URL }>{ s.Secondary.Label }</a>
								}
							</div>
						</div>
						if s.ID=="craft" {
							<p class="hero-note">Real people.<br/>Real crafts.<br/>A more mindful tomorrow.</p>
						}
						<div class="hero-image">
							<picture>
								if s.MobileImage!="" {
									<source media="(max-width:800px)" srcset={ components.ResponsiveImageSrcSet(s.MobileImage, "") } sizes="100vw"/>
								}
								if i==0 {
									<img src={ s.Image } srcset={ components.ResponsiveImageSrcSet(s.Image, "") } sizes="100vw" alt={ storefrontImageAlt(p, s.Image, s.Alt) } style={ storefrontResponsivePosition(p, s.Image, s.MobileImage) } width="1536" height="1024" loading="eager" fetchpriority="high"/>
								} else {
									<img data-src={ s.Image } data-srcset={ components.ResponsiveImageSrcSet(s.Image, "") } sizes="100vw" alt={ storefrontImageAlt(p, s.Image, s.Alt) } style={ storefrontResponsivePosition(p, s.Image, s.MobileImage) } width="1536" height="1024" loading="lazy" decoding="async"/>
								}
							</picture>
						</div>
					</section>
				}
			</div>
			<div class="hero-controls" data-hero-controls hidden>
				<div class="hero-slide-selectors" role="group" aria-label="Choose a collection">
					for i,s:=range slides {
						<button type="button" data-hero-select={ fmt.Sprint(i) } aria-label={ "Show " + s.Title } aria-pressed={ fmt.Sprint(i == 0) }></button>
					}
				</div><output data-hero-count aria-label="Current collection" aria-live="off">1 / { fmt.Sprint(len(slides)) }</output>
			</div>
			<p class="sr-only" data-hero-status role="status" aria-live="polite"></p>
		</section>
	}
}

templ StorefrontContentPage(p viewmodels.CustomerPage) {
	@Document(p) {
		if p.StorefrontPage!=nil {
			<section class="container page-intro"><h1>{ p.StorefrontPage.Title }</h1><p>{ p.StorefrontPage.Description }</p></section>@StorefrontSections(p, p.StorefrontPage.Sections)
			if p.Route=="/contact" {
				@ContactContent(p)
			}
		}
	}
}
