package pages

import (
  "net/url"
  "github.com/wecratfs/commerce/internal/web/viewmodels"
  "github.com/wecratfs/commerce/web/components"
)

templ LoginGalleryHeader(p ...viewmodels.CustomerPage) {
  <header class="gallery-header">
    <div class="container gallery-header-inner">
      <a class="gallery-wordmark" href="/" aria-label="WeevCrafts home"><img src={ galleryStorefrontLogo(p) } alt="" width="64" height="64"/><span>WeevCrafts</span></a>
      <a class="gallery-browse" href="/"><span>Continue browsing</span><span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a>
    </div>
  </header>
}

templ LoginGallery(p viewmodels.CustomerPage) {
  <section class="login-gallery" aria-labelledby="login-title">
    <img class="gallery-artwork" src={ storefrontTemplateImage(p,"/assets/images/customer/woven-gallery-auth.webp") } srcset={ components.ResponsiveImageSrcSet(storefrontTemplateImage(p,"/assets/images/customer/woven-gallery-auth.webp"), "") } sizes="(max-width:800px) 100vw, 58vw" width="1086" height="1448" alt="" decoding="async" fetchpriority="high"/>
    <div class="container gallery-layout">
      <div class="gallery-form" data-auth-surface>
        if p.Notice != "" {
          <div class="utility-notice" role="status">{ p.Notice }</div>
        }
        <h1 id="login-title">{ storefrontNativeHeading(p,"Sign in") }</h1>
        <p class="gallery-lead">{ storefrontNativeDescription(p,"Your saved pieces and orders, in one place.") }</p>
        if authNext(p.Filters) != "" {
          <p class="auth-context">You will return to your chosen page after signing in.</p>
        }
        @LoginFields(p.CSRFToken, authNext(p.Filters), "login")
        @FirebaseGoogle("login", authNext(p.Filters))
        <nav class="gallery-account-links" aria-label="Account access"><span>New to WeevCrafts?</span><a href={ authRouteURL("/register", p.Filters) }>Create account</a></nav>
      </div>
    </div>
  </section>
}

templ LoginGalleryFooter() {
  <footer class="gallery-footer container"><nav aria-label="Account help and policies"><a href="/contact">Help</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a></nav></footer>
}

templ LoginFields(csrf, next, prefix string) {
  <form class="utility-form gallery-credentials" action="/login" method="post" data-backend-auth="login" novalidate>
    <input type="hidden" name="csrf_token" value={ csrf }/>
    <input type="hidden" name="next" value={ next }/>
    <div class="auth-field"><label for={ prefix+"-email" }>Username or email</label><input id={ prefix+"-email" } name="email" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" required/></div>
    @AuthPasswordField(prefix+"-password", "password", "Password", "current-password", 0, "")
    <div class="gallery-recovery"><a href={ authRouteURL("/forgot-password", url.Values{"next": {next}}) } data-auth-route="/forgot-password">Forgot password?</a></div>
    <p class="auth-feedback" data-backend-form-message role="alert" tabindex="-1" hidden></p>
    <button class="primary-button full" type="submit">Sign in</button>
  </form>
}

templ FirebaseGoogle(prefix, next string) {
  <div class="firebase-google-panel" data-firebase-google-panel data-auth-next={ next }>
    <div class="auth-method-divider" data-google-divider><span>or</span></div>
    <button class="outline-button full google-button" type="button" data-google-signin disabled aria-disabled="true" aria-describedby={ prefix+"-google-note" }>@GoogleMark()<span>Continue with Google</span></button>
    <label class="check-line google-terms-label" hidden><input type="checkbox" data-google-terms/><span>I agree to the <a href="/privacy">privacy notice</a> and <a href="/terms">terms</a>.</span></label>
    <p id={ prefix+"-google-note" } class="auth-provider-note" data-firebase-config-note role="status" aria-live="polite">Checking Google sign-in availability…</p>
    <p class="form-message" data-firebase-status role="status" aria-live="polite" hidden></p>
  </div>
  <form class="utility-form firebase-link-panel" data-firebase-link hidden>
    <h2>Connect your existing account</h2><p>Confirm your current WeevCrafts password to keep your orders and saved items. Future sign-in and password recovery will use Firebase.</p>
    @AuthPasswordField(prefix+"-link-password", "link_password", "Current WeevCrafts password", "current-password", 0, "")
    <button class="primary-button full" type="submit">Connect account securely</button>
    <p class="form-message" data-firebase-status role="status" aria-live="polite" hidden></p>
  </form>
}

templ GoogleMark() {
  <svg class="google-mark" aria-hidden="true" viewBox="0 0 48 48" width="20" height="20"><path fill="#4285F4" d="M43.61 24.46c0-1.36-.12-2.66-.35-3.92H24v7.42h11c-.48 2.4-1.86 4.44-3.92 5.8v4.82h6.36c3.72-3.43 6.17-8.5 6.17-14.12Z"/><path fill="#34A853" d="M24 44c5.4 0 9.94-1.79 13.25-4.86l-6.36-4.82c-1.77 1.19-4.04 1.9-6.89 1.9-5.21 0-9.63-3.52-11.21-8.26H6.22v4.97A20 20 0 0 0 24 44Z"/><path fill="#FBBC05" d="M12.79 27.96A12 12 0 0 1 12.16 24c0-1.38.23-2.71.63-3.96v-4.97H6.22A20 20 0 0 0 4 24c0 3.23.78 6.28 2.22 8.93Z"/><path fill="#EA4335" d="M24 11.78c2.97 0 5.63 1.02 7.73 3.03l5.8-5.8C34 5.77 29.4 4 24 4A20 20 0 0 0 6.22 15.07l6.57 4.97c1.58-4.74 6-8.26 11.21-8.26Z"/></svg>
}

templ GuestLoginDialog(p viewmodels.CustomerPage) {
  <dialog id="guest-login-dialog" class="auth-dialog" data-auth-dialog aria-labelledby="guest-login-title" aria-describedby="guest-login-copy">
    <div class="auth-dialog-content" data-auth-surface>
      <button class="auth-dialog-close" type="button" data-auth-close aria-label="Close sign-in prompt"><span class="material-symbols-outlined" aria-hidden="true">close</span></button>
      <div class="auth-dialog-heading"><img src="/assets/images/customer/woven-gallery-auth.webp" alt="" width="1086" height="1448" loading="lazy" decoding="async"/><h2 id="guest-login-title">Sign in to continue</h2></div>
      <p id="guest-login-copy" class="gallery-lead">Save your favourite pieces and keep your orders together.</p>
      @LoginFields(p.CSRFToken, "", "guest-login")
      @FirebaseGoogle("guest-login", "")
      <nav class="gallery-account-links" aria-label="Account access"><a href="/register" data-auth-route="/register">Create account</a><button class="auth-keep-browsing" type="button" data-auth-close>Keep browsing</button></nav>
    </div>
  </dialog>
}
