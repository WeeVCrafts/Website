package admin

import (
	"fmt"
	"github.com/wecratfs/commerce/internal/domain/storefront"
	"github.com/wecratfs/commerce/internal/web/viewmodels"
	"strings"
)

templ EditorMoney(label, name string, cents int64) {
	<label>{ label }<input type="number" name={ name } value={ editorINR(cents) } min="0" max="1000000" step="0.01" required/></label>
}

templ EditorFields(m viewmodels.StorefrontEditor) {
	@ManagementToken(m.Admin.CSRFToken)
	<input type="hidden" name="draft" value={ fmt.Sprint(m.Draft.ID) }/>
	<input type="hidden" name="version" value={ fmt.Sprint(m.Draft.Version) }/>
	<input type="hidden" name="tab" value={ m.Tab }/>
	<input type="hidden" name="section" value={ m.Selected }/>
}

templ EditorInput(label, name, value string) {
	<label>{ label }<input name={ name } value={ value } maxlength="2048"/></label>
}

templ EditorNumber(label, name string, value, min, max int) {
	<label>{ label }<input type="number" name={ name } value={ fmt.Sprint(value) } min={ fmt.Sprint(min) } max={ fmt.Sprint(max) } step="1" required/></label>
}

templ EditorCheck(label, name string, value bool) {
	<label class="sf-check"><input type="checkbox" name={ name } value="true" checked?={ value }/>{ label }</label>
}

templ EditorChoice(name, value, label, current string) {
	<option value={ value } selected?={ value==current }>{ label }</option>
}

templ EditorLink(prefix string, l storefront.Link) {
	@EditorInput("Button label", prefix+"label", l.Label)
	@EditorInput("Button destination", prefix+"url", l.URL)
}

templ EditorMedia(image, mobile, alt string) {
	@EditorInput("Photograph URL", "image", image)
	@EditorInput("Mobile photograph URL (optional)", "mobile_image", mobile)
	@EditorInput("Image description", "alt", alt)
	<small>Describe what the photograph shows. A separate mobile photograph is optional.</small>
}

templ EditorSave(m viewmodels.StorefrontEditor) {
	<button class="admin-button primary" type="submit" data-editor-form-save disabled?={ m.Draft.State!="draft" }>Save draft</button>
}

templ Storefront(m viewmodels.StorefrontEditor) {
	@AdminDocument(m.Admin) {
		<link rel="stylesheet" href="/assets/css/storefront-editor.min.css"/>
		<script defer src="/assets/js/storefront-editor.min.js"></script>
		<div class="sf-workspace" data-editor-root data-editor-endpoint={ m.Admin.PortalRoot+"/storefront" } data-editor-draft={ fmt.Sprint(m.Draft.ID) } data-editor-tab={ m.Tab } data-editor-selection={ m.Selected } data-editor-state={ m.Draft.State }>
			@templ.JSONScript("sf-destinations",m.Destinations)
			@templ.JSONScript("sf-structured-content",editorStructuredContent(m))
			<header class="sf-heading">
				<div><h2 class="sr-only">Storefront design</h2><p>Choose a page, edit its content, and review your changes before publishing.</p></div>
				<form method="post" action={ m.Admin.PortalRoot + "/storefront/new" }>
					@EditorFields(m)
					<button class="admin-button secondary" type="submit">New draft from published design</button>
				</form>
			</header>
			if m.Error!="" {
				<div class="sf-message sf-error ui-error-summary" role="alert">
					<h2>Changes were not saved</h2>
					<p>{ m.Error }</p>
					<p>Your proposed values remain in this form. Copy them before reloading.</p><a href={ editorURL(m, m.Tab, m.Selected) }>Compare with the latest saved version</a>
					@StorefrontComparison(m)
				</div>
			}
			if m.Draft.ID>0 {
				<div class="sf-draft-state"><div><strong data-editor-save-state>{ editorDraftState(m.Draft.State) }</strong><small>Draft { fmt.Sprint(m.Draft.ID) } · Saved { m.Draft.Updated.Format("02 Jan, 15:04") } · Version { fmt.Sprint(m.Draft.Version) }</small><span>Customers see published release { fmt.Sprint(m.Published.ID) } until you publish.</span></div><a href={ m.PreviewURL } target="_blank" rel="noopener">Open saved preview <span class="sr-only">in a new tab</span></a><button type="button" class="admin-button primary" data-editor-save hidden disabled?={m.Draft.State!="draft"}>Save draft</button><a class="admin-button secondary" href={editorURL(m,"publishing","")}>Review changes</a></div>
				if m.Draft.State!="published" && m.Draft.BaseRelease!=m.Published.ID {
<p class="sf-message">The published storefront changed after this draft began. You can keep editing, but publishing cannot replace the newer release. Start a new draft from the published design and apply the changes you want to keep.</p>
}
				if m.Draft.Note!="" {
					<p class="sf-message">Review note: { m.Draft.Note }</p>
				}
				if m.Draft.State!="draft" {
					<p class="sf-message">This version is locked. Super Admin can request changes, or create a new draft from a published release.</p>
				}
			}
			@StorefrontWorkspaceNavigation(m)
			if m.Draft.ID>0 {
 @StorefrontGuide(m)
}
			if m.Tab=="overview" {
				@StorefrontOverview(m)
			} else if m.Tab=="publishing" {
				@StorefrontReadiness(m)
				@StorefrontPublishing(m)
			} else if m.Draft.ID==0 {
				<p>Create a draft to begin editing.</p>
			} else {
				<div class="sf-mobile-tabs" role="tablist" aria-label="Editor view" hidden>
					if editorHasOutline(m) {
<button type="button" role="tab" id="sf-sections-tab" aria-controls="sf-outline-panel" aria-selected="false" tabindex="-1" data-editor-pane="sections">Sections</button>
}
					<button type="button" role="tab" id="sf-edit-tab" aria-controls="sf-settings-panel" aria-selected="true" data-editor-pane="edit">Edit</button>
					<button type="button" role="tab" id="sf-preview-tab" aria-controls="sf-preview-panel" aria-selected="false" tabindex="-1" data-editor-pane="preview">Preview</button>
				</div>
				<div class={"sf-editor-layout",templ.KV("sf-has-outline",editorHasOutline(m))}>
					if editorHasOutline(m) {
<aside id="sf-outline-panel" class="sf-outline" aria-label="Page sections">@StorefrontOutline(m)</aside>
}
					<section id="sf-settings-panel" class="admin-panel sf-settings" aria-label="Draft settings">
						if m.Tab=="homepage" || m.Tab=="template-sections" || m.Tab=="page-sections" {
							@StorefrontSections(m)
						}
						if m.Tab=="hero" {
							@StorefrontHero(m)
						}
						if m.Tab=="categories" {
							@StorefrontCategories(m)
						}
						if m.Tab=="navigation" {
							<h2>Customer navigation</h2>
							<p>Published categories appear automatically. Add clearly labelled destinations and arrange the footer groups below.</p>
							<form method="post" action={ m.Admin.PortalRoot + "/storefront/save" }>
								@EditorFields(m)
								<fieldset disabled?={ m.Draft.State!="draft" }>
									<label>Header links<textarea name="navigation" rows="5">{ editorLinks(m.Draft.Config.Navigation) }</textarea></label><label>Trust content (Heading | Text | Image URL | Destination | Image description)<textarea name="trust" rows="7">{ editorItems(m.Draft.Config.Trust) }</textarea></label><label>Policy links<textarea name="policy_links" rows="4">{ editorLinks(m.Draft.Config.PolicyLinks) }</textarea></label><label>Footer links<textarea name="footer" rows="10">{ editorFooter(m.Draft.Config.FooterGroups) }</textarea></label>@EditorSave(m)
								</fieldset>
							</form>
						}
						if m.Tab=="theme" {
							<h2>Theme</h2>
							<p>Supported fonts and validated colors keep the storefront consistent.</p>
							<form method="post" action={ m.Admin.PortalRoot + "/storefront/save" }>
								@EditorFields(m)
								<fieldset disabled?={ m.Draft.State!="draft" }>
									@EditorInput("Logo URL", "logo", m.Draft.Config.Theme.Logo)
									for _,field:=range []struct{Label,Name,Value string}{{"Primary color","primary",m.Draft.Config.Theme.Primary},{"Accent color","accent",m.Draft.Config.Theme.Accent},{"Background color","background",m.Draft.Config.Theme.Background}} {
										<label>{ field.Label }<input type="color" name={ field.Name } value={ field.Value } required/></label>
									}
									<label>
										Body font
										<select name="body_font">
											@EditorChoice("body_font", "DM Sans", "DM Sans", m.Draft.Config.Theme.BodyFont)
											@EditorChoice("body_font", "Inter", "Inter", m.Draft.Config.Theme.BodyFont)
										</select>
									</label>
									<label>
										Heading font
										<select name="heading_font">
											for _,font:=range []string{"Playfair Display","DM Sans","Inter"} {
												@EditorChoice("heading_font", font, font, m.Draft.Config.Theme.HeadingFont)
											}
										</select>
									</label>@EditorSave(m)
								</fieldset>
							</form>
						}
						if m.Tab=="media" {
							@StorefrontMediaLibrary(m)
						}
						if m.Tab=="templates" || m.Tab=="pages" {
							@StorefrontPages(m)
						}
						if m.Tab=="promotions" {
							@StorefrontPromotions(m)
						}
						if m.Tab=="settings" {
							@StorefrontSettings(m)
						}
					</section>
					<aside id="sf-preview-panel" class="sf-preview" aria-label="Responsive preview"><div class="sf-preview-toolbar"><strong data-editor-preview-state>Saved draft preview</strong><div role="group" aria-label="Preview size"><button type="button" data-preview-width="390" aria-pressed="true">Mobile</button><button type="button" data-preview-width="768" aria-pressed="false">Tablet</button><button type="button" data-preview-width="1440" aria-pressed="false">Desktop</button></div></div><div class="sf-preview-mode" role="group" aria-label="Preview interaction"><button type="button" data-preview-mode="edit" aria-pressed="true">Edit preview</button><button type="button" data-preview-mode="browse" aria-pressed="false">Browse preview</button></div><p data-editor-preview-status role="status" aria-live="polite">Select a section in the preview to edit it. Shopping actions stay disabled.</p><div class="sf-preview-scroll" role="region" tabindex="0" aria-label="Storefront preview viewport"><iframe title="Private storefront preview" src={ m.PreviewURL } sandbox="allow-scripts allow-same-origin" data-storefront-preview loading="lazy"></iframe></div></aside>
				</div>
			}
		</div>
	}
}

templ StorefrontOutline(m viewmodels.StorefrontEditor) {
	<h2>Page sections</h2>
	<p>Select a section to edit. Drag to reorder, or use Move up and Move down.</p>
	@StorefrontPresetGallery(m)
	<ol class="sf-section-list" data-section-list>
		for _,s:=range storefront.OrderedSections(editorSections(m)) {
			<li data-section-id={ s.ID } draggable?={ m.Draft.State=="draft" }>
				<a href={ editorURL(m, m.Tab, editorSectionID(m, s.ID)) } data-editor-target={ "section:"+s.ID } aria-current={ariaCurrent(m.Selected==editorSectionID(m,s.ID))}>
					<span class="sf-kind-icon material-symbols-outlined" aria-hidden="true">{editorKindIcon(s.Type)}</span><b>{editorSectionName(s)}</b>
					<small>
						{ editorKindName(s.Type) }
						if s.Hidden {
							· Hidden
						}
					</small>
				</a>
				<form method="post" action={ m.Admin.PortalRoot + "/storefront/save" }>
					@EditorFields(m)
					<input type="hidden" name="section" value={ editorSectionID(m, s.ID) }/><button name="operation" value="up" type="submit" aria-label={ "Move up " + s.ID } disabled?={ m.Draft.State!="draft" }>↑</button><button name="operation" value="down" type="submit" aria-label={ "Move down " + s.ID } disabled?={ m.Draft.State!="draft" }>↓</button><button name="operation" value="duplicate" type="submit" disabled?={ m.Draft.State!="draft" }>Duplicate</button>
					<button name="operation" value="hide" type="submit" disabled?={ m.Draft.State!="draft" }>
						if s.Hidden {
							{ "Show " }
						} else {
							{ "Hide " }
						}
					</button>
				</form>
			</li>
		}
	</ol>
	<form method="post" action={ m.Admin.PortalRoot + "/storefront/save" } class="sf-add">
		@EditorFields(m)
		<input type="hidden" name="operation" value="add"/>
		<label>
			Section type
			<select name="type">
				for _,kind:=range append([]string{"curated","gifts","story","promotion","questions"}, storefront.SectionTypes...) {
					<option value={ kind }>{ editorPresetName(kind) }</option>
				}
			</select>
		</label><button type="submit" class="admin-button secondary" disabled?={ m.Draft.State!="draft" }>Add section</button>
	</form>
}

templ StorefrontSections(m viewmodels.StorefrontEditor) {
	if m.Section.ID=="" {
<div class="sf-editor-empty"><span class="material-symbols-outlined" aria-hidden="true">edit</span><h2>Choose a section to begin</h2><p>Select a section from the outline or click it in the preview. You can change content, photographs, and layout here.</p></div>
}

	if m.Section.ID!="" {
		<h2 tabindex="-1" data-editor-heading>{editorSectionName(m.Section)}</h2><p>{editorKindHint(m.Section.Type)}</p>
		if m.Section.Type=="products" {
			@StorefrontProductSearch(m)
		}
		<form method="post" action={ m.Admin.PortalRoot + "/storefront/save" }>
			@EditorFields(m)
			<fieldset disabled?={ m.Draft.State!="draft" }>
				@EditorInput("Section heading", "title", m.Section.Title)
				<small>Use blank lines for paragraphs, **bold**, *emphasis* or [a link](/destination).</small><label>Supporting text<textarea name="text" rows="4">{ m.Section.Text }</textarea></label>@EditorNumber("Display order", "order", m.Section.Order, 0, 1000000)
				@EditorCheck("Hide this section", "hidden", m.Section.Hidden)
				if m.Section.Type=="hero" {
					<p><a href={ editorURL(m, "hero", "") }>Edit hero photographs and slides</a></p>
				}
				if m.Section.Type=="categories" {
					<p><a href={ editorURL(m, "categories", "") }>Edit categories and numbering</a></p>
				}
				@EditorMedia(m.Section.Image, m.Section.MobileImage, m.Section.Alt)
				@EditorLink("button_", m.Section.Button)
				if m.Section.Type=="products" {
					<label>
						Presentation
						<select name="style">
							for _,style:=range []string{"grid","rail","editorial","band"} {
								@EditorChoice("style", style, style, m.Section.Style)
							}
						</select>
					</label>
					<label>
						Product selection
						<select name="mode">
							for _,mode:=range []string{"featured","newest","category","selected"} {
								@EditorChoice("mode", mode, mode, m.Section.Selection.Mode)
							}
						</select>
					</label>
					<label>
						Category
						<select name="category">
							<option value="">Customer chooses a category</option>
							for _,c:=range m.Draft.Config.OrderedCategories() {
								@EditorChoice("category", c.Slug, c.Name, m.Section.Selection.Category)
							}
						</select>
					</label>
					@StorefrontProductChoices(m)
					@EditorNumber("Product limit", "limit", m.Section.Selection.Limit, 1, 24)
					@EditorMoney("Minimum price (₹ INR)", "min_price", m.Section.Selection.MinPrice)
					@EditorMoney("Maximum price (₹ INR; 0 means no limit)", "max_price", m.Section.Selection.MaxPrice)
					@EditorCheck("Available products only", "available", m.Section.Selection.Available)
				}
				if m.Section.Type=="collections" || m.Section.Type=="faq" || m.Section.Type=="trust" || m.Section.Type=="makers" {
					<label>Items<textarea name="items" rows="8">{ editorItems(m.Section.Items) }</textarea></label><small>One item per line: Heading | Text | Image URL | Destination | Image description</small>
				}
				<details>
					<summary>Responsive layout</summary>
					<div class="sf-number-grid">
						@EditorNumber("Desktop columns", "desktop_columns", m.Section.Responsive.DesktopColumns, 0, 6)
						@EditorNumber("Tablet columns", "tablet_columns", m.Section.Responsive.TabletColumns, 0, 4)
						@EditorNumber("Mobile columns", "mobile_columns", m.Section.Responsive.MobileColumns, 0, 2)
						@EditorNumber("Section spacing (px)", "spacing", m.Section.Responsive.Spacing, 0, 120)
						@EditorNumber("Mobile spacing (px)", "mobile_spacing", m.Section.Responsive.MobileSpacing, 0, 80)
					</div>@EditorCheck("Hide on desktop", "hide_desktop", m.Section.Responsive.HideDesktop)
					@EditorCheck("Hide on tablet", "hide_tablet", m.Section.Responsive.HideTablet)
					@EditorCheck("Hide on mobile", "hide_mobile", m.Section.Responsive.HideMobile)
				</details>
				@EditorSave(m)
				<button type="submit" name="operation" value="remove" class="admin-button secondary" data-confirm="Remove this content from the draft? Customers will see the change only after publication.">Remove section from draft</button>
			</fieldset>
		</form>
	}
}

templ StorefrontHero(m viewmodels.StorefrontEditor) {
	<h2>Hero slides</h2>
	<p>Slides autoplay every four seconds and support swipe. Numbering controls their order.</p>
	<ul class="sf-items">
		for _,s:=range m.Draft.Config.Slides {
			<li><a href={ editorURL(m, "hero", s.ID) } data-editor-target={"slide:"+s.ID}>{ fmt.Sprint(s.Order) } · { s.Title }</a></li>
		}
	</ul>
	<form method="post" action={ m.Admin.PortalRoot + "/storefront/save" }>
		@EditorFields(m)
		<button name="operation" value="add" type="submit" class="admin-button secondary" disabled?={ m.Draft.State!="draft" }>Add slide</button>
	</form>
	if m.Slide.ID!="" {
		<form method="post" action={ m.Admin.PortalRoot + "/storefront/save" }>
			@EditorFields(m)
			<fieldset disabled?={ m.Draft.State!="draft" }>
				@EditorInput("Heading", "title", m.Slide.Title)
				@EditorInput("Eyebrow", "kicker", m.Slide.Kicker)
				<label>Supporting text<textarea name="text" rows="4">{ m.Slide.Text }</textarea></label>@EditorNumber("Display order", "order", m.Slide.Order, 0, 1000000)
				@EditorCheck("Hide slide", "hidden", m.Slide.Hidden)
				@EditorMedia(m.Slide.Image, m.Slide.MobileImage, m.Slide.Alt)
				@EditorLink("button_", m.Slide.Button)
				<h3>Secondary button</h3>@EditorLink("secondary_", m.Slide.Secondary)
				@EditorSave(m)
				<button type="submit" name="operation" value="remove" class="admin-button secondary" data-confirm="Remove this content from the draft? Customers will see the change only after publication.">Remove slide from draft</button>
			</fieldset>
		</form>
	}
}

templ StorefrontCategories(m viewmodels.StorefrontEditor) {
	<h2>Categories</h2>
	<p>Names, photographs and order are published together across the customer storefront. Product assignment stays in Catalog.</p>
	<ul class="sf-items">
		for _,c:=range m.Draft.Config.OrderedCategories() {
			<li>
				<a href={ editorURL(m, "categories", c.Slug) } data-editor-target={"category:"+c.Slug}>
					{ fmt.Sprint(c.Order) } · { c.Name }
					if !c.Visible {
						(hidden)
					}
				</a>
			</li>
		}
	</ul>
	<details>
		<summary>Add category</summary>
		<form method="post" action={ m.Admin.PortalRoot + "/storefront/save" }>
			@EditorFields(m)
			<fieldset disabled?={ m.Draft.State!="draft" }>
				<input type="hidden" name="operation" value="add"/>@EditorInput("Name", "name", "")
				@EditorInput("Permanent URL slug", "slug", "")
				<button class="admin-button secondary" type="submit">Add category to draft</button>
			</fieldset>
		</form>
	</details>
	if m.Category.Slug!="" {
		<form method="post" action={ m.Admin.PortalRoot + "/storefront/save" }>
			@EditorFields(m)
			<fieldset disabled?={ m.Draft.State!="draft" }>
				@EditorInput("Category name", "name", m.Category.Name)
				@EditorInput("Photograph URL", "image", m.Category.Image)
				<label>Description<textarea name="text" rows="4">{ m.Category.Description }</textarea></label>@EditorNumber("Display order", "order", m.Category.Order, 0, 1000000)
				@EditorCheck("Show in customer discovery", "visible", m.Category.Visible)
				@EditorSave(m)
				<button name="operation" value="remove" type="submit" class="admin-button secondary">Remove category from draft</button><small>Publishing rejects removal while products or commission rules still reference this category. Hide it to preserve those assignments.</small>
			</fieldset>
		</form>
	}
}

templ StorefrontMediaLibrary(m viewmodels.StorefrontEditor) {
	<h2>Media library</h2>
	<p>Photographs are retained for draft previews and release restoration. Uploading does not publish them.</p>
	<form method="post" enctype="multipart/form-data" action={ m.Admin.PortalRoot + "/storefront/upload" }>
		@EditorFields(m)
		<label>Photograph<input type="file" name="image_file" accept="image/jpeg,image/png,image/webp" required/></label>@EditorInput("Image description", "alt", "")
		<div class="sf-number-grid">
			@EditorNumber("Focal position X (%)", "focal_x", 50, 0, 100)
			@EditorNumber("Focal position Y (%)", "focal_y", 50, 0, 100)
		</div><button type="submit" class="admin-button primary">Upload photograph</button><small>JPEG, PNG or WebP · up to 8 MiB / 16 megapixels. Responsive variants are generated automatically.</small>
	</form>
	<form method="get" action={ m.Admin.PortalRoot + "/storefront" }><input type="hidden" name="draft" value={ fmt.Sprint(m.Draft.ID) }/><input type="hidden" name="tab" value="media"/><label>Find photographs<input name="media_q" value={ m.MediaQuery }/></label><button type="submit" class="admin-button secondary">Find photographs</button></form>
	<nav aria-label="Media library pages">
		if m.PreviousMedia!="" {
			<a href={ m.PreviousMedia }>Previous photographs</a>
		}
		if m.NextMedia!="" {
			<a href={ m.NextMedia }>Next photographs</a>
		}
	</nav>
	<div class="sf-media-grid">
		for _,asset:=range m.Media {
			<article><img src={ asset.URL + "?w=480" } alt={ asset.Alt } loading="lazy" width="240" height="160"/><p>{ asset.Alt }</p><label>Permanent image URL<input value={ asset.URL } readonly data-copy-media/></label><small>{ asset.Created }</small></article>
		}
	</div>
}

templ StorefrontPages(m viewmodels.StorefrontEditor) {
	<h2>
		if m.Tab=="templates" {
			Customer page templates
		} else {
			Content pages
		}
	</h2>
	if m.Tab=="templates" {
		<p>Functional components remain connected to the catalog, cart, checkout and account services. Add presentation content around them.</p>
		<ul class="sf-items">
			for _,t:=range m.Draft.Config.Templates {
				<li>
					<a href={ editorURL(m, "templates", t.ID) }>
						{ t.Kind + " · " }
						if t.Match=="" {
							Default
						} else {
							{ t.Match }
						}
					</a>
				</li>
			}
		</ul>
		<details>
			<summary>Add template override</summary>
			<form method="post" action={ m.Admin.PortalRoot + "/storefront/save" }>
				@EditorFields(m)
				<input type="hidden" name="operation" value="add"/>
				<label>
					Page type
					<select name="kind">
						for _,kind:=range storefront.TemplateKinds {
							<option value={ kind }>{ kind }</option>
						}
					</select>
				</label>@EditorInput("Assignment (category:slug or product:slug)", "match", "")
				<button type="submit" class="admin-button secondary">Add template</button>
			</form>
		</details>
		if m.Template.ID!="" {
			<p><a href={ editorURL(m, "template-sections", m.Template.ID+":") }>Manage template sections and responsive layout</a></p>
			<form method="post" action={ m.Admin.PortalRoot + "/storefront/save" }>
				@EditorFields(m)
				<fieldset disabled?={ m.Draft.State!="draft" }>
					@EditorInput("Page heading / SEO title", "title", m.Template.Title)
					@EditorInput("SEO description", "description", m.Template.Description)
					@EditorInput("Banner photograph URL", "image", m.Template.Image)
					@EditorInput("Assignment (empty for default)", "match", m.Template.Match)
					@EditorCheck("Replace the default page introduction with configured sections", "hide_default_intro", m.Template.HideDefaultIntro)
					<label>Introductory banner text<textarea name="text" rows="6">{ editorTemplateText(m.Template) }</textarea></label>@EditorSave(m)
					if m.Template.Match!="" {
						<button type="submit" name="operation" value="remove" class="admin-button secondary" data-confirm="Remove this content from the draft? Customers will see the change only after publication.">Remove template override</button>
					}
				</fieldset>
			</form>
		}
		<details><summary>Editor coverage</summary><ul><li>Category and search: introductory banners, section content and template assignments; filters, stock and prices use the catalog.</li><li>Products, makers and brands: introduction and surrounding content; product facts remain in Catalog.</li><li>Wishlist, cart and checkout: presentation content; totals, addresses, payment and stock remain functional.</li><li>Account, orders and authentication: introduction; identity, history, support and privacy controls remain available.</li></ul></details>
	} else {
		<p>Use the existing page slug for About, Contact, Shipping, FAQ, Returns, Terms or Privacy. Other pages appear at /pages/your-slug.</p>
		<ul class="sf-items">
			for _,p:=range m.Draft.Config.Pages {
				<li><a href={ editorURL(m, "pages", p.Slug) }>{ p.Title } · { p.Slug }</a></li>
			}
		</ul>
		<details>
			<summary>Add content page</summary>
			<form method="post" action={ m.Admin.PortalRoot + "/storefront/save" }>
				@EditorFields(m)
				<input type="hidden" name="operation" value="add"/>@EditorInput("Page title", "title", "")
				@EditorInput("URL slug", "slug", "")
				<button class="admin-button secondary" type="submit">Add page</button>
			</form>
		</details>
		if m.Page.Slug!="" {
			<p><a href={ editorURL(m, "page-sections", m.Page.Slug+":") }>Manage page sections and responsive layout</a></p>
			<form method="post" action={ m.Admin.PortalRoot + "/storefront/save" }>
				@EditorFields(m)
				<fieldset disabled?={ m.Draft.State!="draft" }>
					@EditorInput("Page title", "title", m.Page.Title)
					@EditorInput("SEO description", "description", m.Page.Description)
					@EditorInput("Sharing image URL", "image", m.Page.SharingImage)
					<label>Page content<textarea name="text" rows="16">{ editorPageText(m.Page) }</textarea></label>@EditorCheck("Hide page", "hidden", m.Page.Hidden)
					@EditorSave(m)
				</fieldset>
			</form>
		}
	}
}

templ StorefrontSettings(m viewmodels.StorefrontEditor) {
	<h2>Store settings</h2>
	<p>Amounts are in INR. Changes apply to new shopping activity after publication.</p>
	<form method="post" action={ m.Admin.PortalRoot + "/storefront/save" }>
		@EditorFields(m)
		<fieldset disabled?={ m.Draft.State!="draft" }>
			@EditorInput("Support email", "support_email", m.Draft.Config.Settings.SupportEmail)
			<label>Shipping information<textarea name="shipping_information" rows="4">{ m.Draft.Config.Settings.ShippingInformation }</textarea></label><label>Social links (Label | HTTPS destination)<textarea name="social" rows="5">{ editorLinks(m.Draft.Config.Settings.Social) }</textarea></label>
			<div class="sf-number-grid">
				@EditorMoney("Shipping fee (₹ INR)", "shipping_cents", m.Draft.Config.Settings.Policy.ShippingCents)
				@EditorMoney("Free shipping threshold (₹ INR)", "free_shipping_cents", m.Draft.Config.Settings.Policy.FreeShippingCents)
				@EditorNumber("Return request window (days; 0 preserves current eligibility)", "return_days", m.Draft.Config.Settings.Policy.ReturnDays, 0, 365)
			</div>
			@EditorCheck("Restrict delivery to the PIN codes below", "pin_restricted", m.Draft.Config.Settings.Policy.PINRestricted)
			<label>Serviceable Indian PIN codes<textarea name="pin_codes" rows="5">{ strings.Join(m.Draft.Config.Settings.Policy.PINCodes,"\n") }</textarea></label>
			<h3>Shopping features</h3>@EditorCheck("Wishlist", "wishlist", m.Draft.Config.Settings.Features.Wishlist)
			@EditorCheck("Quick view", "quick_view", m.Draft.Config.Settings.Features.QuickView)
			@EditorCheck("Reviews", "reviews", m.Draft.Config.Settings.Features.Reviews)
			@EditorCheck("Coupon entry", "coupons", m.Draft.Config.Settings.Features.Coupons)
			<h3>Payment options</h3>
			@EditorCheck("Limit available payment options", "restrict_payments", m.Draft.Config.Settings.Policy.RestrictPayments)
			<p>Only options already configured by the application are available. Turn off the limit to use configured defaults; turning on the limit with no choices disables new payments.</p>
			for _,mode:=range m.PaymentOptions {
				<label class="sf-check"><input type="checkbox" name="payments" value={ mode } checked?={ contains(m.Draft.Config.Settings.Policy.Payments,mode) }/>{ mode }</label>
			}
			@EditorSave(m)
		</fieldset>
	</form>
	<details open>
		<summary>Read-only shipping simulation</summary>
		<form method="get" action={ m.Admin.PortalRoot + "/storefront" }>
			<input type="hidden" name="draft" value={ fmt.Sprint(m.Draft.ID) }/><input type="hidden" name="tab" value="settings"/>@EditorMoney("Example subtotal (₹ INR)", "subtotal", 149900)
			@EditorInput("Example PIN code", "pin", "500001")
			@EditorInput("Example coupon code (optional)", "coupon", "")
			<button type="submit" class="admin-button secondary">Calculate example</button>
		</form>
		if m.Simulation!="" {
			<output role="status">{ m.Simulation }</output>
		}
	</details>
}

templ StorefrontPublishing(m viewmodels.StorefrontEditor) {
	<section class="admin-panel">
		<h2>Publishing</h2>
		@StorefrontComparison(m)
		<p>Saved drafts never change customer pages. Submitted drafts are locked until Super Admin publishes or requests changes.</p>
		if m.Draft.ID>0 && m.Draft.State!="published" {
			<form method="post" action={ m.Admin.PortalRoot + "/storefront/submit" }>
				@EditorFields(m)
				<button class="admin-button primary" type="submit" disabled?={ m.Draft.State!="draft" }>Submit for review</button>
			</form>
			if m.Admin.CanSecurity {
				<form method="post" action={ m.Admin.PortalRoot + "/storefront/publish" }>
					@EditorFields(m)
					<label>Publication / review note<textarea name="note" minlength="4" maxlength="2000" required rows="3"></textarea></label><button class="admin-button primary" type="submit">Publish reviewed changes</button>
					if m.Draft.State=="submitted" {
						<button class="admin-button secondary" type="submit" formaction={ m.Admin.PortalRoot + "/storefront/request-changes" }>Request changes</button>
					}
				</form>
			}
		}
		<h3>Draft history</h3>
		<div class="ui-table-region" role="region" tabindex="0" aria-label="Storefront drafts">
			<table class="ui-table">
				<thead><tr><th scope="col">Draft</th><th scope="col">State</th><th scope="col">Updated</th><th scope="col">Review note</th></tr></thead>
				<tbody>
					for _,d:=range m.Drafts {
						<tr><th scope="row"><a href={ m.Admin.PortalRoot + "/storefront?draft=" + fmt.Sprint(d.ID) + "&tab=publishing" }>Draft { fmt.Sprint(d.ID) } · v{ fmt.Sprint(d.Version) }</a></th><td>{ d.State }</td><td>{ d.Updated.Format("02 Jan 2006 15:04") }</td><td>{ d.Note }</td></tr>
					}
				</tbody>
			</table>
		</div>
		<h3>Release history</h3>
		<nav aria-label="Publishing history pages">
			if m.HistoryPage>1 {
				<a href={ editorURL(m, "publishing", "") + "&history_page=" + fmt.Sprint(m.HistoryPage-1) }>Newer drafts and releases</a>
			}
			if len(m.Releases)==30 || len(m.Drafts)==30 {
				<a href={ editorURL(m, "publishing", "") + "&history_page=" + fmt.Sprint(m.HistoryPage+1) }>Older drafts and releases</a>
			}
		</nav>
		<p>Restoring creates a new editable draft. Orders, stock, payments and coupon usage stay intact.</p>
		<ol class="sf-release-list">
			for _,release:=range m.Releases {
				<li>
					<strong>Release { fmt.Sprint(release.ID) }</strong><span>{ release.Published.Format("02 Jan 2006 15:04") } · { release.Note }</span>
					<form method="post" action={ m.Admin.PortalRoot + "/storefront/new" }>
						@EditorFields(m)
						<input type="hidden" name="restore" value={ fmt.Sprint(release.ID) }/><button type="submit" class="admin-button secondary">Restore as draft</button>
					</form>
				</li>
			}
		</ol>
	</section>
}
