package admin

import "github.com/wecratfs/commerce/internal/web/viewmodels"

templ EmailDeliveryPage(p viewmodels.AdminPage, history viewmodels.EmailDeliveryHistory) {
	@AdminDocument(p) {
		<section class="admin-panel coordination">
			<a class="text-link" href={p.PortalRoot+"/support"}>Back to Support &amp; delivery</a>
			<form method="get" action={p.PortalRoot+"/support/email"} class="support-directory-toolbar" novalidate>
				<label for="email-history-order">Order number</label>
				<input id="email-history-order" name="order" maxlength="100" value={history.Order}/>
				<button class="admin-button primary" type="submit">Find emails</button>
				if history.Order!="" {
					<a class="text-link" href={p.PortalRoot+"/support/email"}>Clear</a>
				}
			</form>
		</section>
		@EmailHistory(history, true)
	}
}

templ EmailHistory(history viewmodels.EmailDeliveryHistory, showOrder bool) {
	<section class="admin-panel coordination" aria-labelledby="order-email-history-heading">
		<h2 id="order-email-history-heading">Order emails</h2>
		<p>Delivery history covers the last 30 days.</p>
		if history.Unavailable {
			<p role="status">Email history is unavailable. Try again later.</p>
		} else if len(history.Rows)==0 {
			<p>No tracked emails found.</p>
		} else {
			<div class="ui-table-region" role="region" tabindex="0" aria-label="Order email delivery records">
				<table class="ui-table ui-table--records">
					<thead><tr>
						if showOrder {
 <th scope="col">Order</th>
 }
						<th scope="col">Email</th><th scope="col">Status</th><th scope="col">Updated (UTC)</th><th scope="col">Provider message ID</th>
					</tr></thead>
					<tbody>
						for _, row := range history.Rows {
							<tr>
								if showOrder {
 <td data-label="Order">
if row.OrderNumber!="" {
{row.OrderNumber}
} else if row.WorkflowReference!="" {
<span>Seller setup</span>
} else {
<span>Account notification</span>
}
</td>
 }
								<td data-label="Email">{emailDeliveryKind(row.Kind)}</td>
								<td data-label="Status">{emailDeliveryState(row.State)}</td>
								<td data-label="Updated (UTC)">{row.StateAt.UTC().Format("02 Jan 2006, 15:04")}</td>
								<td data-label="Provider message ID">
									if row.ProviderID!="" {
 <code>{row.ProviderID}</code>
 } else {
 <span>Pending or unavailable</span>
 }
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		if history.Latest!="" || history.Next!="" {
			<nav class="coordination-filter" aria-label="Email history pages">
				if history.Latest!="" {
 <a class="admin-button" href={history.Latest}>Latest emails</a>
 }
				if history.Next!="" {
 <a class="admin-button" href={history.Next}>Older emails</a>
 }
			</nav>
		}
	</section>
}

func emailDeliveryKind(kind string) string {
	switch kind {
	case "OrderCreated": return "Customer order received"
	case "OrderPaid": return "Customer payment confirmed"
	case "SellerOrderShipped": return "Customer dispatch update"
	case "New paid order": return "Seller new order"
	default: return kind
	}
}

func emailDeliveryState(state string) string {
	switch state {
	case "submitting": return "Awaiting provider confirmation"
	case "accepted": return "Accepted by Resend"
	case "delayed": return "Delivery delayed"
	case "delivered": return "Delivered to mail server"
	case "bounced": return "Bounced"
	case "failed": return "Delivery failed"
	case "suppressed": return "Suppressed by Resend"
	case "complained": return "Reported as spam"
	case "rejected": return "Send request rejected"
	default: return "Needs investigation"
	}
}
