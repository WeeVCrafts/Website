package admin

import "github.com/wecratfs/commerce/internal/web/viewmodels"

templ GuidedSidebar(p viewmodels.AdminPage) {
 <aside id="admin-sidebar" class="admin-sidebar" :class="sidebar ? 'is-open' : ''">
  <button class="admin-sidebar-close" type="button" x-ref="adminSidebarClose" aria-label="Close admin navigation" @click="sidebar=false; $nextTick(() => $refs.adminMenu.focus())"><span class="material-symbols-outlined" aria-hidden="true">close</span></button>
  <a class="guided-brand" href={p.PortalRoot}>WeevCrafts<small>Super Admin</small></a>
  <nav aria-label="Super Admin navigation">
   @AdminNav("dashboard","Dashboard","home",p.NavActive,p.PortalRoot)
   @AdminNav("orders","Orders & delivery","local_shipping",p.NavActive,p.PortalRoot+"/orders")
   @AdminNav("fulfillment","Fulfillment","inventory_2",p.NavActive,p.PortalRoot+"/fulfillment?tab=setup")
   @AdminNav("sellers","Sellers","groups",p.NavActive,p.PortalRoot+"/sellers")
   @AdminNav("products","Products","sell",p.NavActive,p.PortalRoot+"/products")
   @AdminNav("inventory","Inventory","layers",p.NavActive,p.PortalRoot+"/inventory")
   @AdminNav("returns","Returns","undo",p.NavActive,p.PortalRoot+"/returns")
   @AdminNav("finance","Finance","payments",p.NavActive,p.PortalRoot+"/finance")
   @AdminNav("support","Support","headset_mic",p.NavActive,p.PortalRoot+"/support")
  </nav>
 </aside>
}

templ GuidedMobileHeader(p viewmodels.AdminPage) {
 <header class="guided-mobile-header">
  <button class="admin-menu-button" type="button" x-ref="adminMenu" aria-label="Open admin navigation" aria-controls="admin-sidebar" :aria-expanded="sidebar" @click="sidebar=true; $nextTick(() => $refs.adminSidebarClose.focus())"><span class="material-symbols-outlined" aria-hidden="true">menu</span></button>
  <a href={p.PortalRoot}>WeevCrafts</a><span>Super Admin</span>
 </header>
}
