package admin

// Presentation of the existing four-role contract. No permissions are granted
// here; the server remains the sole authorization owner.
templ RolePermissionMatrix() {
  <div class="ui-table-region" tabindex="0" role="region" aria-label="Role and permission matrix">
    <table class="ui-table ui-table--records"><thead><tr><th scope="col">Role</th><th scope="col">Customer data</th><th scope="col">Catalog</th><th scope="col">Orders</th><th scope="col">Finance</th><th scope="col">Security</th><th scope="col">State</th></tr></thead><tbody>
      <tr><th scope="row">Customer</th><td data-label="Customer data">Own account</td><td data-label="Catalog">Browse</td><td data-label="Orders">Own orders</td><td data-label="Finance">Own payments</td><td data-label="Security">None</td><td data-label="State"><mark class="status success">Active</mark></td></tr>
      <tr><th scope="row">Seller</th><td data-label="Customer data">Own orders</td><td data-label="Catalog">Own business</td><td data-label="Orders">Own fulfilment</td><td data-label="Finance">Own earnings</td><td data-label="Security">None</td><td data-label="State"><mark class="status success">Active</mark></td></tr>
      <tr><th scope="row">Admin</th><td data-label="Customer data">Company support</td><td data-label="Catalog">Manage</td><td data-label="Orders">Manage</td><td data-label="Finance">Manage</td><td data-label="Security">None</td><td data-label="State"><mark class="status success">Active</mark></td></tr>
      <tr><th scope="row">Super Admin</th><td data-label="Customer data">Company operations</td><td data-label="Catalog">Manage</td><td data-label="Orders">Manage</td><td data-label="Finance">Manage</td><td data-label="Security">Manage</td><td data-label="State"><mark class="status review">Audited</mark></td></tr>
    </tbody></table>
  </div>
}
