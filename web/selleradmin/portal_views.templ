package selleradmin

import "github.com/wecratfs/commerce/internal/web/viewmodels"

templ PortalDashboard(p viewmodels.SellerAdminPage) {
	@Document(p) {
		if len(p.LowStock) > 0 {
			<section class="seller-panel low-stock-alert" role="status"><div class="seller-panel-heading"><div><h2>Low stock alerts</h2><p>{ sellerInt(len(p.LowStock)) } items are below the { sellerInt(p.LowStockThreshold) } unit threshold.</p></div><a class="seller-panel-link" href="/seller-admin/inventory">Manage stock</a></div><ul>
				for _, item := range p.LowStock {
					<li><span><strong>{ item.Name }</strong> · SKU { item.SKU }</span><b>{ item.Available } available</b></li>
				}
			</ul></section>
		}
		@SellerStatGrid(p)
		<section class="seller-two-grid">
			<article class="seller-panel">
				<div class="seller-panel-heading"><div><span class="material-symbols-outlined" aria-hidden="true">category</span><span><h2>Products</h2><p>Current catalogue for { p.SellerName }</p></span></div>
					if p.CanProducts {
						<a class="seller-panel-link" href="/seller-admin/products">Open products</a>
					}
				</div>
				if len(p.Products) == 0 {
					@SellerTableEmpty("No products yet", "Products you create will appear here.")
				} else {
					<div class="seller-table-scroll"><div class="seller-product-table"><div class="seller-product-head"><span>Product</span><span>SKU</span><span>Price</span><span>Stock</span><span>Status</span></div>
						for _, product := range p.Products {
							<div class="seller-product-row"><span class="seller-product-cell"><b>{ product.Name }</b></span><span>{ product.SKU }</span><span>{ product.Price }</span><span>{ product.Stock }</span><span>{ product.Status }</span></div>
						}
					</div></div>
				}
			</article>
			<article class="seller-panel">
				<div class="seller-panel-heading"><div><span class="material-symbols-outlined" aria-hidden="true">local_shipping</span><span><h2>Recent orders</h2><p>Fulfil orders from this seller account.</p></span></div>
					if p.CanOrders {
						<a class="seller-panel-link" href="/seller-admin/orders">Open orders</a>
					}
				</div>
				if len(p.Orders) == 0 {
					@SellerTableEmpty("No orders yet", "Paid customer orders will appear here.")
				} else {
					<div class="seller-table-scroll"><div class="seller-mini-table orders-mini"><div class="seller-table-head"><span>Order</span><span>Customer</span><span>Items</span><span>Value</span><span>Status</span></div>
						for _, order := range p.Orders {
							<div class="seller-table-row"><b>{ order.Number }</b><span>{ order.Customer }</span><span>{ order.Items }</span><strong>{ order.Value }</strong><span>{ order.Status }</span></div>
						}
					</div></div>
				}
			</article>
		</section>
		<section class="seller-panel">
			<div class="seller-panel-heading"><div><span class="material-symbols-outlined" aria-hidden="true">bolt</span><span><h2>Available actions</h2><p>Actions are shown only when your seller account has the required permission.</p></span></div></div>
			<div class="seller-quick-actions">
				if p.CanProductWrite {
					<a href="/seller-admin/products/new"><span class="material-symbols-outlined" aria-hidden="true">add</span><b>Create product draft</b><small>Submit a new listing for marketplace review.</small></a>
				}
				if p.CanInventory {
					<a href="/seller-admin/inventory"><span class="material-symbols-outlined" aria-hidden="true">inventory_2</span><b>Manage stock</b><small>Review available and reserved units.</small></a>
				}
				if p.CanFulfill {
					<a href="/seller-admin/orders"><span class="material-symbols-outlined" aria-hidden="true">local_shipping</span><b>Fulfil customer orders</b><small>Record processing and shipment details.</small></a>
				}
			</div>
		</section>
	}
}

templ PortalTerms(p viewmodels.SellerAdminPage) {
	@Document(p) {
		<article class="seller-panel seller-terms-panel">
			<p>These requirements apply to sellers using the Weevcrafts marketplace. Review the</p>
			<p>Privacy information is available from the Privacy Policy link below.</p>
			<section><h2>1. Account eligibility &amp; registration</h2><ul><li>Provide accurate business information, applicable tax registration details, bank account credentials, and valid identity verification.</li><li>Keep dashboard credentials confidential. Sellers are responsible for activity carried out using their account credentials.</li></ul></section>
			<section><h2>2. Product listings &amp; compliance</h2><ul><li>Do not list counterfeit, illegal, stolen, dangerous, or third-party rights-infringing items.</li><li>Keep product titles, descriptions, categories, images, stock quantities, and specifications accurate. Misleading information is prohibited.</li><li>Only upload images, text, brand names, and logos that you own or are authorized to use.</li></ul></section>
			<section><h2>3. Order processing &amp; fulfillment</h2><ul><li>Pack and dispatch orders within the applicable processing timelines shown for your seller account or order.</li><li>Keep inventory accurate and update stock promptly to prevent orders being cancelled because an item is unavailable.</li><li>Use the applicable logistics providers and attach valid tracking details when dispatching an order.</li></ul></section>
			<section><h2>4. Commission, fees &amp; payouts</h2><ul><li>Applicable commissions, platform fees, subscription charges, and payment processing charges are disclosed through the relevant seller and settlement records.</li><li>Payout timing follows the schedule shown in your seller account and applicable settlement terms.</li><li>Funds may be held or adjusted for returns, refunds, customer disputes, or active chargebacks.</li></ul></section>
			<section><h2>5. Returns, refunds &amp; customer service</h2><ul><li>Follow the marketplace return and refund policy that applies to each order.</li><li>Respond to customer complaints, refund requests, and platform support inquiries within the applicable response window shown in the seller workflow.</li></ul></section>
			<section><h2>6. Code of conduct &amp; account termination</h2><ul><li>Do not move marketplace transactions off-platform to avoid fees, create fake customer reviews, or manipulate reviews.</li><li>Weevcrafts may suspend or terminate seller accounts for policy breaches, counterfeit sales, high order cancellation rates, or persistently low performance ratings.</li></ul></section>
		</article>
	}
}

templ PortalProducts(p viewmodels.SellerAdminPage) {
	@Document(p) {
		if p.SellerStatus != "active" {
			<div class="seller-callout" role="status"><span class="material-symbols-outlined" aria-hidden="true">info</span><p><strong>Product management is locked</strong><small>Your seller profile must be approved before you can create or change listings. <a href="/seller-admin/onboarding">View application status</a>.</small></p></div>
		}
		<form class="seller-toolbar" action="/seller-admin/products" method="get"><label class="sr-only" for="portal-product-query">Search products</label><input id="portal-product-query" name="q" value={ p.Query } placeholder="Search your products"/><button class="seller-button outline" type="submit">Search</button><a class="seller-button outline" href="/seller-admin/products">Clear</a>
			if p.CanProductWrite {
				<a class="seller-button primary" href="/seller-admin/products/new">Create product draft</a>
			}
		</form>
		<section class="seller-panel"><div class="seller-panel-heading"><div><span class="material-symbols-outlined" aria-hidden="true">category</span><span><h2>Product catalogue</h2><p>Review listings, pricing, stock and available row actions.</p></span></div></div><div class="seller-table-scroll"><div class="portal-product-table"><div class="portal-product-head"><span>Product</span><span>SKU</span><span>Category</span><span>Price</span><span>Stock</span><span>Status</span><span>Actions</span></div>
			for _, product := range p.Products {
				<div class="portal-product-row"><span class="seller-product-cell"><b title={ product.Name }>{ product.Name }</b></span><span data-label="SKU">{ product.SKU }</span><span data-label="Category">{ product.Category }</span><span data-label="Price">{ product.Price }</span><span data-label="Stock">{ product.Stock }</span><span data-label="Status"><span class={ "seller-chip " + sellerStatusClass(product.Status) }>{ product.Status }</span></span><span class="seller-row-actions">
					if p.CanProductWrite && product.Status != "archived" {
						<a class="seller-button outline" href={ "/seller-admin/products/" + product.ID + "/edit" }>Edit product</a>
						<form method="post" action="/seller-admin/products/archive" onsubmit="return confirm('Archive this product? It will be hidden from customers while past orders remain available.');"><input type="hidden" name="csrf_token" value={ p.CSRFToken }/><input type="hidden" name="product_id" value={ product.ID }/><input name="reason" minlength="4" maxlength="1000" placeholder="Reason to archive" required/><button class="seller-button danger" type="submit">Archive</button></form>
					}
					if p.CanProductWrite && product.Status == "archived" {
						<form method="post" action="/seller-admin/products/restore" onsubmit="return confirm('Restore this as a private draft? It must be resubmitted for review before customers can see it.');"><input type="hidden" name="csrf_token" value={ p.CSRFToken }/><input type="hidden" name="product_id" value={ product.ID }/><input name="reason" minlength="4" maxlength="1000" placeholder="Reason to restore" required/><button class="seller-button outline" type="submit">Restore draft</button></form>
					}
					if p.CanProductWrite && (product.Status == "draft" || product.Status == "rejected") {
						<form method="post" action="/seller-admin/products/submit"><input type="hidden" name="csrf_token" value={ p.CSRFToken }/><input type="hidden" name="product_id" value={ product.ID }/><button class="seller-button primary" type="submit">Submit for review</button></form>
					}
				</span></div>
			}
			if len(p.Products) == 0 {
				@SellerTableEmpty("No products found", "Create a product draft or change your search.")
			}
		</div></div></section>
	}
}

templ ProductForm(p viewmodels.SellerAdminPage, form viewmodels.SellerProductForm) {
	@Document(p) {
		<section class="seller-panel seller-form-panel"><form class="seller-form-grid" action={ form.Action } method="post" enctype="multipart/form-data" data-product-builder>
			<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
			<input type="hidden" name="slug" value={ form.Slug }/><input type="hidden" name="brand_name" value={ form.BrandName }/><input type="hidden" name="brand_slug" value={ form.BrandSlug }/>
			<label>Title<input name="name" value={ form.Name } required maxlength="180"/></label>
			<label>Category<select name="category_slug" required><option value="">Choose a category</option>
				for _, category := range form.Categories {
					<option value={ category.Slug } selected?={ form.CategorySlug == category.Slug }>{ category.Name }</option>
				}
			</select><input type="hidden" name="category_name" value={ form.CategoryName } data-category-name/></label>
			<label>SKU<input name="sku" value={ form.SKU } required maxlength="120"/></label>
			<label>Price (paise)<input name="price_cents" type="number" min="1" value={ form.PriceCents } required/></label>
			<label>Unit cost (paise, optional)<input name="cost_price_cents" type="number" min="0" value={ form.CostPriceCents }/></label>
			if form.ID == "" {
				if p.CanInventoryWrite {
					<label>Stock quantity<input name="initial_stock" type="number" min="0" max="100000" value={ form.InitialStock } required/></label>
				} else {
					<input type="hidden" name="initial_stock" value="0"/>
				}
			} else {
				<div class="seller-form-wide seller-form-note">Stock is managed separately in Inventory. Editing this listing will not change available units.</div>
			}
			<label class="seller-form-wide">Upload product image (PNG or JPEG)<input type="file" name="image_file" accept="image/png, image/jpeg, image/jpg, image/webp"/></label>
			<label class="seller-form-wide">Or Product Image URL<input name="image_url" value={ form.Image } placeholder="/assets/images/customer/saree-maroon.webp"/></label>
			<label class="seller-form-wide">Description<textarea name="description" required rows="5" maxlength="10000">{ form.Description }</textarea></label>
			<div class="seller-form-wide seller-form-actions"><a class="seller-button outline" href="/seller-admin/products">Cancel</a><button class="seller-button primary" type="submit">Save product draft</button></div>
		</form>
		if form.ID == "" {
			<fieldset class="seller-panel product-media-upload" data-product-media data-product-id="" data-csrf-token={ p.CSRFToken }><legend>Product images</legend><p>Drop images here or browse. We show a square preview and keep the original upload.</p><label class="product-media-dropzone" data-media-drop>Drop images here or choose files<input type="file" accept="image/jpeg,image/png,image/webp" multiple data-media-file/></label><div data-media-selection></div><p role="status" aria-live="polite" data-media-status></p></fieldset>
		}
		if form.ID != "" {
			if form.Image != "" {
				<img class="product-media-preview product-media-square" src={ form.Image } alt={ "Current image for " + form.Name }/>
			}
			<fieldset class="seller-panel product-media-upload" data-product-media data-product-id={ form.ID } data-csrf-token={ p.CSRFToken }>
				<legend>Product images</legend><p>Images update the main product photo and appear in the customer product gallery.</p>
				<label class="product-media-dropzone" data-media-drop>Drop images here or choose files<input type="file" accept="image/jpeg,image/png,image/webp" multiple data-media-file/></label><button class="seller-button outline" type="button" data-media-upload>Upload images</button><p role="status" aria-live="polite" data-media-status></p>
				<div class="product-media-assets">
					if len(form.Media) == 0 {
						<p>No uploaded media yet.</p>
					}
					for _, media := range form.Media {
						<article class="product-media-asset">
							if media.IsVideo {
								<video controls preload="metadata" aria-label={ "Product video " + media.ID }><source src={ media.URL } type={ media.ContentType }/></video>
							} else {
							<img class="product-media-square" src={ media.URL } alt={ "Uploaded product image " + media.ID } loading="lazy"/>
							}
							<p>{ media.ContentType } · { media.Size } bytes</p><button class="seller-button danger" type="button" data-media-delete data-media-id={ media.ID }>Delete media</button>
						</article>
					}
				</div>
			</fieldset>
			<section class="seller-panel product-variant-manager">
				<div class="seller-panel-heading"><div><span class="material-symbols-outlined" aria-hidden="true">style</span><span><h2>Product variants</h2><p>Prices use paise. Stock changes after creation belong in Inventory. Archive is blocked when a variant has reserved units or is the last active option.</p></span></div></div>
			for _, variant := range form.Variants {
				<div class="product-variant-row">
					<form class="seller-form-grid product-variant-edit" method="post" action="/seller-admin/products/variants/update">
						<input type="hidden" name="csrf_token" value={ p.CSRFToken }/><input type="hidden" name="product_id" value={ form.ID }/><input type="hidden" name="variant_id" value={ variant.ID }/>
						<label>Variant name<input name="name" value={ variant.Name } required maxlength="120" disabled?={ variant.Status != "active" }/></label>
						<label>SKU<input name="sku" value={ variant.SKU } required maxlength="120" disabled?={ variant.Status != "active" }/></label>
						<label>Price in paise<input name="price_cents" type="number" min="1" value={ variant.PriceCents } required disabled?={ variant.Status != "active" }/></label>
						<label>Compare-at price in paise<input name="compare_at_cents" type="number" min="1" value={ variant.CompareAtCents } disabled?={ variant.Status != "active" }/></label>
						<div class="variant-stock-summary">Available: <b>{ variant.Available }</b> · Reserved: <b>{ variant.Reserved }</b> · Status: <b>{ variant.Status }</b></div>
						if variant.Status == "active" {
							<button class="seller-button primary" type="submit">Save variant</button>
						}
					</form>
					if variant.Status == "active" {
						<form method="post" action="/seller-admin/products/variants/archive" onsubmit="return confirm('Archive this variant? Existing orders will remain intact.');">
							<input type="hidden" name="csrf_token" value={ p.CSRFToken }/><input type="hidden" name="product_id" value={ form.ID }/><input type="hidden" name="variant_id" value={ variant.ID }/>
							<label>Archive reason<input name="reason" required minlength="4" maxlength="1000" placeholder="Why this option is being removed"/></label><button class="seller-button danger" type="submit">Archive variant</button>
						</form>
					}
				</div>
			}
			<form class="seller-form-grid product-variant-create" method="post" action="/seller-admin/products/variants/create">
				<input type="hidden" name="csrf_token" value={ p.CSRFToken }/><input type="hidden" name="product_id" value={ form.ID }/>
				<h3>Add variant</h3>
				<label>Variant name<input name="name" required maxlength="120" placeholder="Color, size or option"/></label>
				<label>SKU<input name="sku" required maxlength="120"/></label>
				<label>Price in paise<input name="price_cents" type="number" min="1" required/></label>
				<label>Compare-at price in paise<input name="compare_at_cents" type="number" min="1"/></label>
				if p.CanInventoryWrite {
					<label>Initial stock<input name="initial_stock" type="number" min="0" max="100000" value="0" required/></label>
				} else {
					<p class="seller-form-wide seller-form-note">This variant starts at zero stock. An owner must grant Inventory write access before you can add stock.</p>
				}
				<button class="seller-button primary" type="submit">Add variant</button>
			</form>
			</section>
		}
		</section>
	}
}

templ PortalInventory(p viewmodels.SellerAdminPage) {
	@Document(p) {
		<form class="seller-toolbar low-stock-setting" method="post" action="/seller-admin/inventory/threshold"><input type="hidden" name="csrf_token" value={ p.CSRFToken }/><label>Alert when available stock falls below<input type="number" name="low_stock_threshold" min="1" max="100000" value={ sellerInt(p.LowStockThreshold) } required/> units</label><button class="seller-button primary" type="submit">Save threshold</button></form>
		if len(p.LowStock) > 0 {
			<section class="seller-panel low-stock-alert" role="status"><h2>Needs restocking</h2><ul>
				for _, item := range p.LowStock {
					<li><strong>{ item.Name }</strong><span>SKU { item.SKU } · { item.Available } available</span></li>
				}
			</ul></section>
		}
		<form class="seller-toolbar" action="/seller-admin/inventory" method="get"><label class="sr-only" for="portal-inventory-query">Search inventory</label><input id="portal-inventory-query" name="q" value={ p.Query } placeholder="Search product, variant or SKU"/><button class="seller-button outline" type="submit">Search</button><a class="seller-button outline" href="/seller-admin/inventory">Clear</a></form>
		<section class="seller-panel"><div class="seller-panel-heading"><div><span class="material-symbols-outlined" aria-hidden="true">inventory_2</span><span><h2>Inventory</h2><p>Adjust available stock per variant.</p></span></div></div><div class="seller-table-scroll"><div class="portal-inventory-table"><div class="portal-inventory-head"><span>Product</span><span>SKU</span><span>Variant</span><span>Available</span><span>Reserved</span><span>Stock action</span></div>
			for _, item := range p.Inventory {
				<div class="portal-inventory-row"><span class="seller-product-cell"><b title={ item.Name }>{ item.Name }</b></span><span class="inventory-sku-cell" data-label="SKU">{ item.SKU }</span><span data-label="Variant">{ item.Variant }</span><strong class="inventory-stock-num" data-label="Available">{ item.Available }</strong><span data-label="Reserved">{ item.Reserved }</span><span class="inventory-action-cell">
					if p.CanInventoryWrite {
						<form class="seller-inline-form" method="post" action="/seller-admin/inventory/adjust"><input type="hidden" name="csrf_token" value={ p.CSRFToken }/><input type="hidden" name="variant_id" value={ item.VariantID }/><label class="sr-only" for={ "stock-delta-" + item.VariantID }>Stock change for { item.Name }</label><input id={ "stock-delta-" + item.VariantID } type="number" name="delta" required placeholder="+/- qty"/><input name="reason" required minlength="3" maxlength="500" placeholder="Reason"/><button class="seller-button primary" type="submit">Save</button></form>
					} else {
						<span>Read only</span>
					}
				</span></div>
			}
			if len(p.Inventory) == 0 {
				@SellerTableEmpty("No inventory found", "Inventory records appear when a product variant is created.")
			}
		</div></div></section>
	}
}

templ PortalOrders(p viewmodels.SellerAdminPage) {
	@Document(p) {
		@SellerOrderStage(p, "new", "New")
		@SellerOrderStage(p, "processing", "Processing / Packing")
		@SellerOrderStage(p, "shipped", "Shipped")
		@SellerOrderStage(p, "delivered", "Delivered / Completed")
	}
}

templ SellerOrderStage(p viewmodels.SellerAdminPage, key, label string) {
	<section class="seller-panel order-stage"><div class="seller-panel-heading"><div><h2>{ label }</h2><p>{ sellerInt(len(sellerOrdersByStage(p.Orders, key))) } orders</p></div></div>
		if len(sellerOrdersByStage(p.Orders, key)) == 0 {
			@SellerTableEmpty("No orders in this stage", "Orders move here as you fulfil them.")
		} else {
			<div class="seller-order-cards">
				for _, order := range sellerOrdersByStage(p.Orders, key) {
					<article class="seller-order-card"><div><a href={ "/seller-admin/orders/" + order.Number }><strong>{ order.Number }</strong></a><span>{ order.Date } · { order.Customer }</span></div><div><b>{ order.Items } items</b><strong>{ order.Value }</strong></div><a class="seller-button outline" href={ "/seller-admin/orders/" + order.Number }>Open order</a></article>
				}
			</div>
		}
	</section>
}

templ PortalOrderDetail(p viewmodels.SellerAdminPage) {
	@Document(p) {
		if p.OrderDetail != nil {
			<div class="seller-order-actions"><a class="seller-button outline" href="/seller-admin/orders">Back to orders</a><button class="seller-button outline" type="button" data-print-kind="label">Print shipping label</button><button class="seller-button outline" type="button" data-print-kind="packing-slip">Print packing slip</button><button class="seller-button outline" type="button" data-print-kind="invoice">Print invoice</button></div>
			<section class="seller-two-grid"><article class="seller-panel"><h2>Order { p.OrderDetail.Number }</h2><p>{ p.OrderDetail.Date } · { p.OrderDetail.Customer } · { p.OrderDetail.Payment }</p><p>Fulfilment: <strong>{ p.OrderDetail.Status }</strong></p><h3>Delivery address</h3><address>{ p.OrderDetail.RecipientName }<br/>{ p.OrderDetail.Line1 }<br/>{ p.OrderDetail.Line2 }<br/>{ p.OrderDetail.City }, { p.OrderDetail.State } { p.OrderDetail.PostalCode }<br/>{ p.OrderDetail.CountryCode }</address><h3>Items from your store</h3><div class="seller-mini-table"><div class="seller-table-head"><span>Product</span><span>SKU</span><span>Qty</span><span>Unit price</span><span>Total</span></div>
				for _, item := range p.OrderDetail.Items {
					<div class="seller-table-row"><b>{ item.Name }</b><span>{ item.SKU }</span><span>{ item.Quantity }</span><span>{ item.UnitPrice }</span><strong>{ item.LineTotal }</strong></div>
				}
				</div><p><strong>Seller subtotal: { p.OrderDetail.Subtotal }</strong></p></article>
				@SellerOrderFulfillment(p)
			</section>
			<div class="seller-print-document" data-print-document="label"><h1>Shipping label</h1><p>WeevCrafts · { p.SellerName }</p><address>{ p.OrderDetail.RecipientName }<br/>{ p.OrderDetail.Line1 }<br/>{ p.OrderDetail.Line2 }<br/>{ p.OrderDetail.City }, { p.OrderDetail.State } { p.OrderDetail.PostalCode }<br/>{ p.OrderDetail.CountryCode }</address><p>Order: { p.OrderDetail.Number } · { p.OrderDetail.Carrier } · { p.OrderDetail.TrackingNumber }</p></div>
			<div class="seller-print-document" data-print-document="packing-slip"><h1>Packing slip · { p.OrderDetail.Number }</h1>
				for _, item := range p.OrderDetail.Items {
					<p>{ item.Quantity } × { item.Name } · SKU { item.SKU }</p>
				}
			</div>
			<div class="seller-print-document" data-print-document="invoice"><h1>Order invoice · { p.OrderDetail.Number }</h1><p>Seller: { p.SellerName } · Customer: { p.OrderDetail.RecipientName }</p>
				for _, item := range p.OrderDetail.Items {
					<p>{ item.Name } · { item.Quantity } × { item.UnitPrice } · { item.LineTotal }</p>
				}
				<strong>Seller item subtotal: { p.OrderDetail.Subtotal }</strong><p>Basic order document based on stored order data.</p></div>
		}
	}
}

templ SellerOrderFulfillment(p viewmodels.SellerAdminPage) {
	<article class="seller-panel"><h2>Fulfilment &amp; tracking</h2>
		if p.CanFulfill && p.OrderDetail.Status != "delivered" {
			<form class="seller-form-grid" method="post" action="/seller-admin/orders/fulfill"><input type="hidden" name="csrf_token" value={ p.CSRFToken }/><input type="hidden" name="seller_id" value={ p.OrderDetail.SellerID }/><input type="hidden" name="order_number" value={ p.OrderDetail.Number }/><label>Status<select name="status"><option value={ sellerNextFulfillmentStatus(p.OrderDetail.Status) }>{ sellerFulfillmentLabel(sellerNextFulfillmentStatus(p.OrderDetail.Status)) }</option></select></label><label>Carrier<select name="carrier" required>
				for _, carrier := range sellerCarriers(p.OrderDetail.Carrier) {
					<option value={ carrier } selected?={ p.OrderDetail.Carrier == carrier }>{ carrier }</option>
				}
			</select></label><label>Other carrier name<input name="custom_carrier" maxlength="80" placeholder="Used when carrier is Other"/></label><label>Tracking number<input name="tracking_number" maxlength="120" value={ p.OrderDetail.TrackingNumber } placeholder="Required when shipping"/></label><label>Note<input name="note" maxlength="500" value={ p.OrderDetail.Note } placeholder="Optional fulfilment note"/></label><button class="seller-button primary" type="submit">Save fulfilment</button></form>
		} else {
			<p>{ p.OrderDetail.Carrier } · { p.OrderDetail.TrackingNumber }</p>
		}
	</article>
}

templ PortalReturns(p viewmodels.SellerAdminPage) {
	@Document(p) {
		<section class="seller-panel"><div class="seller-table-scroll"><div class="seller-product-table"><div class="seller-product-head"><span>Return</span><span>Order</span><span>Customer</span><span>Item</span><span>Reason</span><span>Requested</span><span>Status</span></div>
			for _, item := range p.Returns {
				<div class="seller-product-row"><b>{ item.Number }</b><span>{ item.Order }</span><span>{ item.Customer }</span><span>{ item.Product }</span><span>{ item.Reason }</span><span>{ item.Date }</span><span>{ item.Status }</span></div>
			}
			if len(p.Returns) == 0 {
				@SellerTableEmpty("No return requests", "Customer return requests that include your products appear here.")
			}
		</div></div></section>
	}
}

templ PortalEarnings(p viewmodels.SellerAdminPage) {
	@Document(p) {
		<form class="seller-toolbar" action="/seller-admin/earnings" method="get"><label>Time period<select name="range"><option value="day" selected?={ p.Range == "day" }>Daily</option><option value="week" selected?={ p.Range == "week" }>Weekly</option><option value="month" selected?={ p.Range == "month" }>Monthly</option></select></label><button class="seller-button outline" type="submit">Update</button></form>
		@SellerStatGrid(p)
		<section class="seller-two-grid"><article class="seller-panel"><div class="seller-panel-heading"><div><h2>Seller ledger</h2><p>Recorded transactions for this seller.</p></div></div>
			if len(p.Ledger) == 0 {
				@SellerTableEmpty("No ledger entries", "Ledger entries appear after an order is paid or adjusted.")
			} else {
				<div class="seller-table-scroll"><div class="seller-mini-table"><div class="seller-table-head"><span>Reference</span><span>Date</span><span>Sale</span><span>Commission</span><span>Net</span><span>Status</span></div>@LedgerRows(p.Ledger)</div></div>
			}
		</article><article class="seller-panel"><div class="seller-panel-heading"><div><h2>Settlements</h2><p>Settlement records for this seller account.</p></div></div>
			if len(p.Settlements) == 0 {
				@SellerTableEmpty("No settlements", "Settlement records will appear here when available.")
			} else {
				@SettlementRows(p.Settlements)
			}
		</article></section>
	}
}

templ PortalAnalytics(p viewmodels.SellerAdminPage) {
	@Document(p) {
		<form class="seller-toolbar" action="/seller-admin/analytics" method="get"><label>Time period<select name="range"><option value="day" selected?={ p.Range == "day" }>Daily</option><option value="week" selected?={ p.Range == "week" }>Weekly</option><option value="month" selected?={ p.Range == "month" }>Monthly</option></select></label><button class="seller-button outline" type="submit">Update</button></form>
		@SellerStatGrid(p)
		<section class="seller-panel"><div class="seller-panel-heading"><div><h2>Top-selling products</h2><p>{ p.RangeLabel } · ranked by units sold</p></div></div>
		if len(p.TopProducts) == 0 {
			@SellerTableEmpty("No sales in this period", "Paid orders will appear here as customers buy your products.")
		} else {
			<div class="seller-mini-table"><div class="seller-table-head"><span>Product</span><span>SKU</span><span>Units</span><span>Revenue</span><span>Unit cost</span><span>Unit profit</span><span>Margin</span></div>
				for _, item := range p.TopProducts {
					<div class="seller-table-row"><b>{ item.Name }</b><span>{ item.SKU }</span><span>{ item.Units }</span><strong>{ item.Revenue }</strong><span>{ sellerOptional(item.UnitCost,item.HasCost) }</span><span>{ sellerOptional(item.UnitProfit,item.HasCost) }</span><span>{ sellerOptional(item.Margin,item.HasCost) }</span></div>
				}
			</div>
		}
		</section>
	}
}

templ PortalUnavailable(p viewmodels.SellerAdminPage) {
	@Document(p) {
		<div class="seller-table-empty seller-page-empty" role="status"><span class="material-symbols-outlined" aria-hidden="true">info</span><strong>This workspace is not available yet</strong><small>It currently has no connected workflow. Use the live seller features in the navigation.</small></div>
	}
}

templ PortalOnboarding(p viewmodels.SellerAdminPage) {
	@Document(p) {
		<section class="seller-panel"><div class="seller-panel-heading"><div><h2>Seller application</h2><p>Your seller profile and marketplace approval state.</p></div><span class="seller-status-pill">{ p.SellerStatus }</span></div>
			if p.SellerStatus == "" {
				<form class="seller-inline-form" method="post" action="/seller-admin/onboarding"><input type="hidden" name="csrf_token" value={ p.CSRFToken }/><label>Maker or studio name<input name="display_name" minlength="2" maxlength="120" required/></label><button class="seller-button primary" type="submit">Submit application</button></form>
			} else if p.SellerStatus == "pending" {
				<p>Your seller application for <strong>{ p.SellerName }</strong> is awaiting marketplace review. Product creation and fulfilment tools unlock after approval.</p>
			} else if p.SellerStatus == "active" {
				<p><strong>{ p.SellerName }</strong> is approved. Your seller workspace is ready.</p><a class="seller-button primary" href="/seller-admin/products">Manage products</a>
			} else if p.SellerStatus == "suspended" {
				<p><strong>{ p.SellerName }</strong> is suspended. Contact support to review the decision.</p>
			} else {
				<p>This seller profile is closed and retained for order and audit records.</p>
			}
		</section>
	}
}

templ PortalSettings(p viewmodels.SellerAdminPage) {
	@Document(p) {
		<section class="seller-panel"><div class="seller-panel-heading"><div><h2>Store profile</h2><p>Update the maker or studio name customers see on your seller profile.</p></div></div>
			<form class="seller-inline-form" method="post" action="/seller-admin/settings"><input type="hidden" name="csrf_token" value={ p.CSRFToken }/><label>Seller display name<input name="display_name" value={ p.SellerName } minlength="2" maxlength="120" required/></label><label>Reason for change<input name="reason" minlength="4" maxlength="1000" placeholder="Required for the audit trail" required/></label><button class="seller-button primary" type="submit">Save store profile</button></form>
		</section>
	}
}

templ PortalTeam(p viewmodels.SellerAdminPage) {
	@Document(p) {
		<section class="seller-panel"><div class="seller-panel-heading"><div><h2>Seller staff</h2><p>A Super Admin assigns the Seller Staff role first. You can then add that account here and set its seller-scoped permissions.</p></div></div>
			if p.CanTeam {
				<p class="seller-muted">Use an active account that already has the Seller Staff role. Account creation and global role assignment stay with Super Admin.</p>
				<form class="seller-inline-form" method="post" action="/seller-admin/team/add"><input type="hidden" name="csrf_token" value={ p.CSRFToken }/><label>Email<input type="email" name="email" autocomplete="email" required/></label><fieldset><legend>Assign permissions</legend><label><input type="checkbox" name="permissions" value="PRODUCT_READ"/>Products</label><label><input type="checkbox" name="permissions" value="PRODUCT_WRITE"/>Edit products</label><label><input type="checkbox" name="permissions" value="INVENTORY_READ"/>Inventory</label><label><input type="checkbox" name="permissions" value="INVENTORY_WRITE"/>Adjust stock</label><label><input type="checkbox" name="permissions" value="ORDER_READ"/>Orders</label><label><input type="checkbox" name="permissions" value="ORDER_FULFILL"/>Fulfil orders</label><label><input type="checkbox" name="permissions" value="RETURN_READ"/>Returns</label><label><input type="checkbox" name="permissions" value="REPORT_READ"/>Reports</label></fieldset><button class="seller-button primary" type="submit">Add seller staff</button></form>
			}
			if len(p.Team) == 0 {
				@SellerTableEmpty("No staff accounts", "Add a staff account and assign only the access it needs.")
			} else {
				<div class="seller-table-scroll"><div class="seller-product-table"><div class="seller-product-head"><span>Name</span><span>Email</span><span>Status</span><span>Permissions</span><span>Action</span></div>
					for _, member := range p.Team {
						<div class="seller-product-row"><b>{ member.Name }</b><span>{ member.Email }</span><span>{ member.Status }</span><span>{ member.Permissions }</span><span><form method="post" action="/seller-admin/team/remove"><input type="hidden" name="csrf_token" value={ p.CSRFToken }/><input type="hidden" name="user_id" value={ member.UserID }/><button class="seller-button outline" type="submit">Remove</button></form></span></div>
						if p.CanTeam {
							<form class="seller-inline-form" method="post" action="/seller-admin/team/update"><input type="hidden" name="csrf_token" value={ p.CSRFToken }/><input type="hidden" name="user_id" value={ member.UserID }/><fieldset><legend>Update permissions for { member.Name }</legend>
								<label><input type="checkbox" name="permissions" value="PRODUCT_READ" checked?={ member.ProductRead }/> View products</label><label><input type="checkbox" name="permissions" value="PRODUCT_WRITE" checked?={ member.ProductWrite }/> Edit products</label>
								<label><input type="checkbox" name="permissions" value="INVENTORY_READ" checked?={ member.InventoryRead }/> View inventory</label><label><input type="checkbox" name="permissions" value="INVENTORY_WRITE" checked?={ member.InventoryWrite }/> Adjust inventory</label>
								<label><input type="checkbox" name="permissions" value="ORDER_READ" checked?={ member.OrderRead }/> View orders</label><label><input type="checkbox" name="permissions" value="ORDER_FULFILL" checked?={ member.OrderFulfill }/> Fulfil orders</label>
								<label><input type="checkbox" name="permissions" value="RETURN_READ" checked?={ member.ReturnRead }/> View returns</label><label><input type="checkbox" name="permissions" value="REPORT_READ" checked?={ member.ReportRead }/> View reports</label>
							</fieldset><button class="seller-button primary" type="submit">Save permissions</button></form>
						}
					}
				</div></div>
			}
		</section>
	}
}
