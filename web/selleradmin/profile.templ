package selleradmin

import "github.com/wecratfs/commerce/internal/web/viewmodels"

templ PortalProfile(p viewmodels.SellerAdminPage) {
	@Document(p) {
		<div class="seller-callout" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;">
			<div>
				<strong>Personal account profile</strong>
				<p style="margin:0.25rem 0 0;font-size:0.9rem;">
					These details (photo, name, phone, saved addresses) are private to your personal user account.
				</p>
			</div>
			<a class="seller-button outline" href="/seller-admin/settings">
				Manage public store story &amp; maker portrait →
			</a>
		</div>

		if p.Notice != "" {
			<div class="seller-callout" style="background:#e8f5e9;border-color:#a5d6a7;color:#1b5e20;" role="status">
				{ p.Notice }
			</div>
		}
		if p.ProfileError != "" {
			<div class="seller-callout" style="background:#ffebee;border-color:#ef9a9a;color:#b71c1c;" role="alert">
				{ p.ProfileError }
			</div>
		}

		<div class="seller-profile-layout">
			<section class="seller-panel">
				<div class="seller-panel-heading">
					<div>
						<h2>Personal Details</h2>
						<p>Update your personal display name, avatar, and phone number.</p>
					</div>
				</div>

				<form method="post" action="/seller-admin/profile" enctype="multipart/form-data" class="seller-form-grid">
					<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
					<input type="hidden" name="return_to" value="/seller-admin/profile"/>

					<div class="seller-form-wide" style="display:flex;align-items:center;gap:1.5rem;padding:1rem;background:#faf8f5;border-radius:8px;">
						if p.HasAvatar {
							<img src="/seller-admin/profile/photo" alt={ p.DisplayName } width="80" height="80" style="border-radius:9999px;object-fit:cover;border:2px solid #deddd7;"/>
						} else {
							<div style="width:80px;height:80px;border-radius:9999px;background:#075238;color:#fff;display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:bold;">
								{ p.Initials }
							</div>
						}
						<div style="flex:1;">
							<label style="margin-bottom:0.5rem;">
								<span>Profile photo</span>
								<input type="file" name="photo" accept="image/jpeg,image/png,image/webp"/>
								<small style="color:#757575;">JPEG, PNG or WebP · up to 5 MiB</small>
							</label>
							if p.HasAvatar {
								<label style="display:inline-flex;align-items:center;gap:0.5rem;font-weight:normal;cursor:pointer;margin-top:0.5rem;">
									<input type="checkbox" name="remove_photo" value="1" style="width:auto;min-height:auto;"/>
									<span>Remove current photo</span>
								</label>
							}
						</div>
					</div>

					<label>
						<span>Full Name <strong style="color:#d32f2f;">*</strong></span>
						<input name="name" value={ p.DisplayName } minlength="2" maxlength="100" autocomplete="name" required/>
					</label>

					<label>
						<span>Phone number <strong style="color:#d32f2f;">*</strong></span>
						<input name="phone" value={ p.UserPhone } type="tel" inputmode="tel" autocomplete="tel" maxlength="24" required placeholder="+91 98765 43210"/>
						<small style="color:#757575;">Include country code, e.g. +91.</small>
					</label>

					<label>
						<span>Account email</span>
						<input type="email" value={ p.UserEmail } disabled style="background:#f5f5f5;color:#757575;cursor:not-allowed;"/>
						<small style="color:#757575;">Contact support to request email changes.</small>
					</label>

					<label>
						<span>Seller Studio / Brand</span>
						<input value={ p.SellerName } disabled style="background:#f5f5f5;color:#757575;cursor:not-allowed;"/>
					</label>

					<div class="seller-form-wide">
						<button class="seller-button primary" type="submit">Save personal details</button>
					</div>
				</form>
			</section>

			<section class="seller-panel">
				<div class="seller-panel-heading">
					<div>
						<h2>Saved Addresses</h2>
						<p>Manage return, dispatch, or personal contact addresses.</p>
					</div>
				</div>

				if len(p.Addresses) > 0 {
					<div style="display:grid;gap:1rem;margin-bottom:1.5rem;">
						for _, addr := range p.Addresses {
							<div style="border:1px solid #deddd7;border-radius:8px;padding:1rem;background:#fff;display:flex;justify-content:space-between;align-items:flex-start;">
								<div>
									<h3 style="margin:0 0 0.25rem;font-size:1rem;color:#1a202c;">{ addr.Name } <small style="color:#718096;font-weight:normal;">({ addr.Phone })</small></h3>
									<p style="margin:0;color:#4a5568;font-size:0.9rem;line-height:1.4;">
										{ addr.Line1 }
										if addr.Line2 != "" {
											<br/>{ addr.Line2 }
										}
										<br/>{ addr.City }, { addr.State } { addr.PostalCode }
										<br/>India
									</p>
								</div>
								<form method="post" action="/seller-admin/addresses/delete" onsubmit="return confirm('Delete this saved address?');">
									<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
									<input type="hidden" name="address_id" value={ addr.ID }/>
									<input type="hidden" name="return_to" value="/seller-admin/profile"/>
									<button type="submit" class="seller-button outline" style="padding:4px 8px;font-size:0.8rem;color:#e53e3e;border-color:#feb2b2;">
										Delete
									</button>
								</form>
							</div>
						}
					</div>
				} else {
					<p style="color:#718096;margin-bottom:1.5rem;">No saved addresses yet.</p>
				}

				<details style="border:1px solid #deddd7;border-radius:8px;padding:1rem;background:#faf8f5;">
					<summary style="font-weight:600;cursor:pointer;color:#1a202c;">
						+ Add new address
					</summary>
					<form method="post" action="/seller-admin/addresses" class="seller-form-grid" style="margin-top:1rem;">
						<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
						<input type="hidden" name="return_to" value="/seller-admin/profile"/>
						<input type="hidden" name="country_code" value="IN"/>

						<label>
							<span>Recipient / Contact name <strong style="color:#d32f2f;">*</strong></span>
							<input name="recipient_name" autocomplete="name" maxlength="100" required placeholder="Full name"/>
						</label>

						<label>
							<span>Contact phone <strong style="color:#d32f2f;">*</strong></span>
							<input name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="24" required placeholder="+91 98765 43210"/>
						</label>

						<label class="seller-form-wide">
							<span>Address line 1 <strong style="color:#d32f2f;">*</strong></span>
							<input name="line1" autocomplete="address-line1" maxlength="250" required placeholder="Building no., Street"/>
						</label>

						<label class="seller-form-wide">
							<span>Address line 2 (Optional)</span>
							<input name="line2" autocomplete="address-line2" maxlength="250" placeholder="Apartment, landmark"/>
						</label>

						<label>
							<span>City <strong style="color:#d32f2f;">*</strong></span>
							<input name="city" autocomplete="address-level2" maxlength="100" required placeholder="City"/>
						</label>

						<label>
							<span>State <strong style="color:#d32f2f;">*</strong></span>
							<input name="state" autocomplete="address-level1" maxlength="100" required placeholder="State"/>
						</label>

						<label>
							<span>PIN Code <strong style="color:#d32f2f;">*</strong></span>
							<input name="postal_code" autocomplete="postal-code" inputmode="numeric" pattern="[1-9][0-9]{5}" minlength="6" maxlength="6" required placeholder="6-digit PIN code"/>
						</label>

						<div class="seller-form-wide" style="margin-top:0.5rem;">
							<button class="seller-button primary" type="submit">Save address</button>
						</div>
					</form>
				</details>
			</section>
		</div>
	}
}
