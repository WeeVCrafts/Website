package components

import (
 "fmt"
 "github.com/wecratfs/commerce/internal/web/viewmodels"
)

templ GuidedLaunchStep(p viewmodels.MarketplacePage) {
 <a href={templ.SafeURL(guidedStepURL(p,"review"))}>← Back to review</a>
 if p.SetupStep=="policy" {
  <h2>Publish returns policy</h2><p><a href="/returns-replacements-authenticity" target="_blank" rel="noopener">Read the policy ↗</a>. Existing orders keep their previous terms.</p>
  if p.Policy.PublishedAt!=nil {
   <p class="guided-success">Policy {p.Policy.Version} published {p.Policy.PublishedAt.Format("2 Jan 2006")}.</p>
  } else {
   <form class="marketplace-form" data-fulfillment-setup-action="publish_policy" method="post" action={templ.SafeURL(p.ActionPath)} novalidate>@MarketplaceFields(p,"publish_policy") @SetupErrors(p,"publish_policy") @GuidedLaunchReason(p,"publish_policy","Publication reason","I confirm this policy and its operational workflows are ready","Publish policy")</form>
  }
 } else if p.SetupStep=="pilot" {
  <h2>One genuine order pilot</h2><p>The pilot uses {p.Setup.Product}. It requires complete product setup, stock, published policy, enabled production switches and a funded Shiprocket wallet. No payment or shipment is created by this form.</p><p>Current shipping mode: <strong>{p.Policy.ShippingMode}</strong> · Pilot order: {fmt.Sprint(p.Policy.PilotOrderID)}</p>
  if !p.BookingsEnabled||!p.CheckoutEnabled {
   <div class="guided-alert guided-activation-status" role="status">
    <strong>Production activation is required</strong>
    <p>Checkout is {guidedSwitchState(p.CheckoutEnabled)}. Shipment bookings are {guidedSwitchState(p.BookingsEnabled)}.</p>
   </div>
   <details class="guided-activation-help"><summary>How to enable the one-order pilot</summary>
    <ol>
     <li>Verify this product and seller, publish the policy and fund the Shiprocket wallet.</li>
     <li>Open <a href="https://coolify.weevcrafts.com" target="_blank" rel="noopener">Coolify</a>, select the WeevCrafts website application, then open Environment Variables.</li>
     <li>Set <code>WECRATFS_CHECKOUT_ENABLED=true</code> and <code>WECRATFS_SHIPROCKET_BOOKINGS_ENABLED=true</code> as runtime variables. Save and redeploy the reviewed application.</li>
     <li>Return here, choose the customer account that will place the real order, enter the activation reason and confirm the wallet is funded. Select Enable one-order pilot.</li>
    </ol>
    <p>Shipping mode <strong>off</strong> means the pilot has not been activated. After activation, only the selected customer and product option can place the pilot order.</p>
   </details>
  }
  <form class="guided-filters" method="get" action={templ.SafeURL(p.Root)}><input type="hidden" name="tab" value="setup"/><input type="hidden" name="step" value="pilot"/><input type="hidden" name="seller_id" value={fmt.Sprint(p.Setup.Query.SellerID)}/><input type="hidden" name="variant_id" value={fmt.Sprint(p.Setup.Query.VariantID)}/><label>Find pilot customer<input name="customer_q" value={p.Setup.Query.CustomerSearch} maxlength="120" placeholder="Customer name or ID"/></label><button type="submit">Find customers</button></form>
  if p.Setup.NextCustomer>0 {
   <a href={templ.SafeURL(p.SetupURL("customer_before",fmt.Sprint(p.Setup.NextCustomer)))}>More customers</a>
  }
  if p.Setup.Query.CustomerBefore>0 {
   <a href={templ.SafeURL(p.SetupURL("customer_before",""))}>First customer page</a>
  }
  <form class="marketplace-form" data-fulfillment-setup-action="configure_pilot" method="post" action={templ.SafeURL(p.ActionPath)} novalidate>@MarketplaceFields(p,"configure_pilot") @SetupErrors(p,"configure_pilot")<input type="hidden" name="variant_id" value={fmt.Sprint(p.Setup.Query.VariantID)}/><label>Customer account<select name="customer_id" required>@SetupOptions(p.Setup.Customers,setupFormID(p,"configure_pilot","customer_id"),"Choose an active customer")</select></label>@SetupFieldError(p,"configure_pilot","customer_id") @GuidedLaunchReason(p,"configure_pilot","Activation reason","Wallet is funded and this customer and product are ready for a genuine shipment","Enable one-order pilot")</form>
 } else if p.SetupStep=="launch" {
  <h2>Launch catalog</h2><p>After the prepaid Shiprocket pilot is delivered, you can open checkout for the pilot seller or expand to all ready options.</p>
  if p.Policy.PilotOrderID==0 {
   <p class="guided-alert">A genuine pilot order is required first. <a href={templ.SafeURL(guidedStepURL(p,"pilot"))}>Open pilot setup</a></p>
  } else {
   if p.Policy.LiveCatalogScope=="seller" {
    <p class="guided-success">Only ready options from the activated seller are eligible for public checkout.</p>
   } else if p.Policy.LiveCatalogScope=="ready" {
    <p class="guided-success">All ready options are eligible for public checkout.</p>
   }
   if p.Policy.LiveCatalogScope=="seller" || p.Policy.LiveCatalogScope=="ready" {
    <form class="marketplace-form" method="post" action={templ.SafeURL(p.ActionPath)} novalidate>@MarketplaceFields(p,"restore_limited_catalog") @SetupErrors(p,"restore_limited_catalog") @GuidedLaunchReason(p,"restore_limited_catalog","Reason","Only options in the saved limited catalog will remain eligible","Restore limited catalog")</form>
   }
   if p.Policy.LiveCatalogScope!="ready" {
    <form class="marketplace-form" method="post" action={templ.SafeURL(p.ActionPath)} novalidate>@MarketplaceFields(p,"activate_pilot_seller") @SetupErrors(p,"activate_pilot_seller")<input type="hidden" name="variant_id" value={fmt.Sprint(p.Setup.Query.VariantID)}/>@GuidedLaunchReason(p,"activate_pilot_seller","Launch reason","I verified this seller’s delivered pilot and live shipping setup","Enable checkout for "+p.Setup.Seller)</form>
    <form class="marketplace-form" method="post" action={templ.SafeURL(p.ActionPath)} novalidate>@MarketplaceFields(p,"activate_ready_catalog") @SetupErrors(p,"activate_ready_catalog") @GuidedLaunchReason(p,"activate_ready_catalog","Launch reason","I verified the delivered pilot and the live shipping setup","Enable all ready options")</form>
   }
   <h3>Limited launch catalog</h3><p>Choose one ready option from each of two sellers.</p>
   <form class="guided-filters" method="get" action={templ.SafeURL(p.Root)}><input type="hidden" name="tab" value="setup"/><input type="hidden" name="step" value="launch"/><input type="hidden" name="seller_id" value={fmt.Sprint(p.Setup.Query.SellerID)}/><input type="hidden" name="variant_id" value={fmt.Sprint(p.Setup.Query.VariantID)}/><label>Find ready launch options<input name="launch_q" value={p.Setup.Query.LaunchSearch} maxlength="120"/></label><button type="submit">Find ready options</button></form>
   if p.Setup.NextLaunch>0 {
    <a href={templ.SafeURL(p.SetupURL("launch_before",fmt.Sprint(p.Setup.NextLaunch)))}>More ready options</a>
   }
   if p.Setup.Query.LaunchBefore>0 {
    <a href={templ.SafeURL(p.SetupURL("launch_before",""))}>First ready-options page</a>
   }
   <form class="marketplace-form" data-fulfillment-setup-action="configure_live_catalog" method="post" action={templ.SafeURL(p.ActionPath)} novalidate>@MarketplaceFields(p,"configure_live_catalog") @SetupErrors(p,"configure_live_catalog")<label>First ready product option<select name="variant_id" required>@SetupOptions(p.Setup.LaunchVariants,setupFormID(p,"configure_live_catalog","variant_id"),"Choose the first seller’s ready option")</select></label>@SetupFieldError(p,"configure_live_catalog","variant_id")<label>Second ready product option<select name="second_variant_id" required>@SetupOptions(p.Setup.LaunchVariants,setupFormID(p,"configure_live_catalog","second_variant_id"),"Choose a different seller’s ready option")</select></label>@SetupFieldError(p,"configure_live_catalog","second_variant_id") @GuidedLaunchReason(p,"configure_live_catalog","Launch reason","I verified the recovery drill, two-seller rehearsal and launch notifications","Save and activate launch catalog")</form>
  }
 } else if p.SetupStep=="pause" {
  <h2>Pause new shipping</h2><p>Pause new purchases and bookings while payment and carrier reconciliation continues. Current shipping mode: <strong>{p.Policy.ShippingMode}</strong>.</p>
  <form class="marketplace-form" data-fulfillment-setup-action="pause_shipping" method="post" action={templ.SafeURL(p.ActionPath)} novalidate>@MarketplaceFields(p,"pause_shipping") @SetupErrors(p,"pause_shipping") @GuidedLaunchReason(p,"pause_shipping","Pause reason","Pause new purchases and bookings; continue reconciliation","Pause new shipping")</form>
 }
}

templ GuidedLaunchReason(p viewmodels.MarketplacePage,action,label,confirmation,button string) {
 <label for={action+"_reason"}>{label}</label><input id={action+"_reason"} name="reason" value={p.FormValue(action,"reason","")} minlength="10" maxlength="1000" required/>@SetupFieldError(p,action,"reason")
 <label class="guided-confirm"><input id={action+"_confirmed"} type="checkbox" name="confirmed" value="yes" checked?={p.FormValue(action,"confirmed","")=="yes"} required/>{confirmation}</label>@SetupFieldError(p,action,"confirmed")
 <div class="guided-actions"><a class="guided-secondary" href={templ.SafeURL(guidedStepURL(p,"review"))}>Back to review</a><button type="submit">{button}</button></div>
}

func guidedSwitchState(enabled bool) string {
 if enabled { return "enabled" }
 return "paused"
}
