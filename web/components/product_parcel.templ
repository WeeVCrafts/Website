package components

import "github.com/wecratfs/commerce/internal/web/viewmodels"

templ ProductParcelFields(v viewmodels.ProductVariant) {
	if v.Status == "" || v.Status == "active" || v.Status == "pending_review" {
		<fieldset class="ui-form-section">
			<legend>Shipping measurements</legend>
			if v.ShippingSource != "" {
				<p>{ v.ShippingSource }</p>
			}
			<p>Measure the parcel with its protective packaging. Enter all four values together (minimum weight 100g, box dimensions 1-200 cm).</p>
			<label>Packed weight (grams)<input name="shipping_weight_g" type="number" min="100" max="50000" placeholder="e.g. 500" value={ v.ShippingWeight }/><small class="seller-field-hint">Minimum 100 grams. For light craft items, include the parcel box weight.</small></label>
			<label>Packed length (cm)<input name="shipping_length_cm" type="number" min="1" max="200" placeholder="e.g. 25" value={ v.ShippingLength }/><small class="seller-field-hint">Whole centimetres (1-200 cm).</small></label>
			<label>Packed width (cm)<input name="shipping_width_cm" type="number" min="1" max="200" placeholder="e.g. 15" value={ v.ShippingWidth }/><small class="seller-field-hint">Whole centimetres (1-200 cm).</small></label>
			<label>Packed height (cm)<input name="shipping_height_cm" type="number" min="1" max="200" placeholder="e.g. 10" value={ v.ShippingHeight }/><small class="seller-field-hint">Whole centimetres (1-200 cm).</small></label>
			<div class="parcel-dimension-preview" data-parcel-preview hidden>
				<strong>Package preview</strong>
				<p>Enter all three dimensions to preview the packed shape used for delivery.</p>
				<div class="parcel-dimension-canvas" data-parcel-canvas aria-label="3D packed parcel preview" role="img"></div>
				<small data-parcel-preview-label>Awaiting length, width and height.</small>
			</div>
		</fieldset>
	}
}
