package components

import (
	"fmt"
	"github.com/wecratfs/commerce/internal/ports"
	"github.com/wecratfs/commerce/internal/web/viewmodels"
	"net/url"
	"strings"
)

templ MarketplaceShippingProgress(step int, method string) {
	if step>0 {
		<ol class="commerce-shipping-steps" aria-label="Shipping progress">
			<li if step==1 { aria-current="step" }>Pack</li>
			<li if step==2 { aria-current="step" }>
				if method=="shiprocket" {
					Book shipment
				} else {
					Hand over
				}
			</li>
			<li if step==3 { aria-current="step" }>Track</li>
		</ol>
	}
}

templ MarketplacePackForm(p viewmodels.MarketplacePage, seller ports.MarketplaceSellerOrder, lines []commercePackingLine) {
	<form class="marketplace-form" method="post" action={ templ.SafeURL(p.ActionPath) }>
		@MarketplaceFields(p, "package")
		<input type="hidden" name="seller_id" value={ fmt.Sprint(seller.SellerID) }/>
		<fieldset class="commerce-pack-group">
			<legend>Items left to pack</legend>
			<p class="commerce-muted">Adjust the quantities if you’re splitting the order into parcels.</p>
			for _, line := range lines {
				<label class="commerce-pack-item">
					<span>{ line.Item.Name } <small>{ fmt.Sprintf("%s · %d remaining", line.Item.SKU, line.Remaining) }</small></span>
					<input type="number" inputmode="numeric" name={ fmt.Sprintf("item_%d", line.Item.ID) } min="0" max={ fmt.Sprint(line.Remaining) } value={ fmt.Sprint(line.Remaining) }/>
				</label>
			}
		</fieldset>
		<fieldset class="commerce-pack-group">
			<legend>Parcel details</legend>
			<p class="commerce-muted">Weigh and measure the sealed parcel, including all packaging.</p>
			<div class="commerce-pack-measurements">
				<label>Weight (grams)<input name="weight_grams" type="number" inputmode="numeric" min="100" max="50000" required/></label>
				<label>Length (cm)<input name="length_cm" type="number" inputmode="numeric" min="1" max="200" required/></label>
				<label>Width (cm)<input name="width_cm" type="number" inputmode="numeric" min="1" max="200" required/></label>
				<label>Height (cm)<input name="height_cm" type="number" inputmode="numeric" min="1" max="200" required/></label>
			</div>
		</fieldset>
		<button type="submit">Save package</button>
	</form>
}

templ MarketplaceReadyForm(p viewmodels.MarketplacePage, seller ports.MarketplaceSellerOrder) {
	<h4>All items are packed</h4>
	<form class="marketplace-form" method="post" action={ templ.SafeURL(p.ActionPath) }>
		@MarketplaceFields(p, "ready")
		<input type="hidden" name="seller_id" value={ fmt.Sprint(seller.SellerID) }/>
		<input type="hidden" name="revision" value={ fmt.Sprint(seller.Revision) }/>
		if seller.DeliveryMethod=="shiprocket" {
			if p.BookingsEnabled {
				<p>Ready to ship sends the saved parcels to Shiprocket for booking.</p>
			} else {
				<p>Shiprocket booking is paused. Your packing details are saved.</p>
			}
		} else {
			<p>Confirm packing to open the courier handover form.</p>
		}
		<label class="commerce-pack-confirm"><input type="checkbox" name="confirmed" value="yes" required/> I confirm the package contents, weight and dimensions.</label>
		if p.NewReturnPolicy {
			<label>
				Pre-dispatch quality-check evidence
				<input name="qc_evidence" minlength="10" maxlength="1000" required aria-describedby={ fmt.Sprintf("packing-check-%d", seller.SellerID) }/>
			</label>
			<p id={ fmt.Sprintf("packing-check-%d", seller.SellerID) } class="commerce-muted">Briefly record what you checked before sealing the parcel.</p>
		}
		<button type="submit" disabled?={ !p.BookingsEnabled && seller.DeliveryMethod=="shiprocket" }>Ready to ship</button>
	</form>
}

templ MarketplaceSellerShipmentStatus(p viewmodels.MarketplacePage, pkg ports.MarketplacePackage) {
	if pkg.PendingAction!="" {
		<p role="status">Shiprocket is confirming an update. Wait for it to finish before making another booking change.</p>
	} else if pkg.Status=="created" {
		if commerceParcelAwaitingConfirmation(p,pkg) {
			<p>Package saved. Confirm packing to start booking.</p>
		} else if pkg.AWB!="" {
			<p>Tracking number assigned. Waiting for pickup confirmation.</p>
		} else {
			<p>Booking requested. Refresh shipment to check for updates.</p>
		}
	} else if pkg.Status=="pickup_scheduled" {
		if pkg.LabelURL!="" && pkg.AWB!="" {
			<p>Print and attach the carrier label before handing over the parcel at pickup.</p>
		} else {
			<p>Pickup is scheduled. The carrier label will appear here when Shiprocket provides it.</p>
		}
	} else if pkg.Status=="ndr" {
		<p>Delivery needs attention. Contact WeevCrafts support with the tracking number.</p>
	}
}

templ MarketplaceOperations(p viewmodels.MarketplacePage) {
	<div class="fulfillment-operations">
		if !p.Workspace && p.Role=="seller" {
			@SellerFulfillmentTabs(false)
		}
		if p.Role=="customer" {
 @MarketplacePolicyControls(p)
}
		if !p.Workspace {
			<form class="marketplace-form" method="get" action={ templ.SafeURL(p.Root) }><input type="hidden" name="tab" value="operations"/><label>Find order<input name="order" value={ p.Number } maxlength="120" required/></label><button type="submit">Open order</button></form>
		}
		if p.Number=="" {
if p.Role=="super_admin" {
<p><a class="commerce-button secondary" href="/super-admin/fulfillment/reviews">Review seller invoice and tax submissions</a></p>
}
			<h2>Recent orders</h2>
			if len(p.Orders)==0 {
				<p>No orders are available for this account.</p>
			}
			<ul>
				for _,o:=range p.Orders {
					<li>
						if p.Role=="seller" {
							<a href={templ.SafeURL("/seller-admin/orders/"+url.PathEscape(o.Number)+"?tab=packages")}>{o.Number}</a> · {sellerFulfillmentNextAction(o)}
						} else {
							<a href={templ.SafeURL(p.Root+"?order="+url.QueryEscape(o.Number))}>{o.Number}</a> · {strings.ReplaceAll(o.Status,"_"," ")}
						}
					</li>
				}
			</ul>
			if p.Role=="admin" || p.Role=="super_admin" {
				<h2>Seller follow-up</h2>
				<p>Acceptance after 24 hours, packing after a 48-hour dispatch target, and seller cancellations in the last seven days.</p>
				if len(p.Queue)==0 {
					<p>No seller follow-up is due.</p>
				}
				<ul>
					for _,item:=range p.Queue {
						<li><a href={ templ.SafeURL(p.Root+"?order="+url.QueryEscape(item.Number)) }>{ item.Number }</a> · { item.Seller } · { item.Issue }</li>
					}
				</ul>
				<h2>Support delivery queues</h2>
				<nav aria-label="Exception queues">
					for _,kind:=range []string{"","delayed_order","failed_delivery","ndr","rto","return_dispute","refund_request","seller_escalation","delivery_dispute","unknown_status","provider_error"} {
						<a href={ templ.SafeURL(p.Root + "?queue=" + url.QueryEscape(kind)) }>
							{ marketplaceQueueLabel(kind) }
						</a>
					}
				</nav>
				<p>Open complaints, seller follow-up and historical support conversations remain in <a href={ templ.SafeURL(p.Back + "/support") }>Support</a>.</p>
				if len(p.Cases)==0 {
					<p>No open fulfillment exceptions.</p>
				}
				for _,c:=range p.Cases {
					<article class="admin-panel">
						<h3>
							{ strings.ReplaceAll(c.Kind,"_"," ") } —
							<a href={ templ.SafeURL(p.Root + "?order=" + url.QueryEscape(c.Number)) }>
								{ c.Number }
							</a>
						</h3>
						<p>
							{ c.Reason }
						</p>
						if c.Assignee != "" {
							<p>Assigned to { c.Assignee }</p>
						}
						if c.NextAction != "" {
							<p>Next action: { c.NextAction }</p>
						}
						<form class="marketplace-form" method="post" action={ templ.SafeURL(p.ActionPath) }>
							@MarketplaceFields(p, "")
							<input type="hidden" name="case_id" value={ fmt.Sprint(c.ID) }/><label>Next action or resolution<textarea style="resize:none" name="reason" minlength="4" maxlength="1000" required></textarea></label><button type="submit" name="action" value="assign_case">Assign to me</button> <button type="submit" name="action" value="resolve_case">Resolve case</button>
						</form>
					</article>
				}
				if p.NextCaseID>0 {
					<a href={ templ.SafeURL(fmt.Sprintf("%s?case_before=%d", p.Root, p.NextCaseID)) }>More exception cases</a>
				}
				<h2>Background operations needing attention</h2>
				if len(p.Jobs)==0 {
					<p>No failed operations.</p>
				}
				for _,j:=range p.Jobs {
					<article class="admin-panel">
						<h3>
							{ strings.ReplaceAll(j.Kind,"_"," ") } #{ fmt.Sprint(j.ID) }
						</h3>
						<p>
							{ j.LastError }
						</p>
						<form class="marketplace-form" method="post" action={ templ.SafeURL(p.ActionPath) }>
							@MarketplaceFields(p, "retry_job")
							<input type="hidden" name="case_id" value={ fmt.Sprint(j.ID) }/><label>Reconciliation evidence / reason<input name="reason" minlength="4" maxlength="1000" required/></label><button type="submit">Retry reconciliation</button>
						</form>
					</article>
				}
			}
		} else {
			if !p.Workspace {
			<h2>
				Order { p.Number }
			</h2>
			<p>
				Order:
				<strong>
					{ strings.ReplaceAll(p.Status,"_"," ") }
				</strong> · Payment:
				<strong>
					{ strings.ReplaceAll(p.Payment,"_"," ") }
				</strong>
			</p>
			<p>View the <a href="/returns-replacements-authenticity">returns, replacements and authenticity policy</a>. Your purchase retains its recorded policy.</p>
			@MarketplacePolicyClaims(p)

			}
			if !p.Workspace || p.OrderTab=="packages" {
			for _,s:=range p.Sellers {
				<article class="seller-panel">
					<h3>
						{ s.Name }
					</h3>
					<p>{ commerceLabel(s.Status) }</p>
					if p.Role!="customer" && (p.Role!="seller" || p.WorkflowVersion!=2) {
						<p>Settlement: {strings.ReplaceAll(s.SettlementStatus,"_"," ")}</p>
					}
					if p.Role=="seller" && p.WorkflowVersion==2 {
						{{ lines := commercePackingLines(p, s.SellerID) }}
						@MarketplaceShippingProgress(commerceShippingStep(p, s, len(lines)>0), s.DeliveryMethod)
						if s.Status=="new" || s.Status=="accepted" {
							<form class="marketplace-form" method="post" action={ templ.SafeURL(p.ActionPath) }>
								@MarketplaceFields(p, "")
								<input type="hidden" name="seller_id" value={ fmt.Sprint(s.SellerID) }/><input type="hidden" name="revision" value={ fmt.Sprint(s.Revision) }/>
								if s.Status=="new" {
									<button type="submit" name="action" value="accept">Accept order</button>
								} else {
									<button type="submit" name="action" value="pack">Start packing</button>
								}
							</form>
						}
						if s.Status=="packing" {
							if p.ShippingConfigured || s.DeliveryMethod!="shiprocket" {
								if len(lines)>0 {
									@MarketplacePackForm(p, s, lines)
								} else {
									@MarketplaceReadyForm(p, s)
								}
							} else {
								<p>Shipping setup is incomplete. Contact company support to arrange delivery.</p>
							}
						}
					}
				</article>
			}

			}
			if !p.Workspace || p.OrderTab=="returns" {
			<h2>Items</h2>
			for _,item:=range p.Lines {
				<article class="admin-panel">
					<h3>
						{ item.Name }
					</h3>
					<p>{ fmt.Sprint(item.Quantity) } ordered · { fmt.Sprint(item.Cancelled) } cancelled · { fmt.Sprint(item.Refunded) } refunded</p>
					if p.Role=="customer" || p.Role=="seller" || p.Role=="admin" || p.Role=="super_admin" {
						if (item.CanCancel || (!p.NewReturnPolicy && p.Role!="seller")) && item.Quantity>item.Cancelled && (p.Payment=="captured" || p.Payment=="funded" || p.Payment=="partially_refunded") {
							<details>
								<summary>Cancellation or item issue</summary>
								<form class="marketplace-form" method="post" action={ templ.SafeURL(p.ActionPath) }>
									@MarketplaceFields(p, "")
									<input type="hidden" name="item_id" value={ fmt.Sprint(item.ID) }/><input type="hidden" name="seller_id" value={ fmt.Sprint(item.SellerID) }/><label>Quantity<input type="number" name="quantity" value="1" min="1" max={ fmt.Sprint(item.Quantity - item.Cancelled) } required/></label><label>Reason<textarea style="resize:none" name="reason" minlength="10" maxlength="1000" required></textarea></label><label><input type="checkbox" name="confirmed" value="yes" required/> Confirm this request for the selected items.</label>
									if p.Role=="seller" {
										if item.CanCancel {
											<button type="submit" name="action" value="reject">Reject unavailable items</button>
										}
									} else {
										if item.CanCancel {
											<button type="submit" name="action" value="cancel">Cancel before courier pickup</button>
										}
										if !p.NewReturnPolicy {
<button type="submit" name="action" value="request_refund">Request investigation and refund</button>
}
										if item.CanReturn && !p.NewReturnPolicy {
											<button type="submit" name="action" value="request_return">Request exceptional return review</button>
										}
									}
								</form>
							</details>
						}
					}
				</article>
			}

			}
			if !p.Workspace || p.OrderTab=="packages" {
			<h2>Packages</h2>
			if len(p.Packages)==0 {
				if p.Role=="seller" {
					<p>Your saved packages will appear here.</p>
				} else {
					<p>Package details will appear here when the seller saves them.</p>
				}
			}
			for _,pkg:=range p.Packages {
				<article class="seller-panel">
					<h3>
						Package { fmt.Sprint(pkg.ID) }
					</h3>
					<p><strong>{ commerceLabel(pkg.Status) }</strong></p>
					if pkg.Courier!="" || pkg.AWB!="" {
						<p>
							if pkg.Courier!="" {
								{ pkg.Courier }
							}
							if pkg.Courier!="" && pkg.AWB!="" {
								<span aria-hidden="true"> · </span>
							}
							if pkg.AWB!="" {
								<span>Tracking number { pkg.AWB }</span>
							}
						</p>
					}
					<ul>
						for _,content:=range pkg.Items {
							<li>{ content.Name } — { content.SKU } × { fmt.Sprint(content.Quantity) }</li>
						}
					</ul>
					if p.Role=="seller" && pkg.Parcel.Valid() {
						<p class="commerce-muted">{ fmt.Sprintf("%d g · %d × %d × %d cm (L × W × H)", pkg.WeightGrams, pkg.LengthCM, pkg.WidthCM, pkg.HeightCM) }</p>
					}
					if p.Role!="customer" {
						<a href={ templ.SafeURL(p.Root + "?order=" + url.QueryEscape(p.Number) + "&packing_slip=" + fmt.Sprint(pkg.ID)) }>Download package packing slip</a>
					}
					if p.Role=="seller" && pkg.DeliveryMethod=="shiprocket" {
						@MarketplaceSellerShipmentStatus(p, pkg)
					} else if pkg.PendingAction!="" {
						<p role="status">Waiting for the carrier to confirm { pkg.PendingAction }. Please do not create a replacement shipment.</p>
					}
					if (p.Role=="admin" || p.Role=="super_admin") && pkg.Status=="ndr" {
						<form class="marketplace-form" method="post" action={ templ.SafeURL(p.ActionPath) }>
							@MarketplaceFields(p, "")
							<input type="hidden" name="package_id" value={ fmt.Sprint(pkg.ID) }/><label>Customer contact outcome<textarea style="resize:none" name="reason" minlength="4" maxlength="1000" required></textarea></label><label>Preferred redelivery date (required for reattempt)<input name="preferred_date" type="date"/></label><button type="submit" name="action" value="ndr_reattempt">Request delivery reattempt</button><button type="submit" name="action" value="ndr_return">Request return to origin</button>
						</form>
					}
					if pkg.DeliveryMethod=="manual" && ((p.Role=="seller" && pkg.Status=="created" && (p.WorkflowVersion!=2 || commerceSellerReady(p,pkg.SellerID))) || ((p.Role=="admin" || p.Role=="super_admin") && pkg.Status=="in_transit")) {
						<form class="marketplace-form" method="post" action={ templ.SafeURL(p.ActionPath) }>
							@MarketplaceFields(p, "")
							<input type="hidden" name="package_id" value={ fmt.Sprint(pkg.ID) }/><input type="hidden" name="seller_id" value={ fmt.Sprint(pkg.SellerID) }/><label>Actual carrier<input name="carrier" value={ pkg.Courier } minlength="2" maxlength="80" required/></label><label>Actual tracking number<input name="tracking_number" value={ pkg.AWB } minlength="3" maxlength="120" required/></label><label>Courier handover / delivery evidence<textarea style="resize:none" name="reason" minlength="10" maxlength="1000" required></textarea></label>
							if p.Role=="seller" {
								<button type="submit" name="action" value="manual_dispatch">Record courier handover</button>
							} else {
								<button type="submit" name="action" value="manual_delivered">Confirm verified delivery</button>
							}
						</form>
					}
					if (p.Role=="admin" || p.Role=="super_admin") && pkg.ProviderStatus=="RTO DELIVERED" {
						<form class="marketplace-form" method="post" action={ templ.SafeURL(p.ActionPath) }>
							@MarketplaceFields(p, "inspect_rto")
							<input type="hidden" name="package_id" value={ fmt.Sprint(pkg.ID) }/><label>Physical return inspection outcome<textarea name="reason" minlength="10" maxlength="1000" required></textarea></label><label><input name="restock" type="checkbox" value="yes"/> Physically received goods are suitable for resale</label><button type="submit">Record inspection and request refund approval</button>
						</form>
					}
					if p.Role!="customer" && pkg.DeliveryMethod!="manual" {
						if pkg.LabelURL!="" && pkg.AWB!="" {
							<a href={ templ.SafeURL(pkg.LabelURL) } target="_blank" rel="noopener noreferrer">Download carrier label</a>
						}
						if pkg.ManifestURL!="" {
							<a href={ templ.SafeURL(pkg.ManifestURL) } target="_blank" rel="noopener noreferrer">Download pickup manifest</a>
						}
						if pkg.Status!="delivered" && pkg.Status!="cancelled" && (p.Role!="seller" || !commerceParcelAwaitingConfirmation(p,pkg)) {
							<form class="marketplace-form commerce-shipment-actions" method="post" action={ templ.SafeURL(p.ActionPath) }>
								@MarketplaceFields(p, "")
								<input type="hidden" name="package_id" value={ fmt.Sprint(pkg.ID) }/>
								<input type="hidden" name="seller_id" value={ fmt.Sprint(pkg.SellerID) }/>
								<button type="submit" name="action" value="refresh_package">Refresh shipment</button>
								if pkg.Status=="pickup_scheduled" && pkg.PendingAction=="" {
									<button type="submit" name="action" value="reschedule_pickup" data-confirm="Reschedule pickup for this package? Confirm that the courier has not collected it.">Reschedule missed pickup</button>
								}
							</form>
						}
					}
				</article>
			}

			}
			if !p.Workspace || p.OrderTab=="returns" {
			if len(p.Returns)>0 {
			<h2>Exceptional returns</h2>
			}
			for _,ret:=range p.Returns {
				<article class="admin-panel">
					<h3>
						Return #{ fmt.Sprint(ret.ID) }
					</h3>
					<p>
						{ ret.Status } · { ret.Carrier } · { ret.Tracking }
					</p>
					<p>
						{ ret.Reason }
					</p>
					if (p.Role=="admin" || p.Role=="super_admin") && len(commerceReturnStages(ret.Status))>0 {
						<form class="marketplace-form" method="post" action={ templ.SafeURL(p.ActionPath) }>
							@MarketplaceFields(p, "return_status")
							<input name="case_id" type="hidden" value={ fmt.Sprint(ret.ID) }/><label>Next return stage<select name="status">for _,stage:=range commerceReturnStages(ret.Status) {
<option value={stage}>{commerceLabel(stage)}</option>
}
</select></label><label>Actual return carrier<input name="carrier" maxlength="80"/></label><label>Actual return tracking number<input name="tracking_number" maxlength="120"/></label><label>Customer-visible decision / inspection summary<textarea style="resize:none" name="reason" minlength="10" maxlength="1000" required></textarea></label><label><input type="checkbox" name="restock" value="yes"/> On completion, inspected goods are suitable for resale. Restock the received quantity.</label><button type="submit">Save return decision</button>
						</form>
					}
				</article>
			}

			}
			if !p.Workspace || p.OrderTab=="documents" {
			<h2>Invoices</h2>
 if p.Role=="customer" && p.Summary!=nil && (p.Summary.Financial.CapturedCents>0 || p.Summary.Financial.CreditAppliedCents>0) {
 <p><a href={templ.SafeURL("/orders/"+url.PathEscape(p.Number)+"/invoice?format=pdf")}>Download payment receipt</a></p>
 }
			<p>Seller invoices and payment receipts are separate documents.</p>
			if len(p.Invoices)==0 {
				<p>Invoices will appear after verified seller and product tax details are available.</p>
			}
			for _,invoice:=range p.Invoices {
				<p>
					<a href={ templ.SafeURL(p.Root + "?order=" + url.QueryEscape(p.Number) + "&invoice=" + fmt.Sprint(invoice.ID)) }>
						Download invoice { invoice.Number }
					</a>
				</p>
			}
			for _,note:=range p.CreditNotes {
				<p>
					<a href={ templ.SafeURL(p.Root + "?order=" + url.QueryEscape(p.Number) + "&kind=credit&invoice=" + fmt.Sprint(note.ID)) }>
						Download credit note { note.Number }
					</a>
				</p>
			}

			}
			if !p.Workspace || p.OrderTab=="returns" {
			<h2>Refund status</h2>
			if len(p.Refunds)==0 {
				<p>No item refund requests.</p>
			}
			for _,refund:=range p.Refunds {
				<article class="admin-panel">
					<h3>
						Refund #{ fmt.Sprint(refund.ID) }
					</h3>
					<p>
						{ strings.ReplaceAll(refund.Status,"_"," ") } · INR { fmt.Sprintf("%.2f",float64(refund.AmountCents+refund.ShippingCents)/100) }
					</p>
					<p>
						{ refund.Reason }
					</p>
					if (p.Role=="admin" || p.Role=="super_admin") && refund.Status=="failed" {
						<form class="marketplace-form" method="post" action={ templ.SafeURL(p.ActionPath) }>@MarketplaceFields(p, "retry_failed_refund")
<input type="hidden" name="refund_id" value={ fmt.Sprint(refund.ID) }/><label>Verified provider failure and retry reason<input name="reason" minlength="4" maxlength="1000" required/></label><label><input name="confirmed" type="checkbox" value="yes" required/> Authorize another real refund attempt after the provider-confirmed failure.</label><button type="submit">Approve failed refund retry</button></form>
					}
					if (p.Role=="admin" || p.Role=="super_admin") && refund.Status=="requested" {
						<form class="marketplace-form" method="post" action={ templ.SafeURL(p.ActionPath) }>
							@MarketplaceFields(p, "")
							<input type="hidden" name="refund_id" value={ fmt.Sprint(refund.ID) }/><label>Decision reason<input name="reason" minlength="4" maxlength="1000" required/></label><label><input name="confirmed" type="checkbox" value="yes" required/> I verified the item claim and refundable amount.</label><button type="submit" name="action" value="approve_refund">Approve real refund</button><button type="submit" name="action" value="reject_refund">Reject refund request</button>
						</form>
					}
				</article>
			}
			}

		}

	</div>
}

templ MarketplaceFields(p viewmodels.MarketplacePage, action string) {
 if p.Workspace {
<input type="hidden" name="workspace_tab" value={p.OrderTab}/><input type="hidden" name="focus" value={p.Focus}/>
}

 if p.Tab=="setup" {
 <input type="hidden" name="setup_context" value={p.SetupContext.Encode()}/>
 }
	<input type="hidden" name="csrf_token" value={ p.CSRFToken }/><input type="hidden" name="order_number" value={ p.Number }/><input type="hidden" name="request_key" value={ p.Key }/>
	if action!="" && action!="resolve_case" {
		<input type="hidden" name="action" value={ action }/>
	}
}
