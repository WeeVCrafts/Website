package components

import (
 "fmt"
 domain "github.com/wecratfs/commerce/internal/domain/commerce"
 "github.com/wecratfs/commerce/internal/web/viewmodels"
)

templ CommerceSetupWorkspace(p viewmodels.CommerceSetupPage) {
 <section class="commerce-workspace">
 if p.Actor.Role=="super_admin" {
  <nav aria-label="Breadcrumb"><a href="/super-admin/fulfillment">Fulfillment</a> / <a href="/super-admin/fulfillment/reviews">Setup review</a></nav>
  if p.Selected==nil {
   if p.Confirmations {
    <h1>Seller confirmations</h1><p>Business and product details sellers confirmed from their records.</p>
    <a href="/super-admin/fulfillment/reviews">Open review queue</a>
   } else {
    <h1>Seller setup review</h1><p>Review submitted business and tax details before clearing their checkout hold.</p>
    <a href="/super-admin/fulfillment/reviews?history=confirmed">View seller confirmations</a>
   }
   @CommerceSetupMessages(p)
   @CommerceMatchingTaxGroups(p)
   @CommerceSubmissionList(p)
  } else {
   <h1>Review seller {p.Kind} details</h1><p>Seller: <strong>{p.Selected.Seller}</strong> · {p.Selected.Product}</p>
   if p.Selected.Status=="submitted" || p.Selected.Status=="changes_requested" {
    <p class="commerce-notice">New checkout for the affected seller or option is paused while these changes are reviewed.</p>
   }
   @CommerceSetupMessages(p)
   <section class="commerce-panel">
    <p>Status <strong>{commerceSetupStatus(p.Selected.Status)}</strong></p>
    if p.Selected.SubmittedAt!=nil {
     <p>Recorded on {commerceDate(*p.Selected.SubmittedAt)}.</p>
    }
    <table class="ui-table commerce-review-table"><thead><tr><th scope="col">Field</th><th scope="col">Current saved details</th><th scope="col">Submitted details</th></tr></thead><tbody>
    for _,row:=range commerceReviewRows(p) {
     <tr><th scope="row">{row.Label}</th><td data-label="Current saved details">{row.Current}</td><td data-label="Submitted details">{row.Submitted}
      if row.Current!=row.Submitted {
       <small>Changed</small>
      }
     </td></tr>
    }
    </tbody></table>
    <p>Invoice numbering is managed by the platform. Existing order invoices keep their recorded details.</p>
    if p.Selected.Note!="" {
     <p>Seller note: {p.Selected.Note}</p>
    }
    if p.Selected.ReviewNote!="" {
     <p>Review outcome: {p.Selected.ReviewNote}</p>
    }
    if p.Selected.Status=="submitted" {
     <form class="marketplace-form" method="post" novalidate>
      <input type="hidden" name="csrf_token" value={p.CSRFToken}/><input type="hidden" name="revision" value={fmt.Sprint(p.Selected.Revision)}/>
      <label for="setup-review-note">Review note</label><textarea id="setup-review-note" name="review_note" minlength="4" maxlength="1000" rows="4" required>{commerceSetupValue(p,"review_note","")}</textarea>
      <label><input type="checkbox" name="confirmed" value="yes"/> I verified these details against the seller's records. Required for approval.</label>
      <div class="commerce-actions"><button class="commerce-button" type="submit" name="decision" value="approve" data-confirm="Approve these verified details and clear their review hold? Other checkout checks still apply.">Approve verified details</button><button class="commerce-button secondary" type="submit" name="decision" value="changes">Request changes</button><a href="/super-admin/fulfillment/reviews">Back to review queue</a></div>
     </form>
    }
    if p.Selected.Status=="submitted" || p.Selected.Status=="changes_requested" {
     <p class="commerce-muted">Approval clears this review hold. Stock, pickup, parcel, policy and launch checks still apply.</p>
    }
   </section>
  }
 } else {
  @SellerFulfillmentTabs(true)
  <h1>Fulfillment setup</h1>
  @CommerceSetupMessages(p)
  if p.Kind=="" {
   <section class="commerce-panel">
    <h2>Shared setup for {p.Actor.Seller}</h2>
    <ul>
     <li><strong>Business details</strong> · {sellerInvoiceNext(p.Shared)}
      if p.Shared.InvoiceSubmissionID > 0 {
       <a href={templ.SafeURL(fmt.Sprintf("/seller-admin/setup?submission_id=%d",p.Shared.InvoiceSubmissionID))}>Open invoice submission</a>
      } else {
       <a href="/seller-admin/setup?kind=invoice">Open invoice details</a>
      }
     </li>
     <li><strong>Pickup location</strong> ·
      if p.Shared.PickupVerified {
       Verified
      } else {
       Super Admin needs to verify your pickup location.
      }
     </li>
     <li><strong>Packed measurements</strong> · Reuse a profile for options that ship the same way. <a href="/seller-admin/setup?kind=parcel">Manage parcel profiles</a></li>
    </ul>
   </section>
   <h2>Product options</h2><p>Review remaining measurement, tax, return classification, and inventory tasks by option.</p>
   for _,row:=range p.Rows {
    <section class="commerce-panel"><h2>{row.Product}</h2><p>{row.SKU} · Product: {commerceLabel(row.ProductStatus)}</p><p>{commerceReadinessMissing(row)}</p>
     <div class="commerce-actions"><a class="commerce-button secondary" href={templ.SafeURL(fmt.Sprintf("/seller-admin/setup?kind=tax&variant_id=%d",row.VariantID))}>Tax & return details</a><a class="commerce-button secondary" href={templ.SafeURL(fmt.Sprintf("/seller-admin/products/%d/edit",row.ProductID))}>Edit packed measurements or stock</a></div>
     if row.ReviewID>0 {
      <p><a href={templ.SafeURL(fmt.Sprintf("/seller-admin/setup?submission_id=%d",row.ReviewID))}>{commerceLabel(row.ReviewStatus)} — view the submission</a></p>
     }
    </section>
   }
   if p.Next>0 {
    <a href={templ.SafeURL(fmt.Sprintf("/seller-admin/setup?before=%d",p.Next))}>More product options</a>
   }
   @CommerceSubmissionList(p)
  } else {
   <div class="commerce-setup-grid"><aside class="commerce-panel" aria-label="Setup progress"><ol class="commerce-progress">
    for _,step:=range commerceSetupSteps(p) {
     <li><strong>{step.Label}</strong><span>{step.State}</span></li>
    }
   </ol></aside><section class="commerce-panel">
    if p.Kind=="invoice" {
     <h2>Business details</h2><p>These details apply to all your product options and are saved with each new order.</p>
    } else {
     <h2>Tax & return details</h2><p>Confirm the tax code, rate and return category for this product option.</p>
    }
    if p.Selected!=nil {
     <p>Status <strong>{commerceSetupStatus(p.Selected.Status)}</strong></p>
     if p.Selected.ReviewNote!="" {
      <p class="commerce-notice">Review note: {p.Selected.ReviewNote}</p>
     }
    }
    if commerceSetupReadOnly(p) {
     if p.Selected.Status=="submitted" {
      <p>Super Admin is reviewing these details.</p>
     } else if p.Selected.Status=="attested" && p.Selected.SubmittedAt!=nil {
      <p>You confirmed this version for new orders on {commerceDate(*p.Selected.SubmittedAt)}.</p>
     }
     <dl class="commerce-financial">
      for _,row:=range commerceReviewRows(p) {
       <div><dt>{row.Label}</dt><dd>{row.Submitted}</dd></div>
      }
     </dl>
     <a class="commerce-button secondary" href="/seller-admin/setup">Back to setup checklist</a>
     if p.Selected.Status=="approved" || p.Selected.Status=="attested" {
      <a href={templ.SafeURL(fmt.Sprintf("/seller-admin/setup?kind=%s&variant_id=%d",p.Kind,p.VariantID))}>Prepare another change</a>
     }
    } else {
     @CommerceSellerSetupForm(p)
    }
   </section></div>
  }
 }
 </section>
}

templ CommerceSetupMessages(p viewmodels.CommerceSetupPage) {
 if p.Error!="" {
  <div class="ui-error-summary" role="alert" tabindex="-1"><p>{p.Error}</p><ul>
   for key,message:=range p.Errors {
    <li><a href={templ.SafeURL("#setup-"+key)}>{message}</a></li>
   }
  </ul></div>
 }
 if p.Notice!="" {
  <p class="commerce-notice" role="status">{p.Notice}</p>
 }
}

templ CommerceSellerSetupForm(p viewmodels.CommerceSetupPage) {
 <form class="marketplace-form" data-fulfillment-setup-action={"commerce-seller-"+p.Kind} method="post" action="/seller-admin/setup" novalidate>
  <input type="hidden" name="csrf_token" value={p.CSRFToken}/><input type="hidden" name="kind" value={p.Kind}/><input type="hidden" name="variant_id" value={fmt.Sprint(p.VariantID)}/>
  <input type="hidden" id="setup-profile_revision" name="profile_revision" value={fmt.Sprint(p.Confirmation.ProfileRevision)}/>
  if p.Selected!=nil {
   <input type="hidden" name="submission_id" value={fmt.Sprint(p.Selected.ID)}/><input type="hidden" name="revision" value={fmt.Sprint(p.Selected.Revision)}/>
  }
  if p.Kind=="invoice" {
   @CommerceSetupInput(p,"legal_name","Legal name",p.Data.LegalName,"",160)
   <label for="setup-address">Registered invoice address</label><textarea id="setup-address" name="address" minlength="10" maxlength="1000" rows="4" aria-invalid={commerceInvalid(p,"address")} aria-describedby="setup-address-error" required>{p.Data.Address}</textarea><small id="setup-address-error">{commerceSetupError(p,"address")}</small>
   <label for="setup-state_code">State or union territory</label><select id="setup-state_code" name="state_code" required aria-invalid={commerceInvalid(p,"state_code")} aria-describedby="setup-state_code-error"><option value="">Choose a state</option>
    for _,state:=range domain.IndianStates() {
     <option value={state.Code} selected?={p.Data.StateCode==state.Code}>{state.Name}</option>
    }
   </select><small id="setup-state_code-error">{commerceSetupError(p,"state_code")}</small>
   <label for="setup-registration">GST registration</label><select id="setup-registration" name="registration" required aria-invalid={commerceInvalid(p,"registration")} aria-describedby="setup-registration-error"><option value="">Choose registration status</option><option value="unregistered" selected?={p.Data.Registration=="unregistered"}>Unregistered</option><option value="registered" selected?={p.Data.Registration=="registered"}>Registered</option></select><small id="setup-registration-error">{commerceSetupError(p,"registration")}</small>
   <label for="setup-gstin">GSTIN — registered sellers only</label><input id="setup-gstin" name="gstin" value={p.Data.GSTIN} maxlength="15" aria-invalid={commerceInvalid(p,"gstin")} aria-describedby="setup-gstin-error"/><small id="setup-gstin-error">{commerceSetupError(p,"gstin")}</small>
  } else {
   @CommerceSetupInput(p,"hsn","HSN (4–8 digits)",p.Data.HSN,"[0-9]{4,8}",8)
   @CommerceSetupInput(p,"tax_rate_percent","Tax rate (%)",commerceSetupValue(p,"tax_rate_percent",commerceDraftPercent(p.Data)),"[0-9]{1,3}([.][0-9]{1,2})?",6)
   <label for="setup-return_class">Return category</label><select id="setup-return_class" name="return_class" required aria-invalid={commerceInvalid(p,"return_class")} aria-describedby="setup-return_class-error"><option value="">Choose category</option><option value="textile_craft" selected?={p.Data.ReturnClass=="textile_craft"}>Textiles and crafts</option><option value="fragile_art" selected?={p.Data.ReturnClass=="fragile_art"}>Fragile artwork</option></select><small id="setup-return_class-error">{commerceSetupError(p,"return_class")}</small>
  }
  if p.Confirmation.ReviewRequired {
   <p class="commerce-muted">Super Admin needs to review the corrections before the checkout hold can be cleared.</p>
   <label for="setup-note">Note for Super Admin (optional)</label><textarea id="setup-note" name="note" maxlength="1000" rows="3">{commerceSetupValue(p,"note",func()string{if p.Selected!=nil{return p.Selected.Note};return ""}())}</textarea>
  } else if p.Kind=="tax" && p.Confirmation.Registration=="" {
   <p>Confirm your <a href="/seller-admin/setup?kind=invoice">business details</a> to use this tax profile. You can save a draft now.</p>
  } else {
   <label for="setup-acknowledged"><input id="setup-acknowledged" type="checkbox" name="acknowledged" value="yes" checked?={commerceSetupValue(p,"acknowledged","")=="yes"} required aria-invalid={commerceInvalid(p,"acknowledged")} aria-describedby="setup-acknowledged-error"/> These details match my business records.</label><small id="setup-acknowledged-error">{commerceSetupError(p,"acknowledged")}</small>
  }
  <div class="commerce-actions">
   <a href="/seller-admin/setup">Back</a><button class="commerce-button secondary" type="submit" name="intent" value="draft" formnovalidate>Save draft</button>
   if p.Confirmation.ReviewRequired {
    <button class="commerce-button" type="submit" name="intent" value="submit" data-confirm="Send these corrections to Super Admin for review?">Submit for review</button>
   } else if p.Kind=="invoice" || p.Confirmation.Registration!="" {
    <button class="commerce-button" type="submit" name="intent" value="confirm">Confirm details</button>
   }
  </div>
 </form>
}

templ CommerceSetupInput(p viewmodels.CommerceSetupPage,key,label,value,pattern string,max int) {
 <label for={"setup-"+key}>{label}</label><input id={"setup-"+key} name={key} value={value} if pattern!="" {
pattern={pattern}
} maxlength={fmt.Sprint(max)} required aria-invalid={commerceInvalid(p,key)} aria-describedby={"setup-"+key+"-error"}/><small id={"setup-"+key+"-error"}>{commerceSetupError(p,key)}</small>
}

templ CommerceSubmissionList(p viewmodels.CommerceSetupPage) {
 <section class="commerce-panel"><h2>Saved records</h2>
  if len(p.Submissions)==0 {
   <p>No submissions in this view.</p>
  }
  for _,s:=range p.Submissions {
   <article class="commerce-support-row"><h3>{s.Seller} · {s.Product}</h3><p>{commerceLabel(s.Kind)} · {commerceSetupStatus(s.Status)} · {commerceDate(s.CreatedAt)}</p>
    if p.Actor.Role=="super_admin" {
     <a class="commerce-button secondary" href={templ.SafeURL(fmt.Sprintf("/super-admin/fulfillment/reviews/%d",s.ID))}>
      if p.Confirmations {
       View confirmation
      } else {
       Review submission
      }
     </a>
    } else {
     <a href={templ.SafeURL(fmt.Sprintf("/seller-admin/setup?submission_id=%d",s.ID))}>View submission</a>
    }
   </article>
  }
  if p.NextReview>0 {
   if p.Actor.Role=="seller" {
    <a href={templ.SafeURL(fmt.Sprintf("/seller-admin/setup?review_before=%d",p.NextReview))}>More saved records</a>
   } else if p.Confirmations {
    <a href={templ.SafeURL(fmt.Sprintf("/super-admin/fulfillment/reviews?history=confirmed&review_before=%d",p.NextReview))}>More confirmations</a>
   } else {
    <a href={templ.SafeURL(fmt.Sprintf("/super-admin/fulfillment/reviews?review_before=%d",p.NextReview))}>More submissions</a>
   }
  }
 </section>
}

templ CommerceMatchingTaxGroups(p viewmodels.CommerceSetupPage) {
 for _, group := range matchingTaxGroups(p.Submissions) {
  <section class="commerce-panel">
   <h2>Review matching tax submissions</h2>
   <p>{group.Submissions[0].Seller} · HSN {group.Details.HSN} · {commercePercent(group.Details.RateBasisPoints)}% · {commerceLabel(group.Details.ReturnClass)}</p>
   <ul>
    for _, submission := range group.Submissions {
     <li><a href={templ.SafeURL(fmt.Sprintf("/super-admin/fulfillment/reviews/%d",submission.ID))}>{submission.Product} · Submission #{fmt.Sprint(submission.ID)}</a></li>
    }
   </ul>
   <form class="marketplace-form" method="post">
    <input type="hidden" name="csrf_token" value={p.CSRFToken}/>
    <input type="hidden" name="decision" value="approve_matching_tax"/>
    for _, submission := range group.Submissions {
     <input type="hidden" name="review" value={fmt.Sprintf("%d:%d",submission.ID,submission.Revision)}/>
    }
    <label>Verification note<textarea name="review_note" minlength="4" maxlength="1000" rows="3" required></textarea></label>
    <label><input type="checkbox" name="confirmed" value="yes" required/>I verified these details for every listed option.</label>
    <button type="submit">Approve matching submissions</button>
   </form>
  </section>
 }
}
