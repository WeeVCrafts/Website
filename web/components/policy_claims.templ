package components

import "fmt"
import "strings"
import "github.com/wecratfs/commerce/internal/web/viewmodels"

templ MarketplacePolicyControls(p viewmodels.MarketplacePage) {
	if p.Role=="customer" && p.Number=="" {
		<section class="utility-card"><h2>Your store credit</h2><p>Available: INR {fmt.Sprintf("%.2f",float64(p.CreditAvailableCents)/100)}</p><p>Account-bound credit can be used partly or fully at checkout. Any remainder is paid through Razorpay.</p>
			for _,g:=range p.CreditGrants {
<p>Credit #{fmt.Sprint(g.ID)}: INR {fmt.Sprintf("%.2f",float64(g.RemainingCents)/100)} remaining · expires {g.ExpiresAt.Format("2 Jan 2006")}</p>
}
		</section>
	}
	if p.Role=="super_admin" && p.Number=="" && p.Setup!=nil {
		<section class="admin-panel"><h2>Policy and live shipping readiness</h2>

<p>Shipping mode: <strong>{p.Policy.ShippingMode}</strong>. Pilot order: {fmt.Sprint(p.Policy.PilotOrderID)}. New bookings also require the application booking switch.</p>
			if p.Policy.PublishedAt==nil {
				<form data-fulfillment-setup-action="publish_policy" class="marketplace-form" method="post" action={templ.SafeURL(p.ActionPath)} novalidate>
@MarketplaceFields(p,"publish_policy") @SetupErrors(p,"publish_policy")
<p>Publish the reviewed returns, replacements, authenticity and account-credit policy. Existing orders keep their previous terms.</p><label>Publication reason<input id="publish_policy_reason" value={p.FormValue("publish_policy","reason","")} name="reason" minlength="10" maxlength="1000" required/></label><label><input id="publish_policy_confirmed" name="confirmed" checked?={p.FormValue("publish_policy","confirmed","")=="yes"} value="yes" type="checkbox" required/>I confirm this policy and its operational workflows are ready</label><button type="submit">Publish policy</button></form>
			} else {
<p>Policy {p.Policy.Version} published {p.Policy.PublishedAt.Format("2 Jan 2006")}. <a href="/returns-replacements-authenticity">Read published policy</a></p>
}
			<form data-fulfillment-setup-action="classify_variant" class="marketplace-form" method="post" action={templ.SafeURL(p.ActionPath)} novalidate>
@MarketplaceFields(p,"classify_variant") @SetupErrors(p,"classify_variant")
<h3>Verify product return classification</h3><input type="hidden" name="variant_id" value={fmt.Sprint(p.Setup.Query.VariantID)}/><p>Applies to the product option selected above.</p><fieldset disabled?={p.Setup.Query.VariantID==0}><label>Classification<select name="return_class"><option value="">Choose the verified category</option><option value="textile_craft" selected?={p.FormValue("classify_variant","return_class",p.Setup.ReturnClass)=="textile_craft"}>Eligible textile or craft</option><option value="fragile_art" selected?={p.FormValue("classify_variant","return_class",p.Setup.ReturnClass)=="fragile_art"}>Fragile fine art, painting or sculpture</option></select></label><label><input type="checkbox" id="classify_variant_confirmed" name="confirmed" checked?={p.FormValue("classify_variant","confirmed","")=="yes"} value="yes" required/>I verified the product category</label><button type="submit">Save classification</button></fieldset></form>
			<form class="marketplace-form" method="get" action={templ.SafeURL(p.Root)}><input type="hidden" name="tab" value="setup"/><input type="hidden" name="seller_id" value={fmt.Sprint(p.Setup.Query.SellerID)}/><input type="hidden" name="variant_id" value={fmt.Sprint(p.Setup.Query.VariantID)}/><label>Find pilot customer<input name="customer_q" value={p.Setup.Query.CustomerSearch} maxlength="120" placeholder="Customer name or ID"/></label><button type="submit">Find customers</button></form>
            if p.Setup.NextCustomer>0 {
<a href={templ.SafeURL(p.SetupURL("customer_before",fmt.Sprint(p.Setup.NextCustomer)))}>More customers</a>
}
            if p.Setup.Query.CustomerBefore>0 {
<a href={templ.SafeURL(p.SetupURL("customer_before",""))}>First customer page</a>
}
			<form data-fulfillment-setup-action="configure_pilot" class="marketplace-form" method="post" action={templ.SafeURL(p.ActionPath)} novalidate>
@MarketplaceFields(p,"configure_pilot") @SetupErrors(p,"configure_pilot")
<h3>One genuine order pilot</h3><p>Requires a verified seller invoice/tax profile, pickup, real variant measurements, published policy and live booking configuration. Only one item and one pilot order are permitted.</p><label>Customer account<select name="customer_id" required>@SetupOptions(p.Setup.Customers,setupFormID(p,"configure_pilot","customer_id"),"Choose an active customer")</select></label><input type="hidden" name="variant_id" value={fmt.Sprint(p.Setup.Query.VariantID)}/><p>The pilot uses the product option selected above.</p><label>Activation reason<input id="configure_pilot_reason" value={p.FormValue("configure_pilot","reason","")} name="reason" minlength="10" maxlength="1000" required/></label><label><input type="checkbox" id="configure_pilot_confirmed" name="confirmed" checked?={p.FormValue("configure_pilot","confirmed","")=="yes"} value="yes" required/>Wallet is funded and this customer and product are ready for a genuine shipment</label><button type="submit" disabled?={p.Setup.Query.VariantID==0}>Enable one-order pilot</button></form>
			<form class="marketplace-form" method="get" action={templ.SafeURL(p.Root)}><input type="hidden" name="tab" value="setup"/><input type="hidden" name="seller_id" value={fmt.Sprint(p.Setup.Query.SellerID)}/><input type="hidden" name="variant_id" value={fmt.Sprint(p.Setup.Query.VariantID)}/><label>Find ready launch options<input name="launch_q" value={p.Setup.Query.LaunchSearch} maxlength="120" placeholder="Product, SKU or seller"/></label><button type="submit">Find ready options</button></form>
            if len(p.Setup.LaunchVariants)==0 {
<p>No product options match complete checkout readiness and this search.</p>
}
            if p.Setup.NextLaunch>0 {
<a href={templ.SafeURL(p.SetupURL("launch_before",fmt.Sprint(p.Setup.NextLaunch)))}>More ready options</a>
}
            if p.Setup.Query.LaunchBefore>0 {
<a href={templ.SafeURL(p.SetupURL("launch_before",""))}>First ready-options page</a>
}
			if p.Policy.PilotOrderID > 0 {
				<form data-fulfillment-setup-action="configure_live_catalog" class="marketplace-form" method="post" action={ templ.SafeURL(p.ActionPath)
}>
					@MarketplaceFields(p, "configure_live_catalog") @SetupErrors(p,"configure_live_catalog")
					<h3>Two-variant launch catalog</h3>
					<p>Choose one ready variant per seller after the paid pilot has been delivered through Shiprocket.</p>
					<label>First ready product option<select name="variant_id" required>@SetupOptions(p.Setup.LaunchVariants,setupFormID(p,"configure_live_catalog","variant_id"),"Choose the first seller’s ready option")</select></label>
					<label>Second ready product option<select name="second_variant_id" required>@SetupOptions(p.Setup.LaunchVariants,setupFormID(p,"configure_live_catalog","second_variant_id"),"Choose a different seller’s ready option")</select></label>
					<label>Launch reason<input id="configure_live_catalog_reason" value={p.FormValue("configure_live_catalog","reason","")} name="reason" minlength="10" maxlength="1000" required/></label>
					<label><input id="configure_live_catalog_confirmed" name="confirmed" checked?={p.FormValue("configure_live_catalog","confirmed","")=="yes"} value="yes" type="checkbox" required/>I verified the recovery drill, two-seller rehearsal and launch notifications</label>
					<button type="submit">Save and activate launch catalog</button>
				</form>
			}
			<form data-fulfillment-setup-action="pause_shipping" class="marketplace-form" method="post" action={templ.SafeURL(p.ActionPath)} novalidate>
@MarketplaceFields(p,"pause_shipping") @SetupErrors(p,"pause_shipping")
<label>Pause reason<input id="pause_shipping_reason" value={p.FormValue("pause_shipping","reason","")} name="reason" minlength="10" maxlength="1000" required/></label><label><input type="checkbox" id="pause_shipping_confirmed" name="confirmed" checked?={p.FormValue("pause_shipping","confirmed","")=="yes"} value="yes" required/>Pause new purchases and bookings; continue reconciliation</label><button type="submit">Pause new shipping</button></form>
		</section>
	}
}

templ MarketplacePolicyClaims(p viewmodels.MarketplacePage) {
	if p.NewReturnPolicy {
		if p.Role=="customer" {
			for _,item:=range p.Lines {
				if item.CanReturn {
					<form class="marketplace-form" method="post" action={templ.SafeURL(p.ActionPath)} novalidate>
@MarketplaceFields(p,"submit_claim")
<h3>Request help: {item.Name}</h3><input type="hidden" name="item_id" value={fmt.Sprint(item.ID)}/><label>Delivered package<select name="package_id" required>
for _,pkg:=range p.Packages {
 if pkg.Status=="delivered" && !strings.HasPrefix(pkg.Reference,"WC-RPL-") {
  for _,piece:=range pkg.Items {
   if piece.SKU==item.SKU {
<option value={fmt.Sprint(pkg.ID)}>Package #{fmt.Sprint(pkg.ID)} · {pkg.Courier} · {pkg.AWB}</option>
   }
  }
 }
}
</select></label><label>Reason for claim<select name="claim_kind"><option value="damage">Transit damage</option><option value="defect">Manufacturing or weaving defect</option><option value="wrong_item">Wrong item or design</option><option value="change_of_mind">Change of mind (non-handmade items only)</option></select></label><label>Quantity<input type="number" name="quantity" min="1" max={fmt.Sprint(item.Quantity-item.Cancelled)} value="1" required/></label><label>What happened?<textarea name="reason" minlength="10" maxlength="1000" style="resize:none" rows="4" required></textarea></label><p>Report damaged, defective, incorrect or incomplete products preferably within 48 hours of delivery. Handmade crafts and handlooms are generally not eligible for change-of-mind returns. Upload unboxing photos or video evidence after saving this claim.</p><button type="submit">Submit claim for review</button></form>
				}
			}
		}
	}
	for _,c:=range p.Claims {
		<article class="utility-card"><h3>Claim #{fmt.Sprint(c.ID)} — {strings.ReplaceAll(c.Kind,"_"," ")}</h3><p>Status: {strings.ReplaceAll(c.Status,"_"," ")} · Resolution: {c.Resolution}</p><p>{c.Reason}</p><p>Eligible item amount: INR {fmt.Sprintf("%.2f",float64(c.AmountCents)/100)} · Return fee: INR {fmt.Sprintf("%.2f",float64(c.FeeCents)/100)}</p>
			if c.ReturnAWB!="" {
<p>Reverse shipment: {c.ReturnCourier} · {c.ReturnAWB} · {c.ReturnStatus}</p>
}
			if c.ReplacementPackageID>0 {
<p>Replacement package #{fmt.Sprint(c.ReplacementPackageID)} appears in package tracking below.</p>
}
			<ul>
for _,e:=range c.Evidence {
<li><a href={templ.SafeURL(fmt.Sprintf("%s?order=%s&evidence=%d",p.Root,p.Number,e.ID))}>{e.Filename}</a></li>
}
</ul>
			if p.Role=="customer" && c.Status!="completed" && c.Status!="rejected" {
				<form class="marketplace-form" method="post" action={templ.SafeURL(p.ActionPath)} enctype="multipart/form-data" novalidate>
@MarketplaceFields(p,"upload_claim_evidence")
<input type="hidden" name="case_id" value={fmt.Sprint(c.ID)}/><label>Unboxing video or photo<input type="file" name="evidence" accept="video/mp4,video/quicktime,video/webm,image/jpeg,image/png,image/webp" required/></label><p>One video up to 200 MB, or one photo up to 10 MB. Evidence is private to you and company staff unless they explicitly share it with your seller.</p><button type="submit">Upload private evidence</button></form>
			}
			if p.Role=="admin" || p.Role=="super_admin" {
				if c.Status!="completed" && c.Status!="rejected" {
					<form class="marketplace-form" method="post" action={templ.SafeURL(p.ActionPath)} novalidate>
@MarketplaceFields(p,"claim_status")
<input name="case_id" type="hidden" value={fmt.Sprint(c.ID)}/><label>Next status<select name="status"><option value="approved">Approve resolution (Super Admin)</option><option value="pickup_pending">Arrange reverse pickup</option><option value="received">Confirm carrier-verified receipt</option><option value="inspected">Record inspection</option><option value="completed">Complete credit/refund request (Super Admin)</option><option value="rejected">Reject with reason</option></select></label><label>Review or inspection findings<textarea name="reason" minlength="10" maxlength="1000" style="resize:none" required></textarea></label><label>Alternative evidence exception<textarea name="evidence_exception" maxlength="1000" style="resize:none"></textarea></label><label>Return parcel weight (grams)<input name="weight_grams" type="number" min="100" max="50000"/></label><label>Return length (cm)<input name="length_cm" type="number" min="1" max="200"/></label><label>Return width (cm)<input name="width_cm" type="number" min="1" max="200"/></label><label>Return height (cm)<input name="height_cm" type="number" min="1" max="200"/></label><label><input type="checkbox" name="inspection_passed" value="yes"/>Inspection confirms eligibility and condition for this resolution</label><label><input type="checkbox" name="restock" value="yes"/>Inspection confirms returned units can be restocked</label><label><input type="checkbox" name="confirmed" value="yes" required/>I verified this transition and its consequences</label><button type="submit">Record claim decision</button></form>
					<form class="marketplace-form" method="post" action={templ.SafeURL(p.ActionPath)} novalidate>
@MarketplaceFields(p,"share_claim_evidence")
<input name="case_id" type="hidden" value={fmt.Sprint(c.ID)}/><label>Reason to share with the order's seller<input name="reason" minlength="10" maxlength="1000" required/></label><button type="submit">Share claim evidence with seller</button></form>
				}
			}
			if p.Role=="seller" && c.Status=="inspected" && c.Resolution=="replacement" && c.ReplacementPackageID==0 {
				<form class="marketplace-form" method="post" action={templ.SafeURL(p.ActionPath)} novalidate>
@MarketplaceFields(p,"prepare_replacement")
<input name="case_id" type="hidden" value={fmt.Sprint(c.ID)}/><input name="seller_id" type="hidden" value={fmt.Sprint(c.SellerID)}/><label>Packed weight (grams)<input name="weight_grams" type="number" min="100" max="50000" required/></label><label>Length (cm)<input name="length_cm" type="number" min="1" max="200" required/></label><label>Width (cm)<input name="width_cm" type="number" min="1" max="200" required/></label><label>Height (cm)<input name="height_cm" type="number" min="1" max="200" required/></label><label>Pre-dispatch quality-check evidence<input name="qc_evidence" minlength="10" maxlength="1000" required/></label><label>Preparation note<input name="reason" minlength="10" maxlength="1000" required/></label><label><input type="checkbox" name="confirmed" value="yes" required/>I confirm the actual parcel, quality check and free replacement dispatch</label><button type="submit">Confirm and ship free replacement</button></form>
			}
		</article>
	}
}
