package components

import "fmt"
import "github.com/wecratfs/commerce/internal/web/viewmodels"

templ MarketplaceReadiness(p viewmodels.MarketplacePage) {
	<p>Only measured, classified products with verified seller, pickup and tax details can enter the pilot. Missing data stays visible here.</p>
	<div role="region" aria-label="Product shipping readiness" tabindex="0" style="overflow-x:auto">
		<table><caption>Active product options — up to 50 per page</caption><thead><tr><th scope="col">Product option</th><th scope="col">Seller</th><th scope="col">Measurements</th><th scope="col">Required setup</th></tr></thead><tbody>
			for _,r:=range p.Readiness {
				<tr><th scope="row">{r.Product}<br/>{r.SKU}<br/>Variant #{fmt.Sprint(r.VariantID)}</th><td>{r.Seller}<br/>Seller #{fmt.Sprint(r.SellerID)}</td><td>{fmt.Sprintf("%d g · %d × %d × %d cm",r.WeightGrams,r.LengthCM,r.WidthCM,r.HeightCM)}</td><td>
					if !r.PickupReady {
<p>Pickup verification missing</p>
}
					if !r.InvoiceReady {
<p>Seller invoice details missing</p>
}
					if !r.TaxReady {
<p>Product tax verification missing</p>
}
					if !r.Classified {
<p>Return classification missing</p>
}
					if r.WeightGrams<100 || r.LengthCM<1 || r.WidthCM<1 || r.HeightCM<1 {
<p>Actual measurements required</p>
}
					if r.PickupReady && r.InvoiceReady && r.TaxReady && r.Classified && r.WeightGrams>=100 && r.LengthCM>0 && r.WidthCM>0 && r.HeightCM>0 {
<p>Product setup complete</p>
}
				</td></tr>
			}
		</tbody></table>
	</div>
	if p.NextSetupID>0 {
<a href={templ.SafeURL(fmt.Sprintf("%s?setup_before=%d",p.Root,p.NextSetupID))}>More product options</a>
}
}
