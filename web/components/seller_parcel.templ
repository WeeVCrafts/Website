package components

import (
	"fmt"
	"slices"

	"github.com/wecratfs/commerce/internal/ports"
	"github.com/wecratfs/commerce/internal/web/viewmodels"
)

const parcelSetupPath = "/seller-admin/setup?kind=parcel"

templ SellerFulfillmentTabs(setup bool) {
	<nav class="commerce-tabs" aria-label="Seller fulfillment">
		<a href="/seller-admin/fulfillment?tab=operations" aria-current={tabCurrent(!setup)}>Operations</a>
		<a href="/seller-admin/fulfillment?tab=setup" aria-current={tabCurrent(setup)}>Setup</a>
	</nav>
}

templ SellerParcelWorkspace(p viewmodels.SellerParcelPage) {
	<section class="commerce-workspace">
		@SellerFulfillmentTabs(true)
		<a href="/seller-admin/setup">Back to fulfillment setup</a>
		<h1>Parcel profiles</h1>
		<p>Measure a packed product once and reuse its profile for options that ship with the same weight and box size.</p>
		if p.Error != "" {
			<p class="ui-error-summary" role="alert" tabindex="-1" autofocus>{p.Error}</p>
		}
		if p.Notice != "" {
			<p class="commerce-notice" role="status">{p.Notice}</p>
		}
		if p.Preview != nil {
			@SellerParcelReview(p)
		} else {
			<section class="commerce-panel">
				<h2>1. Create a profile</h2>
				<form class="marketplace-form" method="post" data-native-submit action={templ.SafeURL(parcelSetupPath)}>
					<input type="hidden" name="csrf_token" value={p.CSRFToken}/>
					<input type="hidden" name="phase" value="create"/>
					<label>Profile name<input name="profile_name" maxlength="80" value={p.Value("profile_name")} required/></label>
					<div class="guided-field-grid">
						@SellerParcelMeasurement(p, "weight_grams", "Packed weight (g)", "100", "50000")
						@SellerParcelMeasurement(p, "length_cm", "Length (cm)", "1", "200")
						@SellerParcelMeasurement(p, "width_cm", "Width (cm)", "1", "200")
						@SellerParcelMeasurement(p, "height_cm", "Height (cm)", "1", "200")
					</div>
					<button type="submit">Create profile</button>
				</form>
			</section>
			if len(p.Setup.Profiles) > 0 {
				<section class="commerce-panel">
					<h2>2. Choose a default profile</h2>
					<p>The default applies to options you assign to follow it. Create a new profile if the measurements change, then preview the reassignment.</p>
					<form class="marketplace-form" method="post" data-native-submit action={templ.SafeURL(parcelSetupPath)}>
						@SellerParcelPreviewFields(p.CSRFToken, "default")
						<label>Seller default<select name="profile" required>
							<option value="">Choose a profile</option>
							for _, profile := range p.Setup.Profiles {
								<option value={fmt.Sprint(profile.ID)} selected?={profile.ID == p.Setup.DefaultID}>{sellerParcelLabel(profile)}</option>
							}
						</select></label>
						<button type="submit">Preview default change</button>
					</form>
				</section>
				<section class="commerce-panel">
					<h2>3. Assign profiles to product options</h2>
					<p>Choose the options that share these packed measurements. Existing measured overrides keep their own values.</p>
					<form class="marketplace-form" method="post" data-native-submit action={templ.SafeURL(parcelSetupPath)}>
						@SellerParcelPreviewFields(p.CSRFToken, "assign")
						<label>Use measurements from<select name="profile" required>
							<option value="">Choose a profile</option>
							if p.Setup.DefaultID > 0 {
								<option value="default" selected?={p.Value("profile") == "default"}>Follow seller default</option>
							}
							for _, profile := range p.Setup.Profiles {
								<option value={fmt.Sprint(profile.ID)} selected?={p.Value("profile") == fmt.Sprint(profile.ID)}>{sellerParcelLabel(profile)}</option>
							}
							<option value="none" selected?={p.Value("profile") == "none"}>Clear profile assignment</option>
						</select></label>
						<fieldset>
							<legend>Product options on this page</legend>
							for _, option := range p.Setup.Options {
								<label><input name="option_id" type="checkbox" value={fmt.Sprint(option.ID)} disabled?={option.Measured} checked?={slices.Contains(p.Values["option_id"],fmt.Sprint(option.ID))}/>{option.Product} · {option.SKU} <small>{option.Source}</small></label>
							}
							if len(p.Setup.Options) == 0 {
								<p>Add an active product option to assign it a parcel profile.</p>
							}
						</fieldset>
						<button type="submit">Preview assignments</button>
					</form>
					if p.Setup.Next > 0 {
						<a href={templ.SafeURL(fmt.Sprintf("%s&before=%d",parcelSetupPath,p.Setup.Next))}>More product options</a>
					}
				</section>
			}
		}
	</section>
}

templ SellerParcelPreviewFields(csrf, action string) {
	<input type="hidden" name="csrf_token" value={csrf}/>
	<input type="hidden" name="action" value={action}/>
	<input type="hidden" name="phase" value="preview"/>
}

templ SellerParcelMeasurement(p viewmodels.SellerParcelPage, name, label, min, max string) {
	<label>{label}<input type="number" name={name} min={min} max={max} step="1" inputmode="numeric" value={p.Value(name)} required/></label>
}

templ SellerParcelReview(p viewmodels.SellerParcelPage) {
	<section class="commerce-panel">
		<h2 tabindex="-1" autofocus>Review the change</h2>
		if p.Preview.Profile.ID > 0 {
			<p>{sellerParcelLabel(p.Preview.Profile)}</p>
		} else {
			<p>Clear the profile assignment for these options. Checkout requires valid packed measurements.</p>
		}
		if len(p.Preview.Options) == 0 {
			<p>No current product options follow the seller default.</p>
		} else {
			<ul>
				for _, option := range p.Preview.Options {
					<li>{option.Product} · {option.SKU} <small>Current: {option.Source}</small></li>
				}
			</ul>
		}
		<form class="marketplace-form" method="post" data-native-submit action={templ.SafeURL(parcelSetupPath)}>
			<input type="hidden" name="csrf_token" value={p.CSRFToken}/>
			<input type="hidden" name="action" value={p.Preview.Change.Action}/>
			<input type="hidden" name="phase" value="save"/>
			<input type="hidden" name="profile" value={p.Value("profile")}/>
			<input type="hidden" name="preview_token" value={p.Preview.Token}/>
			for _, id := range p.Preview.Change.OptionIDs {
				<input type="hidden" name="option_id" value={fmt.Sprint(id)}/>
			}
			<div class="commerce-actions"><button type="submit">Apply change</button><a href={templ.SafeURL(parcelSetupPath)}>Back to profiles</a></div>
		</form>
	</section>
}

func sellerParcelLabel(p ports.SellerParcelProfile) string {
	return fmt.Sprintf("%s · %d g · %d × %d × %d cm", p.Name, p.WeightGrams, p.LengthCM, p.WidthCM, p.HeightCM)
}
