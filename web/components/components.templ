package components

import "github.com/wecratfs/commerce/internal/web/viewmodels"

templ Header(p viewmodels.CustomerPage) {
  <div class="preview-bar" aria-hidden="true">UI preview - sample data - no real checkout or account actions</div>
  <div class="utility-bar">
    <div class="container utility-inner"><span>Handmade Today. A Kinder Tomorrow.</span><span class="utility-links">Free shipping on orders above INR 999 <i></i> International Shipping <i></i> Support</span></div>
  </div>
  <header class="site-header" x-data="{menu:false}" @keydown.escape.window="if (menu) { menu=false; $nextTick(() => $refs.menuButton.focus()) }" @keydown.tab.window="if (menu) { const focusables = $refs.mobileMenu.querySelectorAll('a,button'); const first = focusables[0]; const last = focusables[focusables.length - 1]; if ($event.shiftKey && document.activeElement === first) { $event.preventDefault(); last.focus(); } else if (!$event.shiftKey && document.activeElement === last) { $event.preventDefault(); first.focus(); } }">
    <a class="skip-link" href="#page">Skip to content</a>
    <div class="header-main container">
      <button class="icon-button menu-toggle" type="button" x-ref="menuButton" aria-label="Open menu" aria-controls="mobile-menu" :aria-expanded="menu" @click="menu=!menu; menu ? $nextTick(() => $refs.mobileMenuFirst.focus()) : $nextTick(() => $refs.menuButton.focus())"><span class="material-symbols-outlined" aria-hidden="true">menu</span></button>
      <a class="wordmark" href="/" aria-label="WeeVCrafts home"><span class="wordmark-mark">W</span><span><strong>WeeVCrafts</strong><small>Crafted by India. Cherished Everywhere.</small></span></a>
      <a class="location" href="/account/addresses?notice=Delivery+location+opened" aria-label="Delivery location"><span class="material-symbols-outlined" aria-hidden="true">location_on</span><small>Deliver to<br/><b>Bengaluru, Karnataka</b></small></a>
      <div class="search-shell"><form class="global-search" method="get" action="/search" hx-get="/search" hx-select="#page" hx-target="#page" hx-push-url="true" hx-trigger="submit" hx-sync="this:replace" hx-indicator="#global-search-indicator"><label class="sr-only" for="global-search">Search products</label><input id="global-search" name="q" value={ p.Query } placeholder="Search for sarees, home decor, gifts and more..." autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="search-suggestions" hx-get="/ui/search-suggest" hx-target="#search-suggestions" hx-swap="innerHTML" hx-trigger="input changed delay:300ms" hx-sync="this:replace" hx-indicator="#global-search-indicator" hx-disinherit="hx-select hx-push-url" hx-push-url="false"/><button type="submit" aria-label="Search"><span class="material-symbols-outlined search-icon" aria-hidden="true">search</span><span id="global-search-indicator" class="search-indicator htmx-indicator material-symbols-outlined" aria-hidden="true">progress_activity</span></button></form><div id="search-suggestions" class="search-suggestions" role="listbox" hidden></div></div>
      <nav class="header-actions" aria-label="Account actions"><a href="/account"><span class="material-symbols-outlined" aria-hidden="true">person</span><span>Account</span></a>@WishlistAction(p)<a href="/cart" id="cart-count"><span class="material-symbols-outlined" aria-hidden="true">shopping_bag</span><span>Cart<em>{ p.CartCount }</em></span></a></nav>
    </div>
    <div class="nav-row container"><button class="mobile-menu-button" type="button" aria-label="Open categories menu" aria-controls="mobile-menu" :aria-expanded="menu" @click="menu=!menu; menu ? $nextTick(() => $refs.mobileMenuFirst.focus()) : $nextTick(() => $refs.menuButton.focus())"><span class="material-symbols-outlined" aria-hidden="true">grid_view</span> Categories</button><nav class="primary-nav" aria-label="Primary"><a href="/categories">Categories <span class="material-symbols-outlined" aria-hidden="true">expand_more</span></a><a href="/products?category=offers">Offers</a><a href="/makers/mithila-arts">Makers</a><a href="/seller">Sell on WeeVCrafts</a></nav><nav class="secondary-nav" aria-label="Secondary"><a href="/our-story">Our Story</a><a href="/orders">Track Order</a><a href="/returns">Help</a></nav></div>
    <button class="mobile-menu-backdrop" type="button" aria-label="Close mobile navigation" x-show="menu" x-cloak @click="menu=false; $nextTick(() => $refs.menuButton.focus())"></button><div id="mobile-menu" x-ref="mobileMenu" class="mobile-menu" role="menu" aria-label="Mobile navigation" x-show="menu" x-cloak @click.outside="menu=false"><a x-ref="mobileMenuFirst" role="menuitem" href="/categories">Categories</a><a role="menuitem" href="/products?category=offers">Offers</a><a role="menuitem" href="/makers/mithila-arts">Makers</a><a role="menuitem" href="/account">Account</a><a role="menuitem" href="/orders">Track Order</a><a role="menuitem" href="/returns">Help</a></div>
  </header>
}

templ WishlistAction(p viewmodels.CustomerPage) {
  <a href="/wishlist" id="wishlist-count"><span class="material-symbols-outlined" aria-hidden="true">favorite</span><span>Wishlist<em>{ p.WishlistCount }</em></span></a>
}

templ CartMutation(p viewmodels.CustomerPage) {
  @CartMutationMessage(p, "Added to cart")
}

templ CartMutationMessage(p viewmodels.CustomerPage, message string) {
  <a href="/cart" id="cart-count" hx-swap-oob="outerHTML"><span class="material-symbols-outlined" aria-hidden="true">shopping_bag</span><span>Cart<em>{ p.CartCount }</em></span></a>
  @WishlistCountMutation(p)
  <div id="ui-toast" hx-swap-oob="innerHTML" role="status">{ message }</div>
}

templ WishlistCountMutation(p viewmodels.CustomerPage) {
  <a href="/wishlist" id="wishlist-count" hx-swap-oob="outerHTML"><span class="material-symbols-outlined" aria-hidden="true">favorite</span><span>Wishlist<em>{ p.WishlistCount }</em></span></a>
}

templ RatingStars(rating string) {
  for i := 0; i < ratingStars(rating); i++ {
    <span class="material-symbols-outlined" aria-hidden="true">star</span>
  }
}

templ WishlistMutation(p viewmodels.CustomerPage, product viewmodels.Product, remove bool) {
  if !remove {
    @ProductCard(product, true)
  }
  @WishlistCountMutation(p)
  <div id="ui-toast" hx-swap-oob="innerHTML" role="status">Wishlist updated</div>
}

templ Footer(p viewmodels.CustomerPage) {
  <section class="trust-strip"><div><span class="material-symbols-outlined" aria-hidden="true">groups</span><b>Trusted by <strong>1 Lakh+</strong></b><small>happy customers</small></div><div><span class="material-symbols-outlined" aria-hidden="true">star</span><b>4.8/5</b><small>Average rating</small></div><div><span class="material-symbols-outlined" aria-hidden="true">volunteer_activism</span><b>10,000+</b><small>Artisans supported</small></div><div><span class="material-symbols-outlined" aria-hidden="true">verified_user</span><b>Secure Payments</b><small>100% safe and trusted</small></div><div><span class="material-symbols-outlined" aria-hidden="true">autorenew</span><b>Easy Returns</b><small>Hassle-free shopping</small></div><div><span class="material-symbols-outlined" aria-hidden="true">public</span><b>Global Shipping</b><small>To 50+ countries</small></div></section>
  <footer class="site-footer"><div class="container footer-grid"><div class="footer-brand"><a class="wordmark inverse" href="/"><span class="wordmark-mark">W</span><span><strong>WeeVCrafts</strong><small>Crafted by India. Cherished Everywhere.</small></span></a><p>A marketplace for Indian arts, crafts and sarees.<br/>Supporting artisans. Preserving traditions.<br/>Building a brighter, more inclusive tomorrow.</p><div class="socials"><span class="material-symbols-outlined" aria-hidden="true">photo_camera</span><span class="material-symbols-outlined" aria-hidden="true">play_circle</span><span class="material-symbols-outlined" aria-hidden="true">alternate_email</span><span class="material-symbols-outlined" aria-hidden="true">language</span></div></div><div><h3>Shop</h3><a href="/categories">All Categories</a><a href="/products?category=arts">Arts</a><a href="/products?category=crafts">Crafts</a><a href="/products?category=sarees">Sarees</a><a href="/products?category=offers">Offers</a><a href="/products">New Arrivals</a></div><div><h3>Help</h3><a href="/orders">Track Order</a><a href="/returns">Returns &amp; Refunds</a><a href="/shipping">Shipping Info</a><a href="/size-guide">Size Guide</a><a href="/faq">FAQs</a><a href="/contact">Contact Us</a></div><div><h3>About</h3><a href="/our-story">Our Story</a><a href="/makers/mithila-arts">Makers</a><a href="/sustainability">Sustainability</a><a href="/press">Press</a><a href="/careers">Careers</a><a href="/seller">Sell on WeeVCrafts</a></div><div class="newsletter"><h3>Join our community</h3><p>Get updates on new arrivals, offers and maker stories.</p><form action="/contact?notice=Newsletter+subscription+submitted" method="get"><input name="email" aria-label="Email address" placeholder="Enter your email address" type="email"/><button aria-label="Subscribe" type="submit"><span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></button></form><label><input type="checkbox"/> I agree to receive updates from WeeVCrafts</label><small>Made with care in India | A more handmade tomorrow</small></div></div><div class="container footer-bottom"><span>Copyright 2024 WeeVCrafts. All rights reserved.</span><span>Terms &amp; Conditions | Privacy Policy | Cookie Policy</span></div></footer>
}

templ ProductCard(product viewmodels.Product, showAction bool) {
  <article class="product-card" data-product={ product.Slug } data-action={ showAction }>
    <div class="product-media"><img src={ product.ImageURL } alt={ product.Name } loading="lazy" width="640" height="691" srcset={ product.ImageSrcSet } sizes="(max-width: 720px) 50vw, 320px"/><button class="heart" type="button" aria-label={ "Save " + product.Name } hx-post={ "/ui/wishlist/" + product.Slug } hx-target="closest article" hx-swap="outerHTML" hx-indicator="#ui-loading" hx-disabled-elt="this"><span class="material-symbols-outlined" aria-hidden="true">favorite</span></button><span class="badge">{ product.Badge }</span></div>
    <div class="product-copy"><h3><a href={ "/products/" + product.Slug }>{ product.Name }</a></h3><p>By { product.Seller }</p><div class="rating" aria-label={ product.Rating + " out of 5 stars" }>@RatingStars(product.Rating) <span>{ product.Rating } ({ product.Reviews })</span></div><div class="price"><strong>{ product.Price }</strong><del>{ product.CompareAt }</del>
      if product.Discount != "" {
        <mark>{ product.Discount }</mark>
      }
    </div><button class="outline-button add-button" type="button" hx-post={ "/ui/cart/" + product.Slug } hx-target="#cart-count" hx-swap="none" hx-indicator="#ui-loading" hx-disabled-elt="this"><span class="material-symbols-outlined" aria-hidden="true">shopping_bag</span> Add to Cart</button></div>
  </article>
}

templ CategoryCard(category viewmodels.Category) {
  <a class="category-card" href={ "/products?category=" + category.Slug }><img src={ category.ImageURL } alt="" loading="lazy" width="320" height="320"/><span><strong>{ category.Name }</strong><small>{ category.Description }</small><b>Explore { category.Name } <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></b></span></a>
}
