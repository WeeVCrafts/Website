package workspaces

import "github.com/wecratfs/commerce/internal/web/viewmodels"
import "github.com/wecratfs/commerce/web/assets"

templ Document(p viewmodels.WorkspacePage) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="robots" content="noindex,nofollow"/>
			<title>Choose workspace · WeeVCrafts</title>
			<link rel="stylesheet" href="/assets/css/fonts.min.css"/>
			<style>
				:root{font-family:"Inter",Arial,sans-serif;color:#222244;background:#f7f7f4;font-synthesis:none;text-rendering:optimizeLegibility}
				*{box-sizing:border-box}body{margin:0;min-height:100vh}.bar{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.15rem clamp(1.25rem,5vw,4rem);background:#fff;border-bottom:1px solid #e7e6e1}.brand{display:flex;align-items:center;gap:.7rem;color:#222244;text-decoration:none;font-weight:700;font-size:1.15rem}.brand-mark{display:grid;place-items:center;width:2.4rem;height:2.4rem;border-radius:50%;background:#e9edda;color:#526326;font-size:1.3rem}.bar-actions{display:flex;align-items:center;gap:1rem;color:#686879;font-size:.875rem}.bar-actions a{color:#222244}.bar-actions form{margin:0}.bar-actions button{border:0;background:none;color:#8b3138;text-decoration:underline;font:inherit;cursor:pointer}.wrap{width:min(100% - 2rem,56rem);margin:clamp(3rem,8vh,6rem) auto}.intro{margin-bottom:2rem}.eyebrow{margin:0 0 .6rem;color:#8b3138;font-size:.78rem;font-weight:700;letter-spacing:.13em;text-transform:uppercase}.intro h1{margin:0;font-family:"Roboto",Arial,sans-serif;font-size:clamp(2.2rem,6vw,3.6rem);font-weight:500;line-height:1.05}.intro p{max-width:38rem;margin:1rem 0 0;color:#656574;line-height:1.65}.choices{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,16rem),1fr));gap:1rem}.choice{display:flex;min-height:9rem;flex-direction:column;justify-content:space-between;padding:1.35rem;border:1px solid #e1dfd7;border-radius:1rem;background:#fff;color:#222244;text-decoration:none;transition:transform .15s ease,border-color .15s ease,box-shadow .15s ease}.choice:hover,.choice:focus-visible{transform:translateY(-2px);border-color:#8b3138;box-shadow:0 12px 28px #20204012;outline:none}.choice span{color:#8b3138;font-size:.77rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.choice strong{font-family:"Roboto",Arial,sans-serif;font-size:1.55rem;font-weight:500}.choice i{align-self:flex-end;color:#8b3138;font-style:normal;font-size:1.3rem}.empty{padding:1.5rem;border:1px solid #e1dfd7;border-radius:1rem;background:#fff;color:#656574}.footer{margin-top:2rem;color:#777786;font-size:.85rem}
				@media(max-width:480px){.bar{align-items:flex-start}.bar-actions{flex-wrap:wrap;justify-content:flex-end}.choice{min-height:7.5rem}}
				@media(prefers-reduced-motion:reduce){.choice{transition:none}}
			</style>
		<link rel="stylesheet" href={ assets.URL("css/brand.min.css") }/>
<link rel="icon" type="image/png" href="/assets/images/brand/favicon.png"/>
</head>
		<body>
			<header class="bar">
				<a class="brand" href="/"><img class="brand-mark" src="/assets/images/brand/weevcrafts-logo.png" alt="" width="36" height="36"/><span>WeeVCrafts</span></a>
				<div class="bar-actions">
					<span>{ p.DisplayName }</span>
					<form method="post" action="/logout"><input type="hidden" name="csrf_token" value={ p.CSRFToken }/><button type="submit">Sign out</button></form>
				</div>
			</header>
			<main class="wrap">
				<section class="intro"><p class="eyebrow">Your WeeVCrafts workspace</p><h1>Where would you like to go?</h1><p>Choose a workspace for this session. Each space only shows the tools your account is allowed to use.</p></section>
				if len(p.Workspaces) == 0 {
					<div class="empty" role="status"><strong>No workspace is assigned to this account.</strong><p>Ask an administrator to restore the access you need.</p></div>
				} else {
					<nav class="choices" aria-label="Available workspaces">
						for _, workspace := range p.Workspaces {
							<a class="choice" href={ workspace.Path }><span>{ workspace.Role }</span><strong>{ workspace.Label }</strong><i aria-hidden="true">→</i></a>
						}
					</nav>
				}
				<p class="footer">Handmade in India. Made to be cherished.</p>
			</main>
		</body>
	</html>
}
