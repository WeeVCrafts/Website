FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/weevcrafts-web ./cmd/web

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/weevcrafts-web /weevcrafts-web
EXPOSE 8090
USER nonroot:nonroot
ENTRYPOINT ["/weevcrafts-web"]
