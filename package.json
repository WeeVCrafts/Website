{
  "name": "weevcrafts-ui",
  "private": true,
  "scripts": {
    "assets:js": "node scripts/minify-ui-js.cjs",
    "assets:images": "node scripts/build-image-variants.cjs",
    "assets:fonts": "python scripts/build-web-fonts.py",
    "test:ui-ux": "node scripts/verify-ui-ux.cjs",
    "test:ui-ux:recovery": "node scripts/verify-ui-ux-recovery.cjs",
    "test:ui-ux:shopping": "node scripts/verify-shopping-ui.cjs",
    "test:ui-ux:checkout": "node scripts/verify-checkout-ui.cjs",
    "css:preview": "node ./scripts/minify-preview-css.js && npm run assets:js",
    "css:build": "tailwindcss -i ./web/assets/css/source.css -o ./internal/transport/web/static/app.css --minify && npm run css:preview",
    "test:e2e": "playwright test",
    "test:storefront-header": "node scripts/check-storefront-header.cjs",
    "test:firebase-ui": "node scripts/check-firebase-ui.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "axe-core": "4.14.0",
    "clean-css": "5.3.3",
    "esbuild": "0.28.2",
    "railway": "^3.11.0",
    "sharp": "0.35.5",
    "tailwindcss": "3.4.17"
  }
}
